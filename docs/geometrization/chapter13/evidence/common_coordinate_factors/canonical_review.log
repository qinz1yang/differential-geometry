    0 < ε ∧
      ∀ {Z : Type u_5} {E : Type u_6} {X : Type u_7} {Y : Type u_8} [inst : MetricSpace Z] [inst_1 : MetricSpace E]
        [inst_2 : MetricSpace X] [inst_3 : MetricSpace Y] (p : Z) (u : E) (x₀ : X) (y₀ : Y) (b e : ℝ),
        b < ε →
          e < ε →
            ∀ (f : GC.MetricGeometry.KleinerLottApprox p (WithLp.toLp 2 (u, x₀)) b)
              (g : GC.MetricGeometry.KleinerLottApprox p (WithLp.toLp 2 (u, y₀)) e),
              (∀ (z : Z), (f.toFun z).fst = (g.toFun z).fst) →
                ∃ G, ∀ z ∈ Metric.ball p L, dist (G.toFun (f.toFun z).snd) (g.toFun z).snd < θ
