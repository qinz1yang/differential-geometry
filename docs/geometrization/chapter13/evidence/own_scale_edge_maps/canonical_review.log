GC.MetricGeometry.KleinerLottApprox.exists_recenterRescaleInterval_strict.{u_1} {X : Type u_1} [mX : MetricSpace X]
  {p : X} {C s δ c H : ℝ} (hC : 0 ≤ C) (f : GC.MetricGeometry.KleinerLottApprox p ⟨0, ⋯⟩ s) (a : X) (hc : 0 < c)
