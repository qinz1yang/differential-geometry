GC.MetricGeometry.KleinerLottApprox.exists_strong_edge_ray_model.{u_1} {X : Type u_1} [mX : MetricSpace X] {p : X}
  {q : ↑(Set.Ici 0)} {ε δ c : ℝ} (f : GC.MetricGeometry.KleinerLottApprox p q ε) (a : X) {Δ e θ : ℝ} (hΔ : 1 ≤ Δ)
  (hδ : 0 < δ) (hδsmall : δ < 1 / 100) (hεs : ε ≤ δ / 1000) (hεΔ : ε ≤ 1 / (100000 * Δ)) (hc : 1 / 2 ≤ c ∧ c ≤ 2)
  (ha : dist a p ≤ 13 * Δ + 1) (hq : ↑q ≤ Δ / 2) (he : e ≤ δ / 1000) (hθ : θ ≤ δ / 1000)
  (hh : ↑(f.toFun a) ≤ 2 * e + θ) :
