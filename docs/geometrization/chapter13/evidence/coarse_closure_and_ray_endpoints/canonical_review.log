GC.MetricGeometry.strong_edge_ray_rescaling_bounds {Δ s η c d a h e θ : ℝ} (hΔ : 1 ≤ Δ) (hs : 0 < s) (hs1 : s < 1 / 100)
  (hη : 0 < η) (hηs : η ≤ s / 1000) (hηΔ : η ≤ 1 / (100000 * Δ)) (hc : 1 / 2 ≤ c ∧ c ≤ 2) (hd : d ≤ 13 * Δ + 1)
  (ha : a ≤ Δ / 2) (he : e ≤ s / 1000) (hθ : θ ≤ s / 1000) (hh : h ≤ 2 * e + θ) :
  have D := max (201 * Δ) (4 / s);
  200 * Δ < D ∧ d + s⁻¹ / c ≤ η⁻¹ ∧ s⁻¹ / c + a + η ≤ η⁻¹ ∧ 3 * c * η + c * h ≤ s ∧ s⁻¹ + c * h + c * η ≤ D
'GC.MetricGeometry.strong_edge_ray_rescaling_bounds' depends on axioms: [propext, Classical.choice, Quot.sound]
GC.MetricGeometry.KleinerLottApprox.recenterRescaleRayToInterval.{u_1} {X : Type u_1} [mX : MetricSpace X] {p : X}
  {q : ↑(Set.Ici 0)} {ε δ c L : ℝ} (f : GC.MetricGeometry.KleinerLottApprox p q ε) (a : X) (hc : 0 < c) (hδ : 0 < δ)
