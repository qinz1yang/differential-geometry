GC.MetricGeometry.KleinerLottApprox.recenterRescaleRayToInterval_apply.{u_1} {X : Type u_1} [mX : MetricSpace X] {p : X}
  {q : ↑(Set.Ici 0)} {ε δ c L : ℝ} (f : GC.MetricGeometry.KleinerLottApprox p q ε) (a : X) (hc : 0 < c) (hδ : 0 < δ)
  (hδone : δ < 1) (hsource : dist a p + δ⁻¹ / c ≤ ε⁻¹) (htarget : δ⁻¹ / c + ↑q + ε ≤ ε⁻¹)
  (hbudget : 3 * c * ε + c * ↑(f.toFun a) ≤ δ) (hclip : δ⁻¹ + c * ↑(f.toFun a) + c * ε ≤ L) (x : X) :
  have value := min (c * ↑(f.toFun x)) L;
  have g := f.recenterRescaleRayToInterval a hc hδ hδone hsource htarget hbudget hclip;
