GC.MetricGeometry.le_on_closure_of_coarse_bound.{u_1} {X : Type u_1} [PseudoMetricSpace X] {s U : Set X} (hU : IsOpen U)
  {f : X → ℝ} {A δ : ℝ} (hsource : ∀ x ∈ s ∩ U, f x ≤ A) (hcoarse : ∀ x ∈ U, ∀ y ∈ U, |f x - f y| ≤ dist x y + δ)
  {x : X} (hx : x ∈ closure s ∩ U) : f x ≤ A + δ
