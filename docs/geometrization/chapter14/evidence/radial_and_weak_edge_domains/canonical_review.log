GC.MetricGeometry.radial_support_test_ball_buffer.{u_1} {X : Type u_1} [PseudoMetricSpace X] {ρ η : X → ℝ} {Λ : NNReal}
  (hρ : LipschitzWith Λ ρ) {p z : X} (hp : 0 < ρ p) (hz : 0 < ρ z) {L T R e : ℝ} (hL : 0 < L) (hΛ : L * ↑Λ ≤ 1 / 4)
  (hT : 1600 * L ≤ T) (hR : T * ρ z ≤ R) (he : e < 1 / 40) (hlocal : dist z p ≤ 10 * R → T / 20 ≤ R / ρ p) {S : Set X}
  (herror : ∀ x ∈ S, |η x - dist z x / R| < e) (hsupport : ∀ x ∈ S, η x ∈ Set.Icc (1 / 5) (9 / 10))
  (hmeet : (S ∩ Metric.ball p (L * ρ p)).Nonempty) :
  T / 20 ≤ R / ρ p ∧ ∀ x ∈ Metric.ball p (L * ρ p), dist z x / R ∈ Set.Icc (3 / 20) (19 / 20)
'GC.MetricGeometry.radial_support_test_ball_buffer' depends on axioms: [propext, Classical.choice, Quot.sound]
GC.MetricGeometry.lipschitz_quotient_difference_le.{u_1} {X : Type u_1} [PseudoMetricSpace X] {P ρ : X → ℝ}
  {K Λ : NNReal} (hP : LipschitzWith K P) (hρ : LipschitzWith Λ ρ) {a x : X} (ha : 0 < ρ a) (hx : 0 < ρ x) :
  |P x / ρ x - P a / ρ a| ≤ (↑K + |P a / ρ a| * ↑Λ) * dist x a / ρ x
'GC.MetricGeometry.lipschitz_quotient_difference_le' depends on axioms: [propext, Classical.choice, Quot.sound]
GC.MetricGeometry.slow_scale_quotient_variation.{u_1} {X : Type u_1} [PseudoMetricSpace X] {P ρ : X → ℝ} {K Λ : NNReal}
