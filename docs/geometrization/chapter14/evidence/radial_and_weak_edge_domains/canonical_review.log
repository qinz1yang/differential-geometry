GC.MetricGeometry.strong_set_proximity_of_support_meeting.{u_1} {X : Type u_1} [PseudoMetricSpace X] {ρ : X → ℝ}
  {Λ : NNReal} (hρ : LipschitzWith Λ ρ) {p z : X} (hp : 0 < ρ p) (hz : 0 < ρ z) {L Δ : ℝ} (hL : 0 < L)
