se.curvatureRadius.{0, 0, u} (g j i) p) →\n                                LE.le.{0} (ENNReal.ofReal (HMul.hMul.{0, 0, 0} w (HPow.hPow.{0, 0, 0} r 3)))\n                                    (DifferentialGeometry.Geometry.Collapse.ballVolume.{0, 0, u} (g j i) p r) →\n                                  ∀ (k : ℕ),\n                                    LE.le.{0} k K →\n                                      ∀ (q : GC.Endpoint.CompactCarrier.Carrier.{u} (W j i)),\n                                        Membership.mem.{u, u}\n                                            (DifferentialGeometry.riemannianBallOf.{0, 0, u} (g j i) p r) q →\n                                          LE.le.{0}\n                                            (DifferentialGeometry.Geometry.Curvature.curvatureDerivativeNorm.{0, 0, u}\n                                              (g j i) k q)\n                                            (HMul.hMul.{0, 0, 0} C\n                                              (Inv.inv.{0} (HPow.hPow.{0, 0, 0} r (HAdd.hAdd.{0, 0, 0} k 2))))) →\n            ∃ A,\n              (∀ (w : ℝ), LT.lt.{0} 0 w → LT.lt.{0} 0 (A w)) ∧\n                ∀ (j : ℕ) (i : ι j) (w₀ : ℝ),\n                  LT.lt.{0} 0 w₀ →\n                    DifferentialGeometry.Geometry.Collapse.curvatureDerivativesControlled.{0, 0, u} (g j i) K A w₀"}
