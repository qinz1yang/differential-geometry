asure.real.{u_1} μ\n                              (Metric.ball.{u_1} i\n                                (HMul.hMul.{0, 0, 0}\n                                  (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 3 C)\n                                    (HMul.hMul.{0, 0, 0} 2 (HDiv.hDiv.{0, 0, 0} Δ 3)))\n                                  (ρ i))))\n                            (HMul.hMul.{0, 0, 0} b\n                              (MeasureTheory.Measure.real.{u_1} μ\n                                (Metric.ball.{u_1} i (HDiv.hDiv.{0, 0, 0} (HMul.hMul.{0, 0, 0} Δ (ρ i)) 3))))) →\n                      ∃ I ⊆ E,\n                        Set.Finite.{u_1} I ∧\n                          (Set.PairwiseDisjoint.{u_1, u_1} I fun i ↦\n                              Metric.ball.{u_1} i (HDiv.hDiv.{0, 0, 0} (HMul.hMul.{0, 0, 0} Δ (ρ i)) 3)) ∧\n                            (∀ (p : X),\n                                Membership.mem.{u_1, u_1} E p →\n                                  ∃ i,\n                                    Membership.mem.{u_1, u_1} I i ∧\n                                      Metric.ball.{u_1} p (HMul.hMul.{0, 0, 0} Δ (ρ p)) ⊆\n                                        Metric.ball.{u_1} i (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 Δ) (ρ i))) ∧\n                              ∀ (x : X),\n                                LE.le.{0}\n                                  (↑(Set.ncard.{u_1}\n                                      (Inter.inter.{u_1} I\n                                        (Set.ofPred.{u_1} fun i ↦\n                                          Membership.mem.{u_1, u_1} (Metric.ball.{u_1} i (HMul.hMul.{0, 0, 0} C (ρ i)))\n                                            x))))\n                                  b"}
