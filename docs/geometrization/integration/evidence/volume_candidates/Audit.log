X : Type u_1} [inst : MetricSpace.{u_1} X],\n  (∀ (p u : X) (η : ℝ),\n      LT.lt.{0} 0 η →\n        ∃ c,\n          Continuous.{0, u_1} c ∧\n            Eq.{u_1 + 1} (c 0) p ∧\n              Eq.{u_1 + 1} (c 1) u ∧\n                LT.lt.{0} (eVariationOn.{0, u_1} c Set.univ.{0})\n                  (ENNReal.ofReal (HAdd.hAdd.{0, 0, 0} (dist.{u_1} p u) η))) →\n    ∀ {Ω V : Set.{u_1} X} {a b : Fin 3 → X} {q : X} {a₀ A δ r : ℝ},\n      DifferentialGeometry.Geometry.Comparison.Toponogov.PairedComparisonPacket.{u_1, 0} δ V a b →\n        DifferentialGeometry.Geometry.Comparison.Toponogov.fourPointComparison.{u_1} 1 Ω →\n          V ⊆ Ω →\n            Union.union.{u_1} (Set.range.{u_1, 1} a) (Set.range.{u_1, 1} b) ⊆ Ω →\n              LT.lt.{0} 0 a₀ →\n                LT.lt.{0} 0 δ →\n                  LE.le.{0} δ (1 / 300) →\n                    LT.lt.{0} 0 r →\n                      IsComplete.{u_1} (Metric.closedBall.{u_1} q r) →\n                        Metric.ball.{u_1} q (HMul.hMul.{0, 0, 0} 2 r) ⊆ V →\n                          (∀ (z : X),\n                              Membership.mem.{u_1, u_1} V z →\n                                ∀ (c : X),\n                                  Membership.mem.{u_1, u_1}\n                                      (Union.union.{u_1} (Set.range.{u_1, 1} a) (Set.range.{u_1, 1} b)) c →\n                                    Membership.mem.{0, 0} (Set.Icc.{0} a₀ A) (dist.{u_1} z c)) →\n                            have μ :=\n                              HSub.hSub.{0, 0, 0}\n                                (HSub.hSub.{0, 0, 0} 1 (HMul.hMul.{0, 0, 0} 3 (HPow.hPow.{0, 0, 0} δ 2)))\n                                (HMul.hMul.{0, 0, 0} 12 δ);\n                            have e :=\n                              min.{0} 1\n                                (min.{0} (HDiv.hDiv.{0, 0, 0} a₀ 2)\n                                  (min.{0}\n                                    (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} δ 2)\n                                