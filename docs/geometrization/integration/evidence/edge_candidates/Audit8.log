                           (abs.{0}\n                                                        (HSub.hSub.{0, 0, 0}\n                                                          (dist.{0}\n                                                            (GC.MetricGeometry.KleinerLottApprox.stripMap.{u, v} F G x)\n                                                            (GC.MetricGeometry.KleinerLottApprox.stripMap.{u, v} F G y))\n                                                          (dist.{u} x y)))\n                                                      (HMul.hMul.{0, 0, 0} τ Δ)) ∧\n                                            (∀ (y : WithLp.{0} 2 (Prod.{0, 0} ℝ ℝ)),\n                                                LE.le.{0} (abs.{0} (WithLp.fst.{0, 0} y)) (HMul.hMul.{0, 0, 0} 100 Δ) →\n                                                  Membership.mem.{0, 0} (Set.Icc.{0} 0 (HMul.hMul.{0, 0, 0} 100 Δ))\n                                                      (WithLp.snd.{0, 0} y) →\n                                                    ∃ x,\n                                                      Membership.mem.{u, u}\n                                                          (Metric.ball.{u} p (HMul.hMul.{0, 0, 0} 200 Δ)) x ∧\n                                                        LT.lt.{0}\n                                                          (dist.{0}\n                                                            (GC.MetricGeometry.KleinerLottApprox.stripMap.{u, v} F G x)\n                                                            y)\n                                                          (HMul.hMul.{0, 0, 0} τ Δ)) ∧\n                                              (∀ (a : X),\n                                                  Membership.mem.{u, u}\n                                                      (Inter.inter.{u} (closure.{u} E)\n                                                        (Metric.ball.{u} p (HMul.hMul.{0, 0, 0} 190 Δ)))\n                             