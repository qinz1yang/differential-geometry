@isCompact_closedBall_of_complete_buffer : ∀ {X : Type u_1} [inst : MetricSpace X],
  (∀ (a b : X) (ε : ℝ),
      0 < ε → ∃ c, Continuous c ∧ c 0 = a ∧ c 1 = b ∧ eVariationOn c univ < ENNReal.ofReal (dist a b + ε)) →
    ∀ (p : X) {L : ℝ},
      0 < L →
        ∀ [LocallyCompactSpace ↑(ball p L)], IsComplete (closedBall p L) → ∀ {r : ℝ}, r < L → IsCompact (closedBall p r)
@isCompact_closedBall_of_locallyCompact_ball : ∀ {X : Type u_1} [inst : MetricSpace X] [CompleteSpace X],
  (∀ (a b : X) (ε : ℝ),
      0 < ε → ∃ c, Continuous c ∧ c 0 = a ∧ c 1 = b ∧ eVariationOn c univ < ENNReal.ofReal (dist a b + ε)) →
    ∀ (p : X) {L : ℝ}, 0 < L → ∀ [LocallyCompactSpace ↑(ball p L)] {r : ℝ}, r < L → IsCompact (closedBall p r)
@exists_metric_segment_of_compact_arbitrarily_short_curves : ∀ {X : Type u_1} [inst : MetricSpace X] {K : Set X},
  IsCompact K →
    ∀ {a b : X},
      (∀ (ε : ℝ),
          0 < ε →
            ∃ c,
              Continuous c ∧
                c 0 = a ∧
                  c 1 = b ∧ (∀ (t : ↑unitInterval), c t ∈ K) ∧ eVariationOn c univ < ENNReal.ofReal (dist a b + ε)) →
        ∃ f,
          Continuous f ∧
            f 0 = a ∧
              f 1 = b ∧
                (∀ (t : ↑unitInterval), f t ∈ K) ∧ ∀ (s t : ↑unitInterval), dist (f s) (f t) = dist a b * dist s t
@exists_metric_segment_in_closedBall_of_complete_buffer : ∀ {X : Type u_1} [inst : MetricSpace X],
  (∀ (a b : X) (ε : ℝ),
      0 < ε → ∃ c, Continuous c ∧ c 0 = a ∧ c 1 = b ∧ eVariationOn c univ < ENNReal.ofReal (dist a b + ε)) →
    ∀ (p : X) {L r : ℝ} [LocallyCompactSpace ↑(ball p L)],
      IsComplete (closedBall p L) →
        2 * r < L →
          ∀ {a b : X},
            a ∈ closedBall p r →
              b ∈ closedBall p r →
                ∃ f,
                  Continuous f ∧
                    f 0 = a ∧
                      f 1 = b ∧
                        (∀ (t : ↑unitInterval), f t ∈ closedBall p (2 * r)) ∧
                          ∀ (s t : ↑unitInterval), dist (f s) (f t) = dist a b * dist s t
@exists_metric_segment_in_closedBall_of_locallyCompact_ball : ∀ {X : Type u_1} [inst : MetricSpace X] [CompleteSpace X],
  (∀ (a b : X) (ε : ℝ),
      0 < ε → ∃ c, Continuous c ∧ c 0 = a ∧ c 1 = b ∧ eVariationOn c univ < ENNReal.ofReal (dist a b + ε)) →
    ∀ (p : X) {L r : ℝ} [LocallyCompactSpace ↑(ball p L)],
      2 * r < L →
        ∀ {a b : X},
          a ∈ closedBall p r →
            b ∈ closedBall p r →
              ∃ f,
                Continuous f ∧
                  f 0 = a ∧
                    f 1 = b ∧
                      (∀ (t : ↑unitInterval), f t ∈ closedBall p (2 * r)) ∧
                        ∀ (s t : ↑unitInterval), dist (f s) (f t) = dist a b * dist s t
@exists_metric_segment_in_ball_of_complete_buffer : ∀ {X : Type u_1} [inst : MetricSpace X] [LocallyCompactSpace X],
  (∀ (a b : X) (ε : ℝ),
      0 < ε → ∃ c, Continuous c ∧ c 0 = a ∧ c 1 = b ∧ eVariationOn c univ < ENNReal.ofReal (dist a b + ε)) →
    ∀ (p : X) {r : ℝ},
      0 < r →
        IsComplete (closedBall p (3 * r)) →
          ∀ {a b : X},
            a ∈ ball p r →
              b ∈ ball p r →
                ∃ f,
                  Continuous f ∧
                    f 0 = a ∧
                      f 1 = b ∧
                        (∀ (t : ↑unitInterval), f t ∈ ball p (2 * r)) ∧
                          ∀ (s t : ↑unitInterval), dist (f s) (f t) = dist a b * dist s t
@exists_metric_segment_in_ball_of_recentered_complete_buffer : ∀ {X : Type u_1} [inst : MetricSpace X]
  [LocallyCompactSpace X],
  (∀ (a b : X) (ε : ℝ),
      0 < ε → ∃ c, Continuous c ∧ c 0 = a ∧ c 1 = b ∧ eVariationOn c univ < ENNReal.ofReal (dist a b + ε)) →
    ∀ {o p : X} {L r : ℝ},
      0 < r →
        IsComplete (closedBall o L) →
          dist p o + 3 * r ≤ L →
            ∀ {a b : X},
              a ∈ ball p r →
                b ∈ ball p r →
                  ∃ f,
                    Continuous f ∧
                      f 0 = a ∧
                        f 1 = b ∧
                          (∀ (t : ↑unitInterval), f t ∈ ball p (2 * r)) ∧
                            ∀ (s t : ↑unitInterval), dist (f s) (f t) = dist a b * dist s t
