import DifferentialGeometry.Topology.PiecewiseLinear.Section34Frame
import DifferentialGeometry.Topology.PiecewiseLinear.CombinatorialSolidTorus
import DifferentialGeometry.Topology.PiecewiseLinear.BallReplacement

/-!
# Polygons on the boundary torus disjoint from a generator-carrying polygon (WIP, lease c)

Unfinished. The leaf `carriesGenerator_or_exists_isPLCell_of_polygon_disjoint_carrier` is
reduced (checked as an external probe: exactly the two sorry warnings below) to two statements
about a combinatorial solid torus `S` with boundary torus `T = frontier S`.

* `exists_isPLCell_frontier_of_not_isPreconnected_sdiff` (Moise 28.9, separating case): a PL
  circle separating `T` bounds a PL disk in `T`. Available: a triangulation `L` of `T`
  (`IsPLTorus.exists_combinatorial_triangulation`), orientable, `χ(L) ∈ {0, 2}`
  (`IsPLTorus.bettiOne_le_two`, `even_eulerChar_of_finrank_eq_three`); the two sides `A, B`
  (`exists_manifold_pair_of_separating_circle`) with `χ(A) + χ(B) = χ(L)`; capping each side by a
  cone in `E × ℝ` (`exists_cone_disk_of_isPLSphere_one`, `exists_closed_of_disk`) gives
  `χ ≤ 1` per side, and a side with `χ = 1` is a PL disk (`isPLSphere_two_of_faceEulerChar_eq_two`,
  `IsPLSphere.isPLBall_closure_sdiff`). MISSING: the case `χ(A) = χ(B) = 0`. It is excluded by
  parity (an orientable surface with one boundary circle has odd `χ`), which the tree has only
  for closed surfaces in three-space (`even_eulerChar_of_finrank_eq_three`); the capped sides
  live in `E × ℝ`, and no lemma says that capping preserves orientability. With such a lemma the
  case closes: an orientable closed surface with `χ ≠ 2` has a nonseparating circle
  (`exists_isPLSphere_one_isPreconnected_sdiff`), its annulus complement
  (`exists_connected_annulus_complement`) capped twice has `χ + 2 ≤ 2`, so `χ ≤ 0`, not `1`.
* `carriesFundamentalGroupOnto_of_isPreconnected_sdiff` (nonseparating case, no parity needed):
  the annulus complement of `G` avoiding `K` is an annulus by
  `exists_isPLHomeomorphOn_annulus_of_eulerChar_eq_zero`; in the prism sphere
  `∂(Δ² × [0,1])` the disk decomposition `exists_disk_decomposition_of_isPLSphere_one_subset_two`
  of `K` either puts both end disks on one side (then `K` bounds a PL disk in `T`, hence is null
  in `S`, contradicting `hKgen` since `π₁(S) ≅ ℤ`), or separates them (then
  `exists_isPLHomeomorphOn_map_disk_pair_eqOn_disk` makes `K` and an end circle the ends of a PL
  annulus). MISSING, but routine: the transfer "the two ends of a PL annulus in `S` carry
  `π₁(S)` together" (a square homotopy in `C × I` via `Path.Homotopic.prod`), applied to the
  annulus and to the half bicollar of `G`.
-/

open Set Topology

namespace DifferentialGeometry.Topology.PiecewiseLinear

theorem IsCombinatorialSolidTorus.exists_isPLCell_frontier_of_not_isPreconnected_sdiff
    {S G : Set (EuclideanSpace ℝ (Fin 3))} (hS : IsCombinatorialSolidTorus S)
    (hG : IsPLSphere 1 G) (hGS : G ⊆ frontier S) (hsep : ¬ IsPreconnected (frontier S \ G)) :
    ∃ (Δ : Set (EuclideanSpace ℝ (Fin 3))) (r : (Fin 3 → ℝ) → EuclideanSpace ℝ (Fin 3)),
      IsPLHomeomorphOn r (stdSimplex ℝ (Fin 3)) Δ ∧ Δ ⊆ frontier S ∧
        G = r '' stdSimplexBoundary 2 := by
  sorry

theorem IsCombinatorialSolidTorus.carriesFundamentalGroupOnto_of_isPreconnected_sdiff
    {S K G : Set (EuclideanSpace ℝ (Fin 3))} (hS : IsCombinatorialSolidTorus S)
    (hK : IsPLSphere 1 K) (hKS : K ⊆ frontier S) (hKgen : CarriesFundamentalGroupOnto K S)
    (hG : IsPLSphere 1 G) (hGS : G ⊆ frontier S) (hGK : Disjoint G K)
    (hnonsep : IsPreconnected (frontier S \ G)) : CarriesFundamentalGroupOnto G S := by
  sorry

theorem carriesGenerator_or_exists_isPLCell_of_polygon_disjoint_carrier
    {S K G : Set (EuclideanSpace ℝ (Fin 3))} (hS : IsCombinatorialSolidTorus S)
    (hK : IsPLSphere 1 K) (hKS : K ⊆ frontier S) (hKgen : CarriesFundamentalGroupOnto K S)
    (hG : IsPLSphere 1 G) (hGS : G ⊆ frontier S) (hGK : Disjoint G K) :
    CarriesFundamentalGroupOnto G S ∨
      ∃ (Δ : Set (EuclideanSpace ℝ (Fin 3))) (r : (Fin 3 → ℝ) → EuclideanSpace ℝ (Fin 3)),
        IsPLHomeomorphOn r (stdSimplex ℝ (Fin 3)) Δ ∧ Δ ⊆ frontier S ∧
          G = r '' stdSimplexBoundary 2 := by
  by_cases hsep : IsPreconnected (frontier S \ G)
  · exact Or.inl (hS.carriesFundamentalGroupOnto_of_isPreconnected_sdiff hK hKS hKgen hG hGS
      hGK hsep)
  · exact Or.inr (hS.exists_isPLCell_frontier_of_not_isPreconnected_sdiff hG hGS hsep)

end DifferentialGeometry.Topology.PiecewiseLinear
