    have hsymm : χ.symm x = y := by
      rw [← hxy]
      exact χ.left_inv (hχsrc y hyb)
    dsimp [morseModifiedRetraction]
    rw [if_pos ⟨y, hyb, hxy⟩]
    rw [hsymm, hfix]
    exact hxy

