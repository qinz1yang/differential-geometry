    dsimp [morseFarExpandMapSmooth]
  have hG : morseFarExpandMapInverse c ε δ ρ ρ' f v hv hsupp hρ hρ' hε hδ hρρ'
      (morseFarExpandMapSmooth c ε δ ρ ρ' f v hv hsupp x) =
