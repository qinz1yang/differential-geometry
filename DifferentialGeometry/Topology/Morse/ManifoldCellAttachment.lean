        (modelWithCornersEuclideanHalfSpace ((m + 1 - k - 1) + 1)))
      (StandardHandle k (m + 1 - k)) _ (standardHandleChartedSpace k (m + 1 - k))
      (MorseModel (m + 1)) _ _ H _ I M _ _
