        have hclosedimg : IsClosed (data.χ '' {w : MorseModel (m + 1) | CellAttachment.morseNorm (m + 1) w ≤ R₁}) := by
          have himg : IsCompact (data.χ '' {w : MorseModel (m + 1) | CellAttachment.morseNorm (m + 1) w ≤ R₁}) :=
