    refine data.hχon.comp hrecombOn ?_
    intro p hp
    exact hball p
  have hχ' : ContMDiff ((𝓘(ℝ, EuclideanSpace ℝ (Fin 0))).prod
        (modelWithCornersEuclideanHalfSpace ((m + 1 - 1) + 1)))
      I (⊤ : ℕ∞)
      (fun p : StandardHandle 0 (m + 1) => data.χ (modelHandleMap (zero_le (m + 1)) ε r p)) := by
    rw [← contMDiffOn_univ]
