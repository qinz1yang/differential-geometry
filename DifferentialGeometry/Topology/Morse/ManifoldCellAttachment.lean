        (hf := hχsmd.mdifferentiableAt (by simp))
        (hg := by
          simpa [hsymm] using (CellAttachment.differentiableAt_modelSublevelFamily hk c ε r δ R₀ R₁ s y).mdifferentiableAt)
      have hfd : mfderiv 𝓘(ℝ, MorseModel (m + 1)) 𝓘(ℝ, ℝ)
