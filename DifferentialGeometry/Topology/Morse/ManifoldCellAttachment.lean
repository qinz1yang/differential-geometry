        ⟨x.1, Or.inl x.2⟩).1 = x.1) := by
  constructor
  · intro x
    change morseModifiedRetraction (M := M) hk c ε R χ x.1 = x.1
    exact (morseModifiedRetraction_eq_self_of_mem_lowerUnion (M := M) hk c ε R hε hεR
      χ f hnorm hχsrc (Or.inl x.2))
  · intro x
    change x.1 = x.1
