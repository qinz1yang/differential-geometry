  have hval := morseFarExpandMap_value hk c ε r δ ε' R₀ R₁ data hf hε hδ hr2 v hv hsupp hdfOn hrate z
  rw [hval]
  have hcut : morseFarCutoff hk c r ε' R₀ R₁ data z.1 ∈ Set.Icc (0 : ℝ) 1 :=
