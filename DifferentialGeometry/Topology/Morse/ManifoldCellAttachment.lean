          morseFarExpandLevelInverse c ε δ ρ ρ' hρ hρ' hε hδ hρρ'
            (f (morseFarExpandMapSmooth c ε δ ρ ρ' f v hv hsupp x))) := by
    dsimp [morseFarExpandMapInverse]
  rw [hG, hvalF, hF, htime]
