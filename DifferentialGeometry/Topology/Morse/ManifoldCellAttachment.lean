          simpa [h1] using hx
        have hsub' : f x - c = (f x - c + (1 - 2 * s) * ε) - (1 - 2 * s) * ε := by ring
        have htri : |f x - c| ≤ |f x - c + (1 - 2 * s) * ε| + |(1 - 2 * s) * ε| := by
