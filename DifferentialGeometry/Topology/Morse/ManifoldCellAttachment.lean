      apply Subtype.ext
      apply h.injective
      have hto := morseHandleRoundAdjunctionHomeoUnion_lower hk c ε r δ θ data hε hδ hθ hδr hθr hr hεr
        hεr' hcont x₀
      have hz : h z.1 = ⟨x₀.1, Or.inl x₀.2⟩ := by
        rw [← hx₀]
