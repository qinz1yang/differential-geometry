  -- admission swap (INT-CH8, lead release 2026-10-08): A12′ is now proved by candidate D
  -- (`a12EnhancedFull_v11fin0_FS`), so no declaration in `owned` is a direct admission any more.
  let expectedDirect : List Name := []
  let downstream : List Name := []
  let knownAdmissions : List Name := [`GC.LongTime.exists_late_cut_family,
    `GC.LongTime.exists_surgery_with_decaying_accuracy,
    `GC.LongTime.exists_surgery_with_decaying_accuracy_enhanced,
    `GC.LongTime.late_derivative_tests_of_flow]
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let mut count : Nat := 0
  let mut direct : Nat := 0
  let mut viaPath : Nat := 0
  let mut memo : Std.HashMap Name Bool := {}
  for modS in owned do
    let mod := modS.toName
    let some idx := env.getModuleIdx? mod | throwError "Missing module {mod}"
    for name in env.header.moduleData[idx.toNat]!.constNames do
      let some info := env.find? name | throwError "Unchecked declaration {name}"
      if info.isAxiom || info.isUnsafe then
        throwError "Unexpected axiomInfo or unsafe declaration {name}"
      if info.type.getUsedConstants.contains ``sorryAx then
        throwError "Admission in declaration type {name}"
      let axs ← collectAxioms name
      memo := memo.insert name (axs.contains ``sorryAx)
      for ax in axs do
        unless allowed.contains ax || ax == ``sorryAx do
          throwError "Unexpected axioms {ax} in {name}"
      let isDirect := info.getUsedConstantsAsSet.contains ``sorryAx
      if isDirect then
        unless info.isTheorem && expectedDirect.contains name do
          throwError "Unregistered direct admission {name}"
        direct := direct + 1
      else if axs.contains ``sorryAx then
        unless downstream.contains name do
          throwError "Unregistered sorryAx carrier {name}"
        -- BFS：只沿同样含 sorryAx 的子常量走，找最近的直接 admission
        let mut queue : Array Name := #[name]
        let mut visited : Std.HashSet Name := (({} : Std.HashSet Name).insert name)
        let mut parent : Std.HashMap Name Name := {}
        let mut head := 0
        let mut found : Option Name := none
        while found.isNone && head < queue.size do
          let cur := queue[head]!
          head := head + 1
          let some ci := env.find? cur | continue
          if ci.getUsedConstantsAsSet.contains ``sorryAx then
            found := some cur
          else
            for c in ci.getUsedConstantsAsSet.toArray do
              if visited.contains c then continue
              let b ← match memo.get? c with
                | some b => pure b
                | none =>
                  let b := (← collectAxioms c).contains ``sorryAx
                  memo := memo.insert c b
                  pure b
              if b then
                visited := visited.insert c
                parent := parent.insert c cur
                queue := queue.push c
        match found with
        | none => throwError "No path to a direct admission from {name}"
        | some t =>
          let mut path : List Name := [t]
          let mut cur := t
          while cur != name do
            match parent.get? cur with
            | some p => path := p :: path; cur := p
            | none => cur := name
          let some root := path.getLast? | throwError "empty path"
          unless knownAdmissions.any (fun a => root == a || a.isPrefixOf root) do
            throwError "Path from {name} ends at {root}, not a known admission"
          logInfo m!"sorryAx downstream {name}: {path.length - 1} steps to {root}"
          viaPath := viaPath + 1
      count := count + 1
  unless direct == expectedDirect.length do
    throwError "Expected {expectedDirect.length} direct admissions; observed {direct}"
  let msg : String := s!"ch11 declaration audit C3: {owned.length} modules, {count} declarations, "
    ++ s!"{authored.length} authored theorems present, {direct} direct admission (A12 enhanced), "
    ++ s!"{viaPath} sorryAx-downstream declarations."
  logInfo msg
