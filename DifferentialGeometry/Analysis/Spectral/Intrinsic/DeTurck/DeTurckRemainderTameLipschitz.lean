      have e19 : max (19 * deTurckArmFibreConst (Module.finrank ℝ E) * (δ / (1 - δ))) 0 = 0 :=
        max_eq_right (by nlinarith)
      rw [e19]
      rw [e8] at h8
      rw [e10] at h10
      nlinarith [hadd, h8, h10]
  · intro i s hs
    try dsimp only
    have hadd := lc0b_normSq_icg_add_le (I := I) g₀ 2 2 i (C0ra s) (C0lc s)
    have h1 := henvC0ra i s hs
