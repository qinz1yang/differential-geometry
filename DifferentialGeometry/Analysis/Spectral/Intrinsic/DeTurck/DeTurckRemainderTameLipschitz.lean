    ricciArmPrincipalCoeff_realizedFam_sub_background_jetL2_perOrder_ballUniform
      (I := I) (M := M) g₀ a ha_super hR hδ₀
  set dim : ℝ := (Module.finrank ℝ E : ℝ) with hdim_def
