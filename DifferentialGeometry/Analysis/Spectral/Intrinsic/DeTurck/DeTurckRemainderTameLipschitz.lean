  set WinT : ℝ := 1 + ∑ j ∈ Finset.range (i + 2),
    ‖iteratedCovGrad (I := I) g₀ 0 2 j T‖ ^ 2 with hWinT_def
  have hWinT_nn : (0 : ℝ) ≤ WinT := by
    rw [hWinT_def]
    have := lc0w_win_one_le (I := I) (M := M) g₀ T i
