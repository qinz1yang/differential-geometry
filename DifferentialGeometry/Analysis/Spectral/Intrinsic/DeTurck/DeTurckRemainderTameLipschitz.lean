            (lc0VFlat (I := I) (M := M) g₀ g₁ gB))‖ ^ 2 ≤ (fr2 * Kvf q) * Win := by
    intro q hq
    refine le_trans (hseL2 q hq) (le_of_eq ?_)
    rw [hfr2_def]
    ring
  have hse0' : ∀ x : M, riemannianFiberNormSq (I := I) (M := M) g₀ (0 + 2) (1 + 2) x
      ((slotExtendIter (I := I) (M := M) g₀ 0 1 2
