  obtain ⟨hse0, hseL2⟩ := lc0b_slotExtendIter_feed_transfer (I := I) (M := M) g₀ 0 1 2
    (lc0VFlat (I := I) (M := M) g₀ g₁ gB) Λvf (fun q => Kvf q * Win) i hvf0 hvfWin
  have hseWin : ∀ q : ℕ, q ≤ i →
