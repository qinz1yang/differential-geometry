      ((1 / 2 : ℝ) * (∑ a, ∑ b, ∑ c, ∑ d, dig j a b * f i c * gb a b d * ig c d)) := by
  have h1 : (∑ a, ∑ b, ∑ c, dig j a b * f i c * ga1 a b c) =
