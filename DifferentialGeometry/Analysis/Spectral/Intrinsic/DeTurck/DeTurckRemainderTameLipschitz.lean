    lc0w_comp_sup (I := I) (M := M) g₀ 2 1 4
      (slotExtendIter (I := I) (M := M) g₀ 0 3 1 (lc0Kappa (I := I) (M := M) g₀ g₁ g₀))
      (lc0IVField (I := I) (M := M) g₀ g₁ g₀) ΛK Λiv hΛK_nn hK0 hiv0
  have hinWin : ∀ q : ℕ, q ≤ i →
