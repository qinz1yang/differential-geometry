      ((1 / 2 : ℝ) * (∑ a, ∑ b, ∑ c, ∑ d, dig j a b * f i c * gb a b d * ig c d)) := by
    linear_combination rz39_h1 ig cg f dg dig ga0 ga1 gbg gb f3 ddg dga0 dga1 dgbg dgb higs hcgs hfs hdgs2 hga0s hga1s hgbgs hdga0s hdga1s hdgbgs hddgs hf3s hgbs hdgbs hdigs hcol hga1e hdga1e hdige hgbe hdgbe i j
