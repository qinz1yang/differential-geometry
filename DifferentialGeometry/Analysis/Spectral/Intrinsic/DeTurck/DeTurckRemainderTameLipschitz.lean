  apply smoothCcTensor_ext_of_unitModel (I := I) (M := M) g₀
  intro x
  apply ContinuousMultilinearMap.ext
  intro m
  rw [lc0b_unitModel_add (I := I) (M := M) g₀ 3 _ _ x m,
    lc0b_unitModel_add (I := I) (M := M) g₀ 3 _ _ x m,
    lc0b_unitModel_add (I := I) (M := M) g₀ 3 _ _ x m]
