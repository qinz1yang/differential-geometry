  have houtWin : ∀ q : ℕ, q ≤ i →
      ∑ q' ∈ Finset.range (q + 1),
        ‖iteratedCovGrad (I := I) g₀ 2 2 q'
          (appCcRS (I := I) (M := M) g₀ 2 4 2
            (lc0Tr (I := I) (M := M) g₀ g₁ 2 lieCorr0VBPerm)
            (appCcRS (I := I) (M := M) g₀ 2 1 4
              (slotExtendIter (I := I) (M := M) g₀ 0 3 1
