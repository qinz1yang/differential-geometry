private lemma k2_sum_fin1 {α : Type*} [AddCommMonoid α] {n : ℕ} (f : (Fin 1 → Fin n) → α) :
    ∑ K : Fin 1 → Fin n, f K = ∑ k : Fin n, f (fun _ => k) := by
  classical
