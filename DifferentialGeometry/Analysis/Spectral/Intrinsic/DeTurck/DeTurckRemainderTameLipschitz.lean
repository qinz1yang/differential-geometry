  have hWinPT : 1 + ∑ j ∈ Finset.range (i + 2),
      ‖iteratedCovGrad (I := I) g₀ 0 2 j Pc‖ ^ 2 ≤ WinT := by
    rw [hWinT_def]
    have := Finset.sum_le_sum (fun j (_ : j ∈ Finset.range (i + 2)) => hPT2 j)
