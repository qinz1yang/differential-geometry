    (hdga1e : ∀ m a b k, dga1 m a b k = (1 / 2 : ℝ) * ∑ l, (dig m k l * gb a b l + ig k l * dgb m a b l))
    (hdige : ∀ m a b, dig m a b = -∑ p, ∑ q, ig a p * ig q b * dg m p q)
