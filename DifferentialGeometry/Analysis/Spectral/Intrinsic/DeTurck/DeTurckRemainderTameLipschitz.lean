      (lc0RiemRestField (I := I) (M := M) g₀) Λdt2 Λrr hΛdt2_nn htr0 hΛrr
  obtain ⟨-, hsL2⟩ := lc0b_smul_feed_transfer (I := I) (M := M) g₀ 2 2 (-1 : ℝ)
    (appCcRS (I := I) (M := M) g₀ 2 4 2
