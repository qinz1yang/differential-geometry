  rw [cometricDoubleTraceFib_toModel (I := I) g₁ 1 x]
  rw [modelDoubleTrace_apply (E := E) 1 (cometricLmodel (I := I) g₁ x)]
  rw [cometric_dualTrace_eq_orthoFrame_diag (I := I) g₁ x
