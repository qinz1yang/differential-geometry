  · intro x
    exact (hC₁sup x).trans
      (hsq_mono _ _ hΛA_nn (le_trans (le_max_left ΛA cD) (le_max_right _ _)))
  · intro x
    have hm_nn : 0 ≤ max βT βT' := le_trans hβT_nn (le_max_left _ _)
