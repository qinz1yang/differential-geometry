        rw [mul_add])]
    rw [Finset.sum_add_distrib]
  have hflipFR : (∑ k : Fin n, cg i k *
      ((∑ a : Fin n, ∑ b : Fin n, dig j a b * ((1 / 2 : ℝ) *
          ∑ l : Fin n, ig k l * (f3 a l b + f3 b l a - f3 l a b)))
       + ∑ a : Fin n, ∑ b : Fin n, ig a b * ((1 / 2 : ℝ) *
          ∑ l : Fin n, dig j k l * (f3 a l b + f3 b l a - f3 l a b))))
      = ∑ k : Fin n, cg k i *
          ((∑ a : Fin n, ∑ b : Fin n, dig j a b * ((1 / 2 : ℝ) *
              ∑ l : Fin n, ig k l * (f3 a l b + f3 b l a - f3 l a b)))
           + ∑ a : Fin n, ∑ b : Fin n, ig a b * ((1 / 2 : ℝ) *
