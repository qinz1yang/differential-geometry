      (lc0w_win_mono (I := I) (M := M) g₀ P hq) (hKκ_nn q))
  exact lc0w_comp_step (I := I) (M := M) g₀ 0 3 1 i Win hWin1
    (lc0PureDT (I := I) (M := M) g₀ g₁ 1) (lc0Kappa (I := I) (M := M) g₀ g₁ gB)
    C2 hC2_nn hC2 Λdt Λκ Kdt Kκ hΛdt_nn hΛκ_nn
    (hdt0) (hκ0) hKΦ hKW

