    {n : ℕ} (e : Fin n → TangentSpace I x) (d : Fin n → ℝ)
    (horth : ∀ i j : Fin n, g.inner x (e i) (e j) = if i = j then (1 : ℝ) else 0) :
    g.inner x (∑ j, d j • e j) (∑ l, d l • e l) = ∑ j, d j ^ 2 := by
