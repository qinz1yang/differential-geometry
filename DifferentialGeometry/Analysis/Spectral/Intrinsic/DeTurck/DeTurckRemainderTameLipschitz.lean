  obtain ⟨hre0, hreL2⟩ := lc0b_reindex_feed_transfer (I := I) (M := M) g₀ 3 1
    (lc0PureDT (I := I) (M := M) g₀ g₁ 1) lc0IVPerm Λdt (fun q => Kdt q * Win) i
