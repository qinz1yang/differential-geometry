    h12 (lieCorr0AMixFib_contMDiff (I := I) g₀ g₁ g_bg)
  have h1234 := ContMDiff.add_section
    (s := fun x => ((show TensorRSSpace 2 2 I x from
      TensorRSSpace.ofCLM (lieCorr0InsertFib (I := I) g₀ g₁ g_bg x)) +
