    (lc0Kappa (I := I) (M := M) g₀ g₁ g₀) Λκ (fun q => Kκ q * Win) i hκ0 hκWin
  have hK0 : ∀ x : M, riemannianFiberNormSq (I := I) (M := M) g₀ (0 + 1) (3 + 1) x
