  have hPT2 : ∀ j : ℕ, ‖iteratedCovGrad (I := I) g₀ 0 2 j Pc‖ ^ 2 ≤
      ‖iteratedCovGrad (I := I) g₀ 0 2 j T‖ ^ 2 := by
    intro j
