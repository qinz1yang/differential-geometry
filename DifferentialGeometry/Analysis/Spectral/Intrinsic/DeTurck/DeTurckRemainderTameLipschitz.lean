  obtain ⟨C2o, hC2o_nn, hC2o⟩ := lc0b_twoArm_fn (I := I) (M := M) g₀ 4 2 2 4
  set fr : ℝ := (Module.finrank ℝ E : ℝ) with hfr
  have hfr_nn : 0 ≤ fr := Nat.cast_nonneg _
  set ΛK : ℝ := fr ^ 1 * Λκ with hΛK
