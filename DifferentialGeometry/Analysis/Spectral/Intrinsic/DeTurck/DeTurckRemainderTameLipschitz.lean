            2 * (∑ i ∈ Finset.range (a + 1), ‖iteratedCovGrad (I := I) g₀ 2 2 i K₀‖ ^ 2) :=
          jetTowerSum_add_le (I := I) g₀ 2 2 (a + 1) C₀ K₀
