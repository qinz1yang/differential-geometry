  refine ⟨fun i => 64 * (fr * (Kc0 i + Kcb i)) + 8 * Kvb i + 4 * Kam i + 2 * Kri i,
    fun i => by
      have h1 := hKc0_nn i
      have h2 := hKcb_nn i
      have h3 := hKvb_nn i
      have h4 := hKam_nn i
      have h5 := hKri_nn i
