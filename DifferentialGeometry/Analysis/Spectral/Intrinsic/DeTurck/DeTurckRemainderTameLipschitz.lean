          Finset.sum_nonneg fun n _ => sq_nonneg _
        have h2 : (0 : ℝ) ≤ ∑ n ∈ Finset.range (i + 1), Cth n :=
          Finset.sum_nonneg fun n _ => hCth_nn n
        have h3 : (0 : ℝ) ≤ ∑ q ∈ Finset.range (i + 1), Kg q :=
          Finset.sum_nonneg fun q _ => hKg_nn q
