  have ha2 := harm 2 (by norm_num) C₂ K₂ hK₂_le (hK₂ q hq) hC₂sup hC₂jet
  have hnorm0 : ‖iteratedCovGrad (I := I) g₀ 0 2 q A₀‖ ≤ Real.sqrt (base * S₂) := by
