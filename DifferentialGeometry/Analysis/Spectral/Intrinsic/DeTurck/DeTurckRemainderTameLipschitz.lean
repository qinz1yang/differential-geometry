        (lc0Kappa (I := I) (M := M) g₀ g₁ g₀)).toSection x) ≤ ΛK :=
    fun x => le_trans (hK0raw x) (le_of_eq (by rw [hΛK_def]))
  have hKWin : ∀ q : ℕ, q ≤ i →
      ∑ q' ∈ Finset.range (q + 1),
        ‖iteratedCovGrad (I := I) g₀ (0 + 1) (3 + 1) q'
          (slotExtendIter (I := I) (M := M) g₀ 0 3 1
            (lc0Kappa (I := I) (M := M) g₀ g₁ g₀))‖ ^ 2 ≤ KK q * Win :=
