      (lc0w_win_mono (I := I) (M := M) g₀ P hq) (hKdt_nn q))
  have hKW : ∀ q : ℕ, q ≤ i →
      ∑ q' ∈ Finset.range (q + 1),
        ‖iteratedCovGrad (I := I) g₀ 0 3 q'
