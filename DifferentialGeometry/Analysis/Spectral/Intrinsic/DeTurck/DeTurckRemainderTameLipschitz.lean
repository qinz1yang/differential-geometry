          (DifferentialGeometry.Analysis.Parabolic.TensorSpectral.sharpFlatEndoCc
            (I := I) g₀ g₁)).toSection x) ≤
      (1 / (1 - δ₀)) ^ 2 * riemannianFiberNormSq (I := I) (M := M) g₀ 1 c x (D.toSection x) := by
  classical
