  classical
  obtain ⟨Cbr, hCbr_nn, hCbr⟩ :=
    exists_iteratedCovGrad_sum_le_smoothCcToTensorHs (I := I) (M := M) g₀ (a + 2)
  have hR_nn : (0 : ℝ) ≤ Cbr * R₀ := mul_nonneg hCbr_nn hR₀
