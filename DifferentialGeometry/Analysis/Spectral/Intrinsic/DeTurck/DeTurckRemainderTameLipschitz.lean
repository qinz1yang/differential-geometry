  rw [lc0w_lieCorr0_add_endoArmBase_decomp (I := I) (M := M) g₀ g₁ g_bg]
  set IΔ : SmoothCcTensor g₀ 2 2 := slotInsertEndoCc (I := I) (M := M) g₀ 1
    (lc0NEndoSec (I := I) (M := M) g₀ g₁ g_bg -
