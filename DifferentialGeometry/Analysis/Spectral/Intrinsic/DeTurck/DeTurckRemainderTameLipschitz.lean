    have h2 := lc0b_rfns_toSection_add_le (I := I) (M := M) g₀ 0 3
      (connDiffLoweredCc (I := I) g₀ g₁ + lc0LowFix (I := I) (M := M) g₀ gB)
      (lc0PbLow (I := I) (M := M) g₀ P g₁ g₀) x
    have h3 := lc0b_rfns_toSection_add_le (I := I) (M := M) g₀ 0 3
