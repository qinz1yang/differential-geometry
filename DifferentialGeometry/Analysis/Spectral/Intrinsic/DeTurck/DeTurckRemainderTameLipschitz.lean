        (I := I) g₀ T T' hδ hδ').choose_spec.choose_spec
    exact hident hTsymm hT'symm s hs x v hδ_lt hδ'_lt
  · intro s hs x
    have h := hC0 T T' hδ_le hδ hδ'_le hδ' hTball hT'ball s hs x
    exact h.1
  · intro s hs x
    have h := hC0 T T' hδ_le hδ hδ'_le hδ' hTball hT'ball s hs x
