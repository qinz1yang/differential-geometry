        (domDomCongrSection (I := I) g₀ (Equiv.swap (0 : Fin 3) 2) B
          + domDomCongrSection (I := I) g₀ (finRotate 3) B
          - B) := by
    have h0 : DifferentialGeometry.Analysis.Parabolic.TensorSpectral.koszulCovecCc
        (I := I) g₀ T =
        (1 / 2 : ℝ) •
          (domDomCongrSection (I := I) g₀ (Equiv.swap (0 : Fin 3) 2) B
            + domDomCongrSection (I := I) g₀ (finRotate 3) B
