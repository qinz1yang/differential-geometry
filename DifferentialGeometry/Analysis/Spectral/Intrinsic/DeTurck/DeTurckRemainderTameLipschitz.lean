    lc0w_cdV_feed (I := I) (M := M) g₀ g_bg a ha_super hR hδ₁_lt
  obtain ⟨Kvb, hKvb_nn, hvb⟩ := lc0w_vb_feed (I := I) (M := M) g₀ a ha_super hR hδ₁_lt
  obtain ⟨Kam, hKam_nn, ham⟩ :=
    lc0w_amix_feed (I := I) (M := M) g₀ g_bg a ha_super hR hδ₁_lt
