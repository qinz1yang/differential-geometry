        (reindexCoeffGen (I := I) (M := M) g₀ 3 1
          (lc0PureDT (I := I) (M := M) g₀ g₁ 1) lc0IVPerm)
        (slotExtendIter (I := I) (M := M) g₀ 0 1 2
          (lc0VFlat (I := I) (M := M) g₀ g₁ gB))).toSection x) B =
