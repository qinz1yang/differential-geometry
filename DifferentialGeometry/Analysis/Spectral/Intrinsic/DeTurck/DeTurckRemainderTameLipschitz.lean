        (∀ x : M, riemannianFiberNormSq (I := I) (M := M) g₀ 0 1 x
            ((lc0VFlat (I := I) (M := M) g₀ g₁ gB).toSection x) ≤ Λ) ∧
        (∀ i : ℕ,
          ∑ q ∈ Finset.range (i + 1),
            ‖iteratedCovGrad (I := I) g₀ 0 1 q
              (lc0VFlat (I := I) (M := M) g₀ g₁ gB)‖ ^ 2 ≤
          K i * (1 + ∑ j ∈ Finset.range (i + 2),
            ‖iteratedCovGrad (I := I) g₀ 0 2 j P‖ ^ 2)) := by
