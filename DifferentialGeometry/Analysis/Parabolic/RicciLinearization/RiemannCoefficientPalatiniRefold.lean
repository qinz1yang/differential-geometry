        (hbound : gFibreOpBound (I := I) (M := M) g₀ (ccTensorBilinSymm (I := I) g₀ T) δ)
        (l : ℕ) (x : M),
        riemannianFiberNormSq (I := I) (M := M) g₀ 4 (4 + l) x
            ((iteratedCovGrad (I := I) g₀ 4 4 l
              (slotInsertEndoCc (I := I) (M := M) g₀ 3
