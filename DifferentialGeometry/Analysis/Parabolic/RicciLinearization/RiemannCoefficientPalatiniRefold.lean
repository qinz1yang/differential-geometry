    have t5 := norm_add_sq_le_local (I := I) (M := M) g₀ jd ((1 / 2 : ℝ) • js)
    have t6 : ‖(1 / 2 : ℝ) • js‖ ^ 2 = (1 / 4) * ‖js‖ ^ 2 := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
