      (T := tensor0S_curry (I := I) (M := M) (𝕜 := ℝ) 2 x
        (tensor0S_curry (I := I) (M := M) (𝕜 := ℝ) 3 x G (u 0)) (u 1))
      (v0 := u 2) (vs := Fin.cons (u 3) (fun i : Fin 0 => i.elim0))
