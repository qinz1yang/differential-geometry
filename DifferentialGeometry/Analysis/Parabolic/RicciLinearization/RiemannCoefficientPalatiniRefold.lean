  rw [bdSlotInsertZero_fullRaisedRev_eq_omRecover (I := I) (M := M) g₀ g₁]
  rw [mul_assoc]
  exact mul_le_mul_of_nonneg_left (hC g₁ T htie hδ_le hδ0 hbound l x) (by positivity)

