private theorem bdBgRComm_eq_refold (g₀ g : SmoothRiemannianMetric I M) :
    ricciArmOrder0BgRCommCoeffField (I := I) (M := M) g₀ g =
      appCcRS (I := I) (M := M) g₀ 2 4 2 (bdPureDT (I := I) (M := M) g₀ g 2)
