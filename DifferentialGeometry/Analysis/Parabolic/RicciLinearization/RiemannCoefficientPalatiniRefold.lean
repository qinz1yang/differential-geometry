  calc ∑ k ∈ Finset.range W, Combinatorics.antidiagonalTupleGrid b k
      ≤ ∑ _k ∈ Finset.range W, Combinatorics.boundedFactorGridWindow b K W' := by
        refine Finset.sum_le_sum fun k hk => ?_
        rw [Finset.mem_range] at hk
