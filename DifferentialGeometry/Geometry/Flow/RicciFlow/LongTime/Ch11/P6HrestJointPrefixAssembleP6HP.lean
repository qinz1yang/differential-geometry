/-- **位置四分（细化）**：`0 < σ` 时 `σ` 落在 event 内部 / final 内部 / 某 `time i.succ` / 视界
（`time last < horizon`）。 -/
theorem position4_P6HP (H : ObservedHistory.{u}) (σ : Icc (0 : ℝ) H.horizon) (hσ : 0 < (σ : ℝ)) :
    (∃ j : Fin H.eventCount, H.time j.castSucc < (σ : ℝ) ∧ (σ : ℝ) < H.time j.succ) ∨
    (H.time (Fin.last H.eventCount) < (σ : ℝ) ∧ (σ : ℝ) < H.horizon) ∨
    (∃ i : Fin H.eventCount, (σ : ℝ) = H.time i.succ) ∨
    (H.time (Fin.last H.eventCount) < H.horizon ∧ (σ : ℝ) = H.horizon) := by
  have hstage : ∀ m : Fin (H.eventCount + 1), (σ : ℝ) = H.time m →
      ∃ i : Fin H.eventCount, (σ : ℝ) = H.time i.succ := by
    intro m hm
    rcases Fin.eq_zero_or_eq_succ m with rfl | ⟨i, rfl⟩
    · rw [H.time_zero] at hm
      exact absurd hm hσ.ne'
    · exact ⟨i, hm⟩
  rcases exists_position_P6S H σ with h | h | ⟨m, hm⟩ | h
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr (Or.inl (hstage m hm)))
  · rcases lt_or_eq_of_le H.time_le_horizon with hl | hl
    · exact Or.inr (Or.inr (Or.inr ⟨hl, h⟩))
    · exact Or.inr (Or.inr (Or.inl (hstage _ (h.trans hl.symm))))

/-- **子列版位置四分（细化）**。 -/
theorem exists_strictMono_position4_P6HP {Kh : ℕ → ObservedHistory.{u}}
    (σ : ∀ n, Icc (0 : ℝ) (Kh n).horizon) (hσ : ∀ n, 0 < (σ n : ℝ)) :
