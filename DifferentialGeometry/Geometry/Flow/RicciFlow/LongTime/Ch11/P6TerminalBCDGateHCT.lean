            ∀ z ∈ riemannianBallOf ((Kh k).event (i k)).terminal.metric
                ⟨p', hcross.mem_terminalRegularRegion ((Kh k).event (i k))⟩ R',
              metricScalarAt ((Kh k).event (i k)).terminal.metric z ≤ Lb := by
