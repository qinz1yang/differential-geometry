/-- final slab 的窗口 pinching，重标度形（`_P6WR2`）：`hpinchK0_rescale_P6X2` 的 final-slab 孪生。原尺度 history
HI（`fixedHamiltonIveyRegion_and_scalar_lower`，stage `last` 的 domain = `[time last, horizon]`，度量 =
`finalSlab`）⇒ 重标度 final slab（`(K.finalSlab h').rescale c`，`restrictIncoming` 的 flow 即原 flow）在年龄
`a₀/c + t ≥ 1` 内 `PhiAlmostNonnegative`（同一 age-normalized `Phi`）。 -/
theorem RetainedCoreHistory.phiAlmostNonnegative_finalSlab_rescale_P6WR2 {Phi : ℝ → ℝ}
    (hphi : ∀ (X : Type u) [TopologicalSpace X] [ChartedSpace ThreeSpace X]
        [IsManifold ThreeModel ∞ X] [T2Space X],
        ∀ (D : RealTimeInterval) (S : SolutionOn (I := ThreeModel) (M := X) D)
          (W : Set ℝ) (a : ℝ → ℝ),
          (∀ t ∈ W, 1 ≤ a t) →
          (∀ t ∈ W, ∀ x : X, InFixedHamiltonIveyRegion (S.base.metric t) (a t) x) →
          Perelman.PhiAlmostNonnegative S W Phi)
    (K : RetainedCoreHistory.{u}) {c : ℝ} (hc : 0 < c) {pF : CutoffParameters}
    (recordsF : ∀ i, GeometricCutoffRecord K.toHistory i pF) {a₀ : ℝ} (ha₀ : 0 < a₀)
    (hHI : ∀ x, InFixedHamiltonIveyRegion (K.initialMetric 0) a₀ x ∧
      -3 / a₀ ≤ metricScalarAt (K.initialMetric 0) x)
    {T₀ : ℝ} (hT₀ : 1 ≤ T₀)
    (hfin : (K.rescale_P6N c hc).time (Fin.last (K.rescale_P6N c hc).eventCount) <
      (K.rescale_P6N c hc).horizon) :
    Perelman.PhiAlmostNonnegative
      (((K.rescale_P6N c hc).finalSlab hfin).restrictIncoming le_rfl hfin le_rfl).flow
      (Ico ((K.rescale_P6N c hc).time (Fin.last (K.rescale_P6N c hc).eventCount))
        (K.rescale_P6N c hc).horizon ∩ Ici T₀) Phi := by
  have h' : K.time (Fin.last K.eventCount) < K.horizon :=
    (div_lt_div_iff_of_pos_right hc).mp hfin
  have hhistory := K.toHistory.fixedHamiltonIveyRegion_and_scalar_lower recordsF ha₀
    (fun x => (hHI x).1) (fun x => (hHI x).2)
  refine hphi _ _ _ _ (fun t => a₀ / c + t) ?_ ?_
  · intro t ht
    have h1 : T₀ ≤ t := ht.2
    have h2 : 0 < a₀ / c := div_pos ha₀ hc
    linarith
  · intro t ht x
    suffices key : ∀ z : (K.stage (Fin.last K.eventCount)).Carrier,
        InFixedHamiltonIveyRegion (((K.finalSlab h').rescale c hc).flow.base.metric t)
          (a₀ / c + t) z from key x
    intro z
    rw [OrientedThreeStage.ClosedSlab.rescale_metric,
      inFixedHamiltonIveyRegion_scaleMetric_inv_iff_P6M hc]
    have hlo : K.time (Fin.last K.eventCount) / c ≤ t := ht.1.1
    have hhi : t < K.horizon / c := ht.1.2
    rw [div_le_iff₀ hc] at hlo
    rw [lt_div_iff₀ hc] at hhi
    have hct : c * t ∈ K.toHistory.stageDomain (Fin.last K.toHistory.eventCount) := by
      rw [ObservedHistory.mem_stageDomain_last]
      exact ⟨by change K.time (Fin.last K.eventCount) ≤ c * t; linarith,
        by change c * t ≤ K.horizon; linarith⟩
    have h := (hhistory.1 (Fin.last K.toHistory.eventCount) (c * t) hct z).1
    rw [ObservedHistory.stageMetric_last_of_lt (h := h')] at h
    have heq : a₀ + c * t = c * (a₀ / c + t) := by
      field_simp
    rw [← heq]
    exact h

/-- final slab 时间导数界的重标度（`_P6WR2`）：`derivativeBoundBefore_rescale_P6X3` 的 final-slab 孪生
（`Ctime` 不变、阈值 `qcan ↦ c·qcan`、终点 `horizon ↦ horizon/c`）。 -/
theorem RetainedCoreHistory.derivativeBoundBefore_finalSlab_rescale_P6WR2
    (K : RetainedCoreHistory.{u}) {c : ℝ} (hc : 0 < c) {Ctime : ℝ≥0} {qcan : ℝ}
    (h : ∀ hK : K.time (Fin.last K.eventCount) < K.horizon,
      ((K.finalSlab hK).restrictIncoming le_rfl hK le_rfl).DerivativeBoundBefore Ctime qcan
        K.horizon)
    (hfin : (K.rescale_P6N c hc).time (Fin.last (K.rescale_P6N c hc).eventCount) <
      (K.rescale_P6N c hc).horizon) :
    OrientedThreeStage.IncomingSlab.DerivativeBoundBefore
      (((K.rescale_P6N c hc).finalSlab hfin).restrictIncoming le_rfl hfin le_rfl)
      Ctime (c * qcan) (K.rescale_P6N c hc).horizon := by
  have h' : K.time (Fin.last K.eventCount) < K.horizon :=
    (div_lt_div_iff_of_pos_right hc).mp hfin
  have hG := h h'
  intro y t ht hq
  have hs : ∀ v, (((K.rescale_P6N c hc).finalSlab hfin).restrictIncoming le_rfl hfin
      le_rfl).flow.scalar v y =
      c * ((K.finalSlab h').restrictIncoming le_rfl h' le_rfl).flow.scalar (c * v) y := by
    intro v
    suffices key : ∀ z : (K.stage (Fin.last K.eventCount)).Carrier,
        metricScalarAt (((K.finalSlab h').rescale c hc).flow.base.metric v) z =
          c * metricScalarAt ((K.finalSlab h').flow.base.metric (c * v)) z from key y
    intro z
    rw [OrientedThreeStage.ClosedSlab.rescale_metric, metricScalarAt_scaleMetric, inv_inv]
  have hct : c * t ∈ Ioo (K.time (Fin.last K.eventCount)) K.horizon := by
    obtain ⟨h1, h2⟩ := ht
    change K.time (Fin.last K.eventCount) / c < t at h1
    change t < K.horizon / c at h2
    rw [div_lt_iff₀ hc] at h1
    rw [lt_div_iff₀ hc] at h2
    exact ⟨by linarith, by linarith⟩
  rw [hs] at hq
  have hq' : qcan < ((K.finalSlab h').restrictIncoming le_rfl h' le_rfl).flow.scalar (c * t) y :=
    (mul_lt_mul_iff_right₀ hc).mp hq
  have hD := hG y (c * t) hct hq'
  have hfun : (fun v => (((K.rescale_P6N c hc).finalSlab hfin).restrictIncoming le_rfl hfin
      le_rfl).flow.scalar v y) =
      fun v => c • (fun u => ((K.finalSlab h').restrictIncoming le_rfl h' le_rfl).flow.scalar u y)
        (c * v) := by
    funext v
    rw [hs, smul_eq_mul]
  rw [hfun, derivWithin_fun_const_smul_field,
    derivWithin_comp_mul_left c
      (fun u => ((K.finalSlab h').restrictIncoming le_rfl h' le_rfl).flow.scalar u y),
    LinearOrderedField.smul_Iic hc, hs, smul_eq_mul, smul_eq_mul]
  set D := derivWithin (fun u => ((K.finalSlab h').restrictIncoming le_rfl h' le_rfl).flow.scalar
    u y) (Iic (c * t)) (c * t)
  set Rz := ((K.finalSlab h').restrictIncoming le_rfl h' le_rfl).flow.scalar (c * t) y
  have hc2 : 0 < c ^ 2 := by positivity
  rw [show |c * (c * D)| = c ^ 2 * |D| by
      rw [abs_mul, abs_mul, abs_of_pos hc]; ring,
    show (Ctime : ℝ) * (c * Rz) ^ 2 = c ^ 2 * (Ctime * Rz ^ 2) by ring]
  exact (mul_le_mul_iff_of_pos_left hc2).mpr hD

/-- final slab 时间导数界的原尺度来源（`_P6WR2`）：ch12 F2 `timeDerivativeSupply_of_astra_threshold_C12X`
（阈值 `qcanSup`）的 final 支 + 有限带上界 `qcanSup S t ≤ qcanSup S horizon` ⇒ 原尺度
`(F.tower.history n).finalSlab` 的 `DerivativeBoundBefore C.Ctime (qcanSup S horizon_n) horizon_n`
（`eventSlabsDerivative_qcanSup_P6WR` 的 final 孪生）。 -/
theorem finalSlabDerivative_qcanSup_P6WR2 {pBase : CutoffParameters}
    {C : GC.GeneralFlow.ClosedBirthConstants} {P : OrientedThreeStage.{u}} {g : P.Metric}
    (S : GC.GeneralFlow.PreparedSpatialChain pBase C P g)
    (εcut Dcut : ℕ → ℝ) (mcut : ℕ → ℕ)
    (W : ∀ m, GC.GeneralFlow.PreparedSpatialStepRetention (S.state m) (S.state (m + 1))
      (S.accuracy m) (1 / ((m : ℝ) + 2)) (εcut m) (Dcut m) (mcut m))
    (hshift : ∀ m, (S.state (m + 1)).shift =
      (S.state m).history.time (Fin.last (S.state m).history.eventCount))
    (hoffset : ∀ m, (S.state (m + 1)).offset = (S.state m).history.eventCount)
    (F : GC.Interface.RawSurgery P g) (hTower : F.tower = S.tower) (n : ℕ)
    (hK : (F.tower.history n).time (Fin.last (F.tower.history n).eventCount) <
      (F.tower.history n).horizon) :
    (((F.tower.history n).finalSlab hK).restrictIncoming le_rfl hK le_rfl).DerivativeBoundBefore
      C.Ctime (GC.LongTime.Ch11.qcanSup_P6WR S (F.tower.history n).horizon)
      (F.tower.history n).horizon := by
  have h := GC.LongTime.Ch11.timeDerivativeSupply_of_astra_threshold_C12X S εcut Dcut mcut W
    hshift hoffset F hTower (GC.LongTime.Ch11.qcanSup_P6WR S) (GC.LongTime.Ch11.hQ_qcanSup_P6WR S)
  intro y t ht hR
  exact h.2 n hK y t ht ((GC.LongTime.Ch11.qcanSup_mono_P6WR S ht.2.le).trans_lt hR)

/-- G2/G3 的 KNOM 阈值：`diagonalPack_nom_CXKN` 取 NOMID 固定档（`Cb n = 1/(n+1)²`、`Rn n = n+1`、
`ζ n = δ₀ n = 1/(n+1)`、`m₀ n = n+2`、`Q := 0`）的 `Tmin`（与 `ind` 无关）；`a₀ > 0` 以 `dite` 吸收。 -/
def lateThrJF_P6WR2 {P : OrientedThreeStage.{u}} {g : P.Metric}
    {F : GC.Interface.RawSurgery P g} {q : CutoffParameters} (a₀ : ℝ)
    (records : GC.LongTime.Ch11.CutoffRecords_C11S F q)
    (hP5L : ∀ (D ε : ℝ) (m : ℕ), 0 < ε → ∃ T : ℝ, ∀ k, ∃ p : CutoffParameters,
      p.delta = q.delta ∧ p.neckRadius = q.neckRadius ∧ p.fixed = q.fixed ∧
      p.recenterConstant = q.recenterConstant ∧ D ≤ p.modelRadius ∧ p.modelAccuracy ≤ ε ∧
      m ≤ p.modelOrder ∧ ∃ rs : ∀ i : Fin (F.tower.history k).eventCount,
        T ≤ (F.tower.history k).time i.succ →
        GeometricCutoffRecord (F.tower.history k).toHistory i p,
      (∀ i hi b, GC.LongTime.Ch11.linkedCanonicalWindow_C11E ((rs i hi).static b)) ∧
      ∀ i hi, (rs i hi).nominalRadius = (records k i).nominalRadius ∧
        (rs i hi).delta = (records k i).delta ∧
        (rs i hi).order = (records k i).order ∧
        (∀ α, HEq ((rs i hi).neck α) ((records k i).neck α)) ∧
        (∀ b, ((rs i hi).static b).neck.scale = ((records k i).static b).neck.scale) ∧
        ∀ (b) (z : ThreeBall),
          ((rs i hi).static b).inclusion (((rs i hi).static b).witness.cap z) =
            ((records k i).static b).inclusion (((records k i).static b).witness.cap z))
    (hδq : Tendsto q.delta atTop (𝓝 0)) (hanti : AntitoneOn q.neckRadius (Ici 0)) : ℕ → ℝ := by
  classical
  exact if ha₀ : 0 < a₀ then
    Classical.choose (diagonalPack_nom_CXKN (H := F.tower.history) records
      (fun n => 1 / ((n : ℝ) + 1) ^ 2) (fun n => (n : ℝ) + 1) (fun n => 1 / ((n : ℝ) + 1))
      (fun n => 1 / ((n : ℝ) + 1)) (fun n => n + 2) (fun n => ⟨by positivity, le_rfl⟩)
      (fun n => by positivity) (fun n => by positivity) ha₀ (fun _ => 0) hP5L hδq hanti)
  else 0

