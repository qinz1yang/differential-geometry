        metricScalarAt ((Hs n).stageMetric ((Hs n).activeStage (ts n)) (ts n)) z ≤ Cball * R n) →
      (Hs n).isTracedRegion (ts n) (ys n) (A / Real.sqrt (R n)) (T / R n) (K * R n) := by
  have hδW : ∀ ε : ℝ, 0 < ε → ∀ᶠ n in atTop, ∀ e : Fin (Hs n).eventCount,
      (aSeed n : ℝ) < (Hs n).time e.succ → (qX n).delta ((Hs n).time e.succ) ≤ ε := by
    intro ε hε
    filter_upwards [eventually_windowDelta_le_P6HS Hs hδlim haSlim hε] with n hn e hae
    rw [hδeq n]
    exact hn e hae
  exact RetainedCoreHistory.hsurvive_noJ10_firstExit_windowNeck_P6JW2 hphi recordsF hHI hend hGi
