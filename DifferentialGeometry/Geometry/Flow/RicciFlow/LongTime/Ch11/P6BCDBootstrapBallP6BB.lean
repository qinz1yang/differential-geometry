/-- **网格步长 `β_*`（`_P6BB`）**：`C_eff := max(Ctime, 1)`、
`Q_* := max (max (max (Cball r) (Cgrid r T)) 4) 1`、`β_* := 1/(2·C_eff·Q_*)`。 -/
def gridStep_P6BB (Ctime : ℝ≥0) (Cball : ℝ → ℝ) (Cgrid : ℝ → ℝ → ℝ) (r T : ℝ) : ℝ :=
  1 / (2 * max (Ctime : ℝ) 1 * max (max (max (Cball r) (Cgrid r T)) 4) 1)

/-- **`β_*` 的两条性质（`_P6BB`，PROVED）**：`0 < β_*` 且 `2·Ctime·Q_*·β_* ≤ 1`（`Ctime = 0` 时亦然）。 -/
theorem betaStar_P6BB {Ctime : ℝ≥0} {Cball : ℝ → ℝ} {Cgrid : ℝ → ℝ → ℝ} :
    (∀ r T, 0 < gridStep_P6BB Ctime Cball Cgrid r T) ∧
    ∀ r T, 2 * (Ctime : ℝ) * max (max (max (Cball r) (Cgrid r T)) 4) 1 *
      gridStep_P6BB Ctime Cball Cgrid r T ≤ 1 := by
  refine ⟨fun r T => ?_, fun r T => ?_⟩
  · have hQ : (1 : ℝ) ≤ max (max (max (Cball r) (Cgrid r T)) 4) 1 := le_max_right _ _
    have hC : (1 : ℝ) ≤ max (Ctime : ℝ) 1 := le_max_right _ _
    have hpos : 0 < 2 * max (Ctime : ℝ) 1 * max (max (max (Cball r) (Cgrid r T)) 4) 1 := by
      positivity
    exact one_div_pos.2 hpos
  · have hQ : (1 : ℝ) ≤ max (max (max (Cball r) (Cgrid r T)) 4) 1 := le_max_right _ _
    have hC : (Ctime : ℝ) ≤ max (Ctime : ℝ) 1 := le_max_left _ _
    have hC1 : (1 : ℝ) ≤ max (Ctime : ℝ) 1 := le_max_right _ _
    have hpos : 0 < 2 * max (Ctime : ℝ) 1 * max (max (max (Cball r) (Cgrid r T)) 4) 1 := by
      positivity
    rw [gridStep_P6BB, mul_one_div, div_le_one hpos]
    nlinarith

/-- **端点球成员关系的搬运（`_P6BB`，PROVED）**：`activeStage τ = k`、`τ = s`、`w ≍ w′`、`c ≍ c′` ⇒
`stageAt τ` 中的球成员关系与 `stage k` 在时刻 `s` 的相同（`subst` 型；J10WIRE `transport_at_stage_P6JW`
第三分量的无 seed 版）。 -/
theorem ObservedHistory.ball_transport_P6BB {H : ObservedHistory.{u}}
    {τ : Icc (0 : ℝ) H.horizon} {k : Fin (H.eventCount + 1)} (hk : H.activeStage τ = k) {s : ℝ}
    (hs : (τ : ℝ) = s) (w c : (H.stageAt τ).Carrier) (w' c' : (H.stage k).Carrier)
    (hw : HEq w w') (hc : HEq c c') {ρ : ℝ} :
    w ∈ riemannianBallOf (H.stageMetric (H.activeStage τ) τ) c ρ ↔
      w' ∈ riemannianBallOf (H.stageMetric k s) c' ρ := by
  subst hk
  subst hs
  obtain rfl := eq_of_heq hw
  obtain rfl := eq_of_heq hc
  exact Iff.rfl

/-- **端点标量的搬运（`_P6BB`，PROVED）**：`activeStage τ = k`、`τ = s`、`w ≍ w′` ⇒ 标量相同（`subst` 型）。 -/
theorem ObservedHistory.scalar_transport_P6BB {H : ObservedHistory.{u}}
    {τ : Icc (0 : ℝ) H.horizon} {k : Fin (H.eventCount + 1)} (hk : H.activeStage τ = k) {s : ℝ}
    (hs : (τ : ℝ) = s) (w : (H.stageAt τ).Carrier) (w' : (H.stage k).Carrier)
    (hw : HEq w w') :
    metricScalarAt (H.stageMetric (H.activeStage τ) τ) w =
      metricScalarAt (H.stageMetric k s) w' := by
  subst hk
  subst hs
  obtain rfl := eq_of_heq hw
  rfl

/-- **转换引理 2（`_P6BB`，PROVED）traced region ⇒ trace 形 anchor**：`isTracedRegion σ y ρ τ (K·R)`、
`z ∈ B_σ(y, ρ)`、`σ − τ ≤ a`，trace `A`（`a → σ`）⇒ `[a, σ]` 上 `R(w, A(w)) ≤ 9K·R`。 -/
theorem ObservedHistory.hgrid_of_isTracedRegion_P6BB (H : ObservedHistory.{u})
    {σ a : Icc (0 : ℝ) H.horizon} {y : (H.stageAt σ).Carrier} {ρ τ K R : ℝ} (hR : 0 < R)
    (hK : 0 ≤ K) (hTR : H.isTracedRegion σ y ρ τ (K * R)) {z : (H.stageAt σ).Carrier}
    (hz : z ∈ riemannianBallOf (H.stageMetric (H.activeStage σ) σ) y ρ) (haσ : a ≤ σ)
    (hτa : (σ : ℝ) - τ ≤ a)
    (A : BackwardPointTrace H (H.activeStage a) (H.activeStage σ) (H.activeStage_mono haσ) z)
    (w : Icc (0 : ℝ) H.horizon) (haw : a ≤ w) (hwσ : w ≤ σ) :
    metricScalarAt (H.stageMetric (H.activeStage w) w)
      (A.point (H.activeStage w) (H.activeStage_mono haw) (H.activeStage_mono hwσ)) ≤
      9 * K * R := by
  obtain ⟨-, -, a₁, ha₁σ, ha₁eq, hreg⟩ := hTR
  obtain ⟨A₁, hA₁⟩ := hreg z hz
  have ha₁w : a₁ ≤ w := by
    change (a₁ : ℝ) ≤ w
    have h1 : (a : ℝ) ≤ w := haw
    linarith
  have h := H.scalar_le_of_isRmBounded_CXJP (Qb := 9 * K / 2) haσ ha₁σ hR (by linarith) hK A A₁
    hA₁ w haw ha₁w hwσ
  have e : 2 * (9 * K / 2 * R) = 9 * K * R := by ring
  linarith

/-- **转换引理 1 的使用（`_P6BB`，PROVED）整球合同 + 邻域加厚 ⇒ trace 形格点 anchor**：`hthick` 给 `A(w)` 落在
移动中心 `P(w)` 的球内，`hballGrid` 在该球上给 `R ≤ Q_*·R_k`；`j·β_* ≤ T` 由 `t − T/R_k ≤ a ≤ w` 付。 -/
theorem hgridTr_of_ballGrid_P6BB {P : OrientedThreeStage.{u}} {g : P.Metric}
    {F : GC.Interface.RawSurgery P g} {ε C1 C2 : ℝ} {Ctime : ℝ≥0} {Cball : ℝ → ℝ}
    {Cgrid ρ : ℝ → ℝ → ℝ}
    (hballGrid :
      ∀ (T r : ℝ), 0 < T → 0 < r →
      ∀ (ind : ℕ → ℕ) (c : ℕ → ℝ) (hc : ∀ k, 0 < c k),
        let Kh : ℕ → ObservedHistory.{u} := fun k =>
          ((F.tower.history (ind k)).rescale_P6N (c k) (hc k)).toHistory
        ∀ (Tn : ∀ k, Icc (0 : ℝ) (Kh k).horizon) (pT : ∀ k, ((Kh k).stageAt (Tn k)).Carrier),
          (∀ k : ℕ, (k : ℝ) + 1 ≤ c k * (Tn k : ℝ)) →
        ∀ (aSeed : ∀ k, Icc (0 : ℝ) (Kh k).horizon) (haT : ∀ k, aSeed k ≤ Tn k),
          (∀ k, (aSeed k : ℝ) = (Tn k : ℝ) - 1 ^ (2 : ℕ)) → (∀ k, 1 ≤ (aSeed k : ℝ)) →
          (∀ k, GC.LongTime.hasSmallParabolicCurvature (Kh k) (Tn k) (pT k) 1) →
        ∀ (seedTrace : ∀ k, BackwardPointTrace (Kh k) ((Kh k).activeStage (aSeed k))
            ((Kh k).activeStage (Tn k)) ((Kh k).activeStage_mono (haT k)) (pT k))
          (σ : ∀ k, Icc (0 : ℝ) (Kh k).horizon) (y : ∀ k, ((Kh k).stageAt (σ k)).Carrier)
          (R : ℕ → ℝ) (hsT : ∀ k, σ k ≤ Tn k) (has : ∀ k, aSeed k ≤ σ k) (L : ℕ → ℝ),
          (∀ k, R k =
            metricScalarAt ((Kh k).stageMetric ((Kh k).activeStage (σ k)) (σ k)) (y k)) →
          (∀ k, 0 < R k) → (∀ k : ℕ, (k : ℝ) + 1 ≤ R k) →
          Tendsto L atTop atTop →
          (∀ k, ¬ (Kh k).HasSpatialCanonicalTimeControl ε C1 C2 Ctime (σ k) (y k)) →
          (∀ k, ∀ (v : Icc (0 : ℝ) (Kh k).horizon) (hav : aSeed k ≤ v) (hvs : v ≤ σ k),
            (σ k : ℝ) - L k ^ (2 : ℕ) / R k ≤ (v : ℝ) →
            ∀ z : ((Kh k).stageAt v).Carrier,
              riemannianEDistOf ((Kh k).stageMetric ((Kh k).activeStage v) v)
                  ((seedTrace k).point ((Kh k).activeStage v) ((Kh k).activeStage_mono hav)
                    ((Kh k).activeStage_mono (hvs.trans (hsT k)))) z ≤
                riemannianEDistOf ((Kh k).stageMetric ((Kh k).activeStage (σ k)) (σ k))
                    ((seedTrace k).point ((Kh k).activeStage (σ k))
                      ((Kh k).activeStage_mono (has k)) ((Kh k).activeStage_mono (hsT k))) (y k) +
                  ENNReal.ofReal (L k / Real.sqrt (R k)) →
              4 * R k ≤ metricScalarAt ((Kh k).stageMetric ((Kh k).activeStage v) v) z →
              (Kh k).HasSpatialCanonicalTimeControl ε C1 C2 Ctime v z) →
          (∀ T : ℝ, 0 < T → ∀ᶠ k in atTop, (aSeed k : ℝ) ≤ σ k - T / R k) →
          (∀ T : ℝ, 0 < T → ∀ᶠ k in atTop, (Tn k : ℝ) - 1 ^ (2 : ℕ) / 2 ≤ (σ k : ℝ) - T / R k) →
          Tendsto (fun k => R k * ((σ k : ℝ) - ((Tn k : ℝ) - 1 ^ (2 : ℕ) / 2))) atTop atTop →
          Tendsto (fun k => 1 / 200 * Real.sqrt (R k)) atTop atTop →
        ∀ i : ∀ k, Fin (Kh k).eventCount, (∀ k, (σ k : ℝ) = (Kh k).time (i k).succ) →
        ∀ᶠ k in atTop, ∀ (p' : ((Kh k).stage (i k).castSucc).Carrier)
          (q : ((Kh k).stage (i k).succ).Carrier), HEq (y k) q →
          ((Kh k).event (i k)).RegularCrossing p' q →
          ∀ᶠ t in 𝓝[<] (Kh k).time (i k).succ,
            ∀ (j : ℕ), 1 ≤ j →
            (j : ℝ) * gridStep_P6BB Ctime Cball Cgrid r T ≤ T →
            ∀ (w : Icc (0 : ℝ) (Kh k).horizon), aSeed k ≤ w →
              (w : ℝ) = t - j * gridStep_P6BB Ctime Cball Cgrid r T / R k →
            ∀ (hw : (Kh k).activeStage w ≤ (i k).castSucc)
              (P : BackwardPointTrace (Kh k) ((Kh k).activeStage w) (i k).castSucc hw p'),
            ∀ x ∈ riemannianBallOf ((Kh k).stageMetric ((Kh k).activeStage w) w)
                (P.point ((Kh k).activeStage w) le_rfl hw) (ρ r T / Real.sqrt (R k)),
              metricScalarAt ((Kh k).stageMetric ((Kh k).activeStage w) w) x ≤
                Cgrid r T * R k)
    (hthick :
      ∀ (T r : ℝ), 0 < T → 0 < r →
      ∀ (ind : ℕ → ℕ) (c : ℕ → ℝ) (hc : ∀ k, 0 < c k),
        let Kh : ℕ → ObservedHistory.{u} := fun k =>
          ((F.tower.history (ind k)).rescale_P6N (c k) (hc k)).toHistory
        ∀ (Tn : ∀ k, Icc (0 : ℝ) (Kh k).horizon) (pT : ∀ k, ((Kh k).stageAt (Tn k)).Carrier),
          (∀ k : ℕ, (k : ℝ) + 1 ≤ c k * (Tn k : ℝ)) →
        ∀ (aSeed : ∀ k, Icc (0 : ℝ) (Kh k).horizon) (haT : ∀ k, aSeed k ≤ Tn k),
          (∀ k, (aSeed k : ℝ) = (Tn k : ℝ) - 1 ^ (2 : ℕ)) → (∀ k, 1 ≤ (aSeed k : ℝ)) →
          (∀ k, GC.LongTime.hasSmallParabolicCurvature (Kh k) (Tn k) (pT k) 1) →
        ∀ (seedTrace : ∀ k, BackwardPointTrace (Kh k) ((Kh k).activeStage (aSeed k))
            ((Kh k).activeStage (Tn k)) ((Kh k).activeStage_mono (haT k)) (pT k))
          (σ : ∀ k, Icc (0 : ℝ) (Kh k).horizon) (y : ∀ k, ((Kh k).stageAt (σ k)).Carrier)
          (R : ℕ → ℝ) (hsT : ∀ k, σ k ≤ Tn k) (has : ∀ k, aSeed k ≤ σ k) (L : ℕ → ℝ),
          (∀ k, R k =
            metricScalarAt ((Kh k).stageMetric ((Kh k).activeStage (σ k)) (σ k)) (y k)) →
          (∀ k, 0 < R k) → (∀ k : ℕ, (k : ℝ) + 1 ≤ R k) →
          Tendsto L atTop atTop →
          (∀ k, ¬ (Kh k).HasSpatialCanonicalTimeControl ε C1 C2 Ctime (σ k) (y k)) →
          (∀ k, ∀ (v : Icc (0 : ℝ) (Kh k).horizon) (hav : aSeed k ≤ v) (hvs : v ≤ σ k),
            (σ k : ℝ) - L k ^ (2 : ℕ) / R k ≤ (v : ℝ) →
            ∀ z : ((Kh k).stageAt v).Carrier,
              riemannianEDistOf ((Kh k).stageMetric ((Kh k).activeStage v) v)
                  ((seedTrace k).point ((Kh k).activeStage v) ((Kh k).activeStage_mono hav)
                    ((Kh k).activeStage_mono (hvs.trans (hsT k)))) z ≤
                riemannianEDistOf ((Kh k).stageMetric ((Kh k).activeStage (σ k)) (σ k))
                    ((seedTrace k).point ((Kh k).activeStage (σ k))
                      ((Kh k).activeStage_mono (has k)) ((Kh k).activeStage_mono (hsT k))) (y k) +
                  ENNReal.ofReal (L k / Real.sqrt (R k)) →
              4 * R k ≤ metricScalarAt ((Kh k).stageMetric ((Kh k).activeStage v) v) z →
              (Kh k).HasSpatialCanonicalTimeControl ε C1 C2 Ctime v z) →
          (∀ T : ℝ, 0 < T → ∀ᶠ k in atTop, (aSeed k : ℝ) ≤ σ k - T / R k) →
          (∀ T : ℝ, 0 < T → ∀ᶠ k in atTop, (Tn k : ℝ) - 1 ^ (2 : ℕ) / 2 ≤ (σ k : ℝ) - T / R k) →
          Tendsto (fun k => R k * ((σ k : ℝ) - ((Tn k : ℝ) - 1 ^ (2 : ℕ) / 2))) atTop atTop →
          Tendsto (fun k => 1 / 200 * Real.sqrt (R k)) atTop atTop →
        ∀ i : ∀ k, Fin (Kh k).eventCount, (∀ k, (σ k : ℝ) = (Kh k).time (i k).succ) →
        ∀ᶠ k in atTop, ∀ (p' : ((Kh k).stage (i k).castSucc).Carrier)
          (q : ((Kh k).stage (i k).succ).Carrier), HEq (y k) q →
          ((Kh k).event (i k)).RegularCrossing p' q →
          ∀ᶠ t in 𝓝[<] (Kh k).time (i k).succ,
            ∀ (tt : Icc (0 : ℝ) (Kh k).horizon), (tt : ℝ) = t → tt ≤ σ k →
            ∀ (a : Icc (0 : ℝ) (Kh k).horizon), aSeed k ≤ a → ∀ (hat : a ≤ tt),
              t - T / R k ≤ (a : ℝ) →
            ∀ z' : ((Kh k).stageAt tt).Carrier,
              (∀ z : ((Kh k).stage (i k).castSucc).Carrier, HEq z' z →
                z ∈ riemannianBallOf (((Kh k).event (i k)).incoming.flow.base.metric t) p'
                  (r / Real.sqrt (R k))) →
            ∀ (A : BackwardPointTrace (Kh k) ((Kh k).activeStage a) ((Kh k).activeStage tt)
                ((Kh k).activeStage_mono hat) z')
              (j : ℕ), 1 ≤ j → ∀ (w : Icc (0 : ℝ) (Kh k).horizon) (haw : a ≤ w) (hwt : w ≤ tt),
              (w : ℝ) = t - j * gridStep_P6BB Ctime Cball Cgrid r T / R k →
            ∃ (hw : (Kh k).activeStage w ≤ (i k).castSucc)
              (P : BackwardPointTrace (Kh k) ((Kh k).activeStage w) (i k).castSucc hw p'),
              A.point ((Kh k).activeStage w) ((Kh k).activeStage_mono haw)
                  ((Kh k).activeStage_mono hwt) ∈
                riemannianBallOf ((Kh k).stageMetric ((Kh k).activeStage w) w)
                  (P.point ((Kh k).activeStage w) le_rfl hw) (ρ r T / Real.sqrt (R k)))
    :
      ∀ (T r : ℝ), 0 < T → 0 < r →
      ∀ (ind : ℕ → ℕ) (c : ℕ → ℝ) (hc : ∀ k, 0 < c k),
        let Kh : ℕ → ObservedHistory.{u} := fun k =>
          ((F.tower.history (ind k)).rescale_P6N (c k) (hc k)).toHistory
        ∀ (Tn : ∀ k, Icc (0 : ℝ) (Kh k).horizon) (pT : ∀ k, ((Kh k).stageAt (Tn k)).Carrier),
          (∀ k : ℕ, (k : ℝ) + 1 ≤ c k * (Tn k : ℝ)) →
        ∀ (aSeed : ∀ k, Icc (0 : ℝ) (Kh k).horizon) (haT : ∀ k, aSeed k ≤ Tn k),
          (∀ k, (aSeed k : ℝ) = (Tn k : ℝ) - 1 ^ (2 : ℕ)) → (∀ k, 1 ≤ (aSeed k : ℝ)) →
          (∀ k, GC.LongTime.hasSmallParabolicCurvature (Kh k) (Tn k) (pT k) 1) →
        ∀ (seedTrace : ∀ k, BackwardPointTrace (Kh k) ((Kh k).activeStage (aSeed k))
            ((Kh k).activeStage (Tn k)) ((Kh k).activeStage_mono (haT k)) (pT k))
          (σ : ∀ k, Icc (0 : ℝ) (Kh k).horizon) (y : ∀ k, ((Kh k).stageAt (σ k)).Carrier)
          (R : ℕ → ℝ) (hsT : ∀ k, σ k ≤ Tn k) (has : ∀ k, aSeed k ≤ σ k) (L : ℕ → ℝ),
          (∀ k, R k =
            metricScalarAt ((Kh k).stageMetric ((Kh k).activeStage (σ k)) (σ k)) (y k)) →
          (∀ k, 0 < R k) → (∀ k : ℕ, (k : ℝ) + 1 ≤ R k) →
          Tendsto L atTop atTop →
          (∀ k, ¬ (Kh k).HasSpatialCanonicalTimeControl ε C1 C2 Ctime (σ k) (y k)) →
