/-- **choice（`_DLW`，PROVED）**：`∀ T r > 0, ∃ K ≥ 0, B T r K` ⇒ `∃ Ktr ≥ 0` 函数形。 -/
theorem exists_fun_of_forall_exists_DLW {B : ℝ → ℝ → ℝ → Prop}
    (h : ∀ T r : ℝ, 0 < T → 0 < r → ∃ K : ℝ, 0 ≤ K ∧ B T r K) :
    ∃ Ktr : ℝ → ℝ → ℝ, (∀ r T, 0 ≤ Ktr r T) ∧ ∀ T r : ℝ, 0 < T → 0 < r → B T r (Ktr r T) := by
  classical
  refine ⟨fun r T => if h' : 0 < T ∧ 0 < r then (h T r h'.1 h'.2).choose else 0, ?_, ?_⟩
  · intro r T
    dsimp only
    split_ifs with h'
    · exact (h T r h'.1 h'.2).choose_spec.1
    · exact le_rfl
  · intro T r hT hr
    dsimp only
    split_ifs with h'
    · exact (h T r h'.1 h'.2).choose_spec.2
    · exact absurd (And.intro hT hr) h'

/-- **hTR → hTR′（`_DLW`，PROVED）**：槽前缀闭合的 DEPTH4E2 合同形 `hTRc` ⇒ DL2 槽 `hTR′`。 -/
theorem hTR_slot_of_contract_DLW (P : OrientedThreeStage.{u}) (g : P.Metric)
    (εP6 : ClosedBirthConstants → ClosedBirthConstants → ℝ) :
    (
      ∀ {pB : CutoffParameters} {Γ Γf : ClosedBirthConstants}, FineOf_C11G2.{u} Γf Γ →
      Γ.epsilon ≤ εStrong_C12X.{u} → Γ.epsilon ≤ epsW_CXOU2.{u} →
      ∀ (Cdist : ℝ≥0) (εReserve : ℝ)
