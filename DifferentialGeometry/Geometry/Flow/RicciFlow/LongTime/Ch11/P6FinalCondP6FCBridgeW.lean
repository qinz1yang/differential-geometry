/-- **K 帧 Hamilton–Ivey pinching，年龄 `0 + τ`（`_P6FC`）**：全 records + 时刻 0 HI（`a₀ > 0`）⇒ 每个时刻
`τ` 的 stage 度量落在年龄 `0 + τ` 的 HI 区域（`hpin_rescale_P6X3` 的不重标度版：`a₀ + τ` 区域 ⊂ `τ` 区域，
`τ = 0` 用 `inFixedHamiltonIveyRegion_zero_P6X3`）。供 HDISTW2 的单一 `a₀ := 0` 形 `hpin`。 -/
theorem ObservedHistory.hpin_of_HI_P6FC (H : ObservedHistory.{u}) {pF : CutoffParameters}
    (recordsF : ∀ i, GeometricCutoffRecord H i pF) {a₀ : ℝ} (ha₀ : 0 < a₀)
    (hHI : ∀ x, InFixedHamiltonIveyRegion (H.initialMetric 0) a₀ x ∧
      -3 / a₀ ≤ metricScalarAt (H.initialMetric 0) x)
    (τ : Icc (0 : ℝ) H.horizon) (x : (H.stageAt τ).Carrier) :
    InFixedHamiltonIveyRegion (H.stageMetric (H.activeStage τ) τ) (0 + τ) x := by
  rcases eq_or_lt_of_le τ.2.1 with h0 | hpos
  · rw [show (0 : ℝ) + (τ : ℝ) = 0 by rw [← h0, add_zero]]
    exact inFixedHamiltonIveyRegion_zero_P6X3 _ x
  · have hhistory := H.fixedHamiltonIveyRegion_and_scalar_lower recordsF ha₀
      (fun x => (hHI x).1) (fun x => (hHI x).2)
    have hI := (hhistory.1 (H.activeStage τ) τ (H.activeStage_mem τ) x).1
    rw [zero_add]
    rw [inFixedHamiltonIveyRegion_iff_mem_fixedHamiltonIveyRegion] at hI ⊢
    exact fixedHamiltonIveyRegion_antitoneOn (show (τ : ℝ) ∈ Ioi 0 from hpos)
      (show a₀ + τ ∈ Ioi 0 by
        change 0 < a₀ + τ
        linarith)
      (by linarith) hI

/-- **final 桥：(TR₀) `hdistW` ⇐ HDISTW2 + `hscalW_final`（`_P6FC`，PROVISIONAL）**：`hgapJF` 前缀数据
（`r := 1` 的 seed：`hsm`、`hclock`；`n + 1 ≤ R` ⇒ `R·1² → ∞`；`hwin`；final 类 `time last < σ < horizon`）+
K 帧 records / HI（`a₀ n > 0`）⇒ `hdistW_of_firstExit_final_P6DW2` 的全部前提（`hpin` 由
`hpin_of_HI_P6FC`，`a₀ := 0`；`hσfin / hσlt` 由 final 类）；唯一残余 = `hscalW_final_P6M6`（具名 binder）。
结论 = `hcloseF_plus_kappaOnly_cond_P6FC` 的 `hdistW` binder 逐字（= DW2 结论）。 -/
theorem ObservedHistory.hdistW_final_of_scalW_P6FC (Kh : ℕ → ObservedHistory.{u})
    (Tn aSeed σ : ∀ n, Icc (0 : ℝ) (Kh n).horizon)
    (haT : ∀ n, aSeed n ≤ Tn n) (hsT : ∀ n, σ n ≤ Tn n) (has : ∀ n, aSeed n ≤ σ n)
    (pT : ∀ n, ((Kh n).stageAt (Tn n)).Carrier)
    (seedTrace : ∀ n, BackwardPointTrace (Kh n) ((Kh n).activeStage (aSeed n))
      ((Kh n).activeStage (Tn n)) ((Kh n).activeStage_mono (haT n)) (pT n))
    (y : ∀ n, ((Kh n).stageAt (σ n)).Carrier) (R L : ℕ → ℝ) (hR : ∀ n, 0 < R n)
    (hL : Tendsto L atTop atTop)
    (hsm : ∀ n, GC.LongTime.hasSmallParabolicCurvature (Kh n) (Tn n) (pT n) 1)
    (hclock : ∀ n, (aSeed n : ℝ) = (Tn n : ℝ) - 1 ^ 2)
    (hRr : ∀ n : ℕ, (n : ℝ) + 1 ≤ R n)
    (hwin : ∀ T : ℝ, 0 < T → ∀ᶠ n in atTop, (aSeed n : ℝ) ≤ σ n - T / R n)
    {pF : ℕ → CutoffParameters} (recordsF : ∀ n i, GeometricCutoffRecord (Kh n) i (pF n))
    {a₀ : ℕ → ℝ} (ha₀ : ∀ n, 0 < a₀ n)
    (hHI : ∀ n x, InFixedHamiltonIveyRegion ((Kh n).initialMetric 0) (a₀ n) x ∧
      -3 / a₀ n ≤ metricScalarAt ((Kh n).initialMetric 0) x)
    (hfin : ∀ n, (Kh n).time (Fin.last (Kh n).eventCount) < (σ n : ℝ) ∧
      (σ n : ℝ) < (Kh n).horizon)
    (hscalW : ObservedHistory.hscalW_final_P6M6 Kh Tn aSeed σ haT hsT has pT seedTrace y R L) :
    ∀ D T : ℝ, 0 < D → 0 < T → ∀ᶠ n in atTop,
      ∀ x ∈ riemannianBallOf ((Kh n).stageMetric ((Kh n).activeStage (σ n)) (σ n)) (y n)
          (D / Real.sqrt (R n)),
      ∀ (v : Icc (0 : ℝ) (Kh n).horizon) (hav : aSeed n ≤ v) (hvs : v ≤ σ n),
        (σ n : ℝ) - T / R n ≤ v →
        (Kh n).activeStage v = (Kh n).activeStage (σ n) →
      ∀ tr : BackwardPointTrace (Kh n) ((Kh n).activeStage v) ((Kh n).activeStage (σ n))
          ((Kh n).activeStage_mono hvs) x,
        riemannianEDistOf ((Kh n).stageMetric ((Kh n).activeStage v) v)
            ((seedTrace n).point ((Kh n).activeStage v) ((Kh n).activeStage_mono hav)
              ((Kh n).activeStage_mono (hvs.trans (hsT n))))
            (tr.point ((Kh n).activeStage v) le_rfl ((Kh n).activeStage_mono hvs)) ≤
          riemannianEDistOf ((Kh n).stageMetric ((Kh n).activeStage (σ n)) (σ n))
              ((seedTrace n).point ((Kh n).activeStage (σ n)) ((Kh n).activeStage_mono (has n))
                ((Kh n).activeStage_mono (hsT n))) (y n) +
            ENNReal.ofReal (L n / Real.sqrt (R n)) := by
  have hRr' : Tendsto (fun n => R n * 1 ^ 2) atTop atTop := by
    refine tendsto_atTop_mono (fun n => ?_) tendsto_natCast_atTop_atTop
    rw [one_pow, mul_one]
    linarith [hRr n]
  exact ObservedHistory.hdistW_of_firstExit_final_P6DW2 Kh Tn aSeed σ haT hsT has pT seedTrace y R L
    hR (fun _ => 1) hL hsm hclock hRr' hwin le_rfl
    (fun n τ' x => (Kh n).hpin_of_HI_P6FC (recordsF n) (ha₀ n) (hHI n) τ' x)
    (fun n => (Kh n).activeStage_eq_last_of_time_last_le (σ n) (hfin n).1.le) (fun n => (hfin n).2)
    hscalW

