/-- **kernel δ₀ 收缩（`_V11`）**：`d C n := min (δ₀ C n) (min (1/2) (√(Cb C n /
2)))`（`kernelDelta_shrink_P6HA`，Λ := 1）。 -/
theorem kernelDelta_shrink_all_V11 {Cb δ₀ : ℝ≥0 → ℕ → ℝ}
    (hCb : ∀ (C : ℝ≥0) (n : ℕ), 0 < Cb C n ∧ Cb C n ≤ 1 / ((n : ℝ) + 1) ^ 2)
    (hδ₀ : ∀ (C : ℝ≥0) (n : ℕ), 0 < δ₀ C n ∧ δ₀ C n ≤ 1 / ((n : ℝ) + 1)) :
    ∃ d : ℝ≥0 → ℕ → ℝ, (∀ (C : ℝ≥0) (n : ℕ), 0 < d C n ∧ d C n ≤ 1 / ((n : ℝ) + 1)) ∧
      (∀ C n, d C n ≤ δ₀ C n) ∧ (∀ (C : ℝ≥0) (n : ℕ), 2 * d C n ^ 2 ≤ Cb C n) := by
  refine ⟨fun C n => min (δ₀ C n) (min (1 / (2 * 1)) (Real.sqrt (Cb C n / 2))), ?_, ?_, ?_⟩
  · intro C n
    have h := kernelDelta_shrink_P6HA one_pos (fun n => (hδ₀ C n).1) (fun n => (hCb C n).1) n
    exact ⟨h.1, h.2.1.trans (hδ₀ C n).2⟩
  · intro C n
    exact (kernelDelta_shrink_P6HA one_pos (fun n => (hδ₀ C n).1) (fun n => (hCb C n).1) n).2.1
  · intro C n
    exact (kernelDelta_shrink_P6HA one_pos (fun n => (hδ₀ C n).1) (fun n => (hCb C n).1) n).2.2.2

