    (q : CutoffParameters) (ε C1 C2 : ℝ) (Ctime : ℝ≥0) (T₀ Qt : ℕ → ℝ) (a₀ : ℝ) : Prop :=
  (∀ records : GC.LongTime.Ch11.CutoffRecords_C11S F q,
