/-- **合同 `CapBirthBudget_P6J7`**（J7 cap-birth 预算的 `Qs` 半边；PROVISIONAL）：在 records witness `recordsK`
（事件时间 `≥ thr n` 的 cutoff records）上 `Qs n ≤ Cb n * scale`。hOpen8 中的实例是
`thr n := max (T₀ n) (c n * (σ n - L n / R n))`、`Qs n := qcanSup_P6WR S (Ho n).horizon`、
`Cb n := Cb Ctime₀ n`。

**owner = records supplier（KNOM / `diagonalPack_nom_CXKN` 线）。** 供给它需要的精确前提：KNOM 的 `Q` 档
`Q n := Qs n` 必须带**依赖 `ind` 的 `Tmin`**（因为 `Qs n` 经 horizon 依赖 `ind n`），而冻结的 `Tmin` / `T₀`
与 `ind` 无关（`lateThrJ8_P6WR2`）。可选的修复：(i) 改量词序，让 `T₀` 在 `ind` 之后（冻结形状改动，需要 lead 裁定）；
(ii) 一个对 `ind` 一致的上界 `qcanSup_P6WR S (F.tower.history k).horizon ≤ Qbar n`（一般不成立）；
(iii) chain / surgery-parameter 相容性：surgery 尺度按 `qcanSup` 选，使 `Qs ≤ Cb·scale` 直接由构造给出。
J6 推不出它：`Cb ≤ 1/(n+1)²` 只有上界，见 `exists_counterexample_J6_J7b_P6J7`、
`cbLower_contract_vacuous_P6J7`。 -/
def CapBirthBudget_P6J7 (Ho : ℕ → RetainedCoreHistory.{u}) (thr : ℕ → ℝ)
    (p : ℕ → CutoffParameters)
    (recordsK : ∀ n (i : Fin (Ho n).eventCount), thr n ≤ (Ho n).time i.succ →
      GeometricCutoffRecord (Ho n).toHistory i (p n))
    (Qs Cb : ℕ → ℝ) : Prop :=
  ∀ n i hi b, Qs n ≤ Cb n * ((recordsK n i hi).static b).neck.scale

/-- **J7 producer（PROVISIONAL[合同 `CapBirthBudget_P6J7`]）**：J7b（KNOM 的 `Q = 0` 档）∧ 合同 ⇒ J7 逐字形
`max (Qs n) 1 ≤ Cb n * scale`，在**同一** `recordsK` 上。 -/
theorem hbirth_of_records_P6J7 {Ho : ℕ → RetainedCoreHistory.{u}} {thr : ℕ → ℝ}
    {p : ℕ → CutoffParameters}
    {recordsK : ∀ n (i : Fin (Ho n).eventCount), thr n ≤ (Ho n).time i.succ →
      GeometricCutoffRecord (Ho n).toHistory i (p n)}
    {Qs Cb : ℕ → ℝ} (hbud : CapBirthBudget_P6J7 Ho thr p recordsK Qs Cb)
    (hJ7b : ∀ n i hi b, max (0 : ℝ) 1 ≤ Cb n * ((recordsK n i hi).static b).neck.scale) :
    ∀ n i hi b, max (Qs n) 1 ≤ Cb n * ((recordsK n i hi).static b).neck.scale :=
  fun n i hi b => max_le (hbud n i hi b) ((le_max_right (0 : ℝ) 1).trans (hJ7b n i hi b))

/-- **合同的必要性（PROVED）**：J7 ⇒ 合同（同一 `recordsK`）。配合 `hbirth_of_records_P6J7`：在 J7b 下合同 ⟺ J7，
所以 `CapBirthBudget_P6J7` 是最小的新前提。 -/
theorem capBirthBudget_of_hbirth_P6J7 {Ho : ℕ → RetainedCoreHistory.{u}} {thr : ℕ → ℝ}
    {p : ℕ → CutoffParameters}
    {recordsK : ∀ n (i : Fin (Ho n).eventCount), thr n ≤ (Ho n).time i.succ →
      GeometricCutoffRecord (Ho n).toHistory i (p n)}
    {Qs Cb : ℕ → ℝ}
    (hJ7 : ∀ n i hi b, max (Qs n) 1 ≤ Cb n * ((recordsK n i hi).static b).neck.scale) :
    CapBirthBudget_P6J7 Ho thr p recordsK Qs Cb :=
  fun n i hi b => (le_max_left (Qs n) 1).trans (hJ7 n i hi b)

/-- **time-last 单向下传（PROVED；R-C11-16 Q3）**：在**同一** `recordsK` 上，horizon 阈值形的 J7 ⇒
time-last 阈值形的 J7（`qcanSup(time last) ≤ qcanSup(horizon)`）。只能这个方向，不能用来生产 horizon 形。 -/
theorem hbirth_timeLast_of_horizon_P6J7 {pBase : CutoffParameters}
    {C : GC.GeneralFlow.ClosedBirthConstants} {P : OrientedThreeStage.{u}} {g : P.Metric}
    (S : GC.GeneralFlow.PreparedSpatialChain pBase C P g)
    {Ho : ℕ → RetainedCoreHistory.{u}} {thr : ℕ → ℝ} {p : ℕ → CutoffParameters}
    {recordsK : ∀ n (i : Fin (Ho n).eventCount), thr n ≤ (Ho n).time i.succ →
      GeometricCutoffRecord (Ho n).toHistory i (p n)}
    {Cb : ℕ → ℝ}
    (hJ7 : ∀ n i hi b, max (GC.LongTime.Ch11.qcanSup_P6WR S (Ho n).horizon) 1 ≤
      Cb n * ((recordsK n i hi).static b).neck.scale) :
    ∀ n i hi b,
      max (GC.LongTime.Ch11.qcanSup_P6WR S ((Ho n).time (Fin.last (Ho n).eventCount))) 1 ≤
        Cb n * ((recordsK n i hi).static b).neck.scale :=
  fun n i hi b =>
    (max_le_max (GC.LongTime.Ch11.qcanSup_mono_P6WR S (Ho n).time_le_horizon) le_rfl).trans
      (hJ7 n i hi b)

/-- 合同版的 time-last 单向下传（PROVED，同一 `recordsK`）。 -/
theorem capBirthBudget_timeLast_of_horizon_P6J7 {pBase : CutoffParameters}
    {C : GC.GeneralFlow.ClosedBirthConstants} {P : OrientedThreeStage.{u}} {g : P.Metric}
    (S : GC.GeneralFlow.PreparedSpatialChain pBase C P g)
    {Ho : ℕ → RetainedCoreHistory.{u}} {thr : ℕ → ℝ} {p : ℕ → CutoffParameters}
    {recordsK : ∀ n (i : Fin (Ho n).eventCount), thr n ≤ (Ho n).time i.succ →
      GeometricCutoffRecord (Ho n).toHistory i (p n)}
    {Cb : ℕ → ℝ}
    (hbud : CapBirthBudget_P6J7 Ho thr p recordsK
      (fun n => GC.LongTime.Ch11.qcanSup_P6WR S (Ho n).horizon) Cb) :
    CapBirthBudget_P6J7 Ho thr p recordsK
      (fun n => GC.LongTime.Ch11.qcanSup_P6WR S ((Ho n).time (Fin.last (Ho n).eventCount))) Cb :=
  fun n i hi b =>
    (GC.LongTime.Ch11.qcanSup_mono_P6WR S (Ho n).time_le_horizon).trans (hbud n i hi b)

/-- 纯实数核：`m ≥ 2` 时，`Cb = 1/m²`、`c = 1`、`Qs = m²`、`scale = m³` 满足 J6 ∧ J7b ∧
`Qs ≤ m·scale`，但 J7 不成立。 -/
theorem counterexample_core_P6J7 (m : ℝ) (hm2 : 2 ≤ m) :
    ∃ Cb c Qs s : ℝ, 0 < Cb ∧ Cb ≤ 1 / m ^ 2 ∧ 0 < c ∧
      m * max (m / c) Qs ≤ s ∧ max (0 : ℝ) 1 ≤ Cb * s ∧ Qs ≤ m * s ∧
      ¬ max Qs 1 ≤ Cb * s := by
  have hm0 : 0 < m := by linarith
  have hm0' : m ≠ 0 := hm0.ne'
  have he : 1 / m ^ 2 * m ^ 3 = m := by
    field_simp
  have hmm : m ≤ m ^ 2 := by nlinarith
  refine ⟨1 / m ^ 2, 1, m ^ 2, m ^ 3, one_div_pos.mpr (pow_pos hm0 2), le_rfl, one_pos, ?_, ?_,
    ?_, ?_⟩
  · rw [div_one, max_eq_right hmm]
    exact le_of_eq (by ring)
  · rw [he]
    exact max_le (by linarith) (by linarith)
  · have h4 : m * m ^ 3 = m ^ 2 * m ^ 2 := by ring
    rw [h4]
    exact le_mul_of_one_le_right (by positivity) (by nlinarith)
  · rw [he]
    intro h
    have h' : m ^ 2 ≤ m := (le_max_left (m ^ 2) 1).trans h
    nlinarith

/-- **证书 1（PROVED）：J6 ∧ J7b ⇏ J7。** 对每个 `n ≥ 1`，存在满足 `hCb`（取等 `Cb = 1/(n+1)²`）、`c > 0`、
J6 `(n+1)·max((n+1)/c, Qs) ≤ scale`、J7b `max 0 1 ≤ Cb·scale`、简报候选 `Qs ≤ (n+1)·scale` 的实数，
但 J7 `max Qs 1 ≤ Cb·scale` 不成立。 -/
theorem exists_counterexample_J6_J7b_P6J7 (n : ℕ) (hn : 1 ≤ n) :
    ∃ Cb c Qs s : ℝ, 0 < Cb ∧ Cb ≤ 1 / ((n : ℝ) + 1) ^ 2 ∧ 0 < c ∧
      ((n : ℝ) + 1) * max (((n : ℝ) + 1) / c) Qs ≤ s ∧ max (0 : ℝ) 1 ≤ Cb * s ∧
      Qs ≤ ((n : ℝ) + 1) * s ∧ ¬ max Qs 1 ≤ Cb * s := by
  have h1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  exact counterexample_core_P6J7 ((n : ℝ) + 1) (by linarith)

/-- **证书 2（PROVED）：候选合同 `1/(n+1) ≤ Cb` 与 `hCb` 不相容（`n ≥ 1` 时 vacuous）。** -/
theorem cbLower_contract_vacuous_P6J7 (n : ℕ) (Cb : ℝ) (hCb : Cb ≤ 1 / ((n : ℝ) + 1) ^ 2)
    (hlow : 1 / ((n : ℝ) + 1) ≤ Cb) : n = 0 := by
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hpos : (0 : ℝ) < (n : ℝ) + 1 := by linarith
  have h := (one_div_le_one_div hpos (by positivity)).mp (hlow.trans hCb)
  have hle : (n : ℝ) ≤ 0 := by nlinarith
  exact Nat.eq_zero_of_le_zero (by exact_mod_cast hle)

/-- consumer（G1）：J7b ∧ 合同 ⇒ J7，再经 time-last 单向下传，全部在同一 `recordsK` 上。 -/
example {pBase : CutoffParameters} {C : GC.GeneralFlow.ClosedBirthConstants}
    {P : OrientedThreeStage.{u}} {g : P.Metric}
    (S : GC.GeneralFlow.PreparedSpatialChain pBase C P g)
    {Ho : ℕ → RetainedCoreHistory.{u}} {thr : ℕ → ℝ} {p : ℕ → CutoffParameters}
    {recordsK : ∀ n (i : Fin (Ho n).eventCount), thr n ≤ (Ho n).time i.succ →
      GeometricCutoffRecord (Ho n).toHistory i (p n)}
    {Cb : ℕ → ℝ}
    (hbud : CapBirthBudget_P6J7 Ho thr p recordsK
      (fun n => GC.LongTime.Ch11.qcanSup_P6WR S (Ho n).horizon) Cb)
    (hJ7b : ∀ n i hi b, max (0 : ℝ) 1 ≤ Cb n * ((recordsK n i hi).static b).neck.scale) :
    ∀ n i hi b,
      max (GC.LongTime.Ch11.qcanSup_P6WR S ((Ho n).time (Fin.last (Ho n).eventCount))) 1 ≤
        Cb n * ((recordsK n i hi).static b).neck.scale :=
  hbirth_timeLast_of_horizon_P6J7 S (hbirth_of_records_P6J7 hbud hJ7b)

/-- consumer（G1 证书）：`n = 1` 时 `hCb` 上界与候选合同 `1/(n+1) ≤ Cb` 不相容（该合同 vacuous）。 -/
example : ¬ ∃ Cb : ℝ, Cb ≤ 1 / (((1 : ℕ) : ℝ) + 1) ^ 2 ∧ 1 / (((1 : ℕ) : ℝ) + 1) ≤ Cb := by
  rintro ⟨Cb, h1, h2⟩
  exact absurd (cbLower_contract_vacuous_P6J7 1 Cb h1 h2) one_ne_zero

