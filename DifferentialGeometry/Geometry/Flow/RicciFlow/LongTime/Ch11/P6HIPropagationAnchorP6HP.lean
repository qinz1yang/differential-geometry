theorem hpin_of_initial_fixed_P6HP {K : ℕ → RetainedCoreHistory.{u}} {pFK : ℕ → CutoffParameters}
    (recordsFK : ∀ n i, GeometricCutoffRecord (K n).toHistory i (pFK n)) {a₀ : ℝ} (ha₀ : 0 < a₀)
    (hHI0 : ∀ n x, InFixedHamiltonIveyRegion ((K n).initialMetric 0) a₀ x ∧
      -3 / a₀ ≤ metricScalarAt ((K n).initialMetric 0) x)
    (Kh : ℕ → ObservedHistory.{u}) (hKh : Kh = fun n => (K n).toHistory) :
    ∀ n (τ' : Icc (0 : ℝ) (Kh n).horizon) (x : ((Kh n).stageAt τ').Carrier),
      InFixedHamiltonIveyRegion ((Kh n).stageMetric ((Kh n).activeStage τ') τ') (0 + τ') x := by
  subst hKh
  exact hpin_of_hpinX_P6HP _ (fun _ => a₀) (fun _ => ha₀.le)
    (fun n => ObservedHistory.hiActive_of_records_P6HP (K n).toHistory (recordsFK n) ha₀ (hHI0 n))

/-- **AN4 final 链 `hpin`（`a₁ := 0`；`_P6HP`，PROVED）**⇐ prefix last 的全事件 records（= K 的全部事件，
经 `fixedHamiltonIveyRegion_and_scalar_lower_of_preservation` 作 K 的 `hcurvature / hpreserve`，defeq）+
prefix 初始 HI（逐 `n` 的 `a₀ n > 0`）。 -/
theorem hpin_of_prefixLast_P6HP {K : ℕ → RetainedCoreHistory.{u}} {pF : ℕ → CutoffParameters}
    (recordsF : ∀ n i,
      GeometricCutoffRecord ((K n).prefixAt (Fin.last (K n).eventCount)).toHistory i (pF n))
    {a₀ : ℕ → ℝ} (ha₀ : ∀ n, 0 < a₀ n)
    (hHI : ∀ n x,
      InFixedHamiltonIveyRegion (((K n).prefixAt (Fin.last (K n).eventCount)).initialMetric 0)
        (a₀ n) x ∧
      -3 / a₀ n ≤ metricScalarAt (((K n).prefixAt (Fin.last (K n).eventCount)).initialMetric 0) x)
    (Kh : ℕ → ObservedHistory.{u}) (hKh : Kh = fun n => (K n).toHistory) :
    ∀ n (τ' : Icc (0 : ℝ) (Kh n).horizon) (x : ((Kh n).stageAt τ').Carrier),
      InFixedHamiltonIveyRegion ((Kh n).stageMetric ((Kh n).activeStage τ') τ') (0 + τ') x := by
  subst hKh
  refine hpin_of_hpinX_P6HP _ a₀ (fun n => (ha₀ n).le) (fun n τ x => ?_)
  exact (((K n).toHistory.fixedHamiltonIveyRegion_and_scalar_lower_of_preservation
    (fun i => (recordsF n i).curvature_preserving) (fun i => (recordsF n i).scalar_preserving)
    (ha₀ n) (fun x => (hHI n x).1) (fun x => (hHI n x).2)).1 _ τ
    ((K n).toHistory.activeStage_mem τ) x).1

