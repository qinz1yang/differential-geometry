/-- 标量 `stageMetric m` ↔ final slab（`m = last`，`time last < horizon`）。 -/
theorem scalar_of_final_P6HR (K : RetainedCoreHistory.{u})
    (hfin : K.time (Fin.last K.eventCount) < K.horizon)
    {m : Fin (K.eventCount + 1)} (hm : Fin.last K.eventCount = m) (v : ℝ)
    (z : (K.stage (Fin.last K.eventCount)).Carrier) (x : (K.stage m).Carrier) (hx : HEq x z) :
    metricScalarAt (K.toHistory.stageMetric m v) x =
      ((K.finalSlab hfin).restrictIncoming le_rfl hfin le_rfl).flow.scalar v z := by
  subst hm
  obtain rfl := eq_of_heq hx
  rw [ObservedHistory.stageMetric_last_of_lt (H := K.toHistory) (h := hfin) v]
  rfl

/-- **final 内部类的位置识别（`_P6HR`）**：子列整条落在 final slab 内部时，给出 final 孪生主形的
`yG hyG hRn`（`t := σ`）。 -/
theorem finalInterior_data_P6HR {K : ℕ → RetainedCoreHistory.{u}}
    (σ : ∀ n, Icc (0 : ℝ) (K n).toHistory.horizon)
    (y : ∀ n, ((K n).toHistory.stageAt (σ n)).Carrier)
    (hpos : ∀ n, (K n).toHistory.time (Fin.last (K n).toHistory.eventCount) < (σ n : ℝ) ∧
      (σ n : ℝ) < (K n).toHistory.horizon) :
    ∃ yG : ∀ n, ((K n).stage (Fin.last (K n).eventCount)).Carrier,
      (∀ n, HEq (y n) (yG n)) ∧
      ∀ n, metricScalarAt ((K n).toHistory.stageMetric ((K n).toHistory.activeStage (σ n))
          (σ n)) (y n) =
        (((K n).finalSlab ((hpos n).1.trans (hpos n).2)).restrictIncoming le_rfl
          ((hpos n).1.trans (hpos n).2) le_rfl).flow.scalar (σ n) (yG n) := by
  have hact : ∀ n, (K n).toHistory.activeStage (σ n) = Fin.last (K n).eventCount := fun n =>
    (K n).toHistory.activeStage_eq_last_of_time_last_le (σ n) (hpos n).1.le
  refine ⟨fun n => cast (congrArg (fun m => ((K n).stage m).Carrier) (hact n)) (y n),
    fun n => (cast_heq _ _).symm, fun n => ?_⟩
  exact (K n).scalar_of_final_P6HR ((hpos n).1.trans (hpos n).2) (hact n).symm (σ n) _ (y n)
    (cast_heq _ _).symm

end RetainedCoreHistory

