import DifferentialGeometry.Geometry.Flow.RicciFlow.Perelman.KappaSolutions.CylinderDeckAlgebra
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import Mathlib.Analysis.Normed.Affine.Isometry
import Mathlib.GroupTheory.Archimedean

/-!
# Cocompact deck groups of `S² × ℝ`

Chapter 7, packet P8, tier 1. A product isometry of `S² × ℝ` is a pair `(A, b)` of an orthogonal
map `A` of `ℝ³` and an affine isometry `b` of `ℝ`. A subgroup `G` of such pairs acting freely,
orientation-preservingly (`det A` equals the sign of the linear part of `b`), discretely (finitely
many elements move the line coordinate `0` into any bounded interval) and with infinitely many
elements is classified in `cylinderCocompactGroup_classification`: either `G` is infinite cyclic,
generated by `(A, s ↦ s + c)` with `det A = 1` and `c ≠ 0`, or `G` is infinite dihedral,
generated by the two free involutions `(-1, s ↦ 2 c₁ - s)` and `(-1, s ↦ 2 c₂ - s)` with
`c₁ ≠ c₂`. The quotients are `S² × S¹` and `RP³ # RP³`.
-/

set_option autoImplicit false

noncomputable section

namespace GC.Geometry.SphericalProduct

open DifferentialGeometry.PDE.RicciFlow.Perelman.KappaSolutions

local notation "E3" => EuclideanSpace ℝ (Fin 3)
local notation "S2" => Metric.sphere (0 : E3) 1

abbrev LineIsometry := ℝ ≃ᵃⁱ[ℝ] ℝ

abbrev CylinderIsometry := (E3 ≃ₗᵢ[ℝ] E3) × LineIsometry

def lineSign (b : LineIsometry) : ℝ := b.linearIsometryEquiv 1

theorem line_apply (b : LineIsometry) (s : ℝ) : b s = lineSign b * s + b 0 := by
  have hv := b.map_vadd (0 : ℝ) s
  change b (s + 0) = b.linearIsometryEquiv s + b 0 at hv
  rw [add_zero] at hv
  have hlin : b.linearIsometryEquiv s = s * b.linearIsometryEquiv 1 := by
    have h := LinearIsometryEquiv.map_smul (e := b.linearIsometryEquiv) s (1 : ℝ)
    simpa only [smul_eq_mul, mul_one] using h
  rw [hv, hlin, mul_comm s]
  rfl

theorem lineSign_eq (b : LineIsometry) : lineSign b = b 1 - b 0 := by
  rw [line_apply b 1]
  ring

theorem lineSign_eq_one_or_neg_one (b : LineIsometry) : lineSign b = 1 ∨ lineSign b = -1 := by
  have h := b.linearIsometryEquiv.norm_map (1 : ℝ)
  rw [norm_one, Real.norm_eq_abs] at h
  exact (abs_eq zero_le_one).mp h

theorem lineSign_mul (b b' : LineIsometry) : lineSign (b * b') = lineSign b * lineSign b' := by
  rw [lineSign_eq (b * b'), AffineIsometryEquiv.coe_mul, Function.comp_apply,
    Function.comp_apply, line_apply b (b' 1), line_apply b (b' 0), line_apply b' 1,
    line_apply b' 0]
  ring

theorem lineSign_one : lineSign 1 = 1 := by
  rw [lineSign_eq]
  simp

theorem lineSign_inv (b : LineIsometry) : lineSign b⁻¹ = lineSign b := by
  have h := lineSign_mul b⁻¹ b
  rw [inv_mul_cancel, lineSign_one] at h
  have hsq : lineSign b * lineSign b = 1 := by
    rcases lineSign_eq_one_or_neg_one b with hb | hb <;> simp [hb]
  calc lineSign b⁻¹ = lineSign b⁻¹ * (lineSign b * lineSign b) := by rw [hsq, mul_one]
    _ = (lineSign b⁻¹ * lineSign b) * lineSign b := by ring
    _ = lineSign b := by rw [← h, one_mul]

theorem line_apply_of_lineSign_one {b : LineIsometry} (hb : lineSign b = 1) (s : ℝ) :
    b s = s + b 0 := by
  rw [line_apply b s, hb, one_mul]

theorem line_apply_of_lineSign_neg {b : LineIsometry} (hb : lineSign b = -1) (s : ℝ) :
    b s = b 0 - s := by
  rw [line_apply b s, hb]
  ring

private theorem det_adjoint_eq (f : E3 →ₗ[ℝ] E3) :
    LinearMap.det (LinearMap.adjoint f) = LinearMap.det f := by
  let b := EuclideanSpace.basisFun (Fin 3) ℝ
  rw [← LinearMap.det_toMatrix b.toBasis, ← LinearMap.det_toMatrix b.toBasis f,
    LinearMap.toMatrix_adjoint b b f, Matrix.conjTranspose_eq_transpose_of_trivial,
    Matrix.det_transpose]

theorem exists_fixed_of_det_eq_one (A : E3 ≃ₗᵢ[ℝ] E3)
    (hA : LinearMap.det (A.toLinearEquiv : E3 →ₗ[ℝ] E3) = 1) :
    ∃ y : S2, A (y : E3) = (y : E3) := by
  set f : E3 →ₗ[ℝ] E3 := (A.toLinearEquiv : E3 →ₗ[ℝ] E3) with hf
  set g : E3 →ₗ[ℝ] E3 := (A.symm.toLinearEquiv : E3 →ₗ[ℝ] E3) with hg
  have hfg : f ∘ₗ g = LinearMap.id := by
    ext v
    simp [f, g]
  have hcomp : f ∘ₗ (LinearMap.id - g) = f - LinearMap.id := by
    rw [LinearMap.comp_sub, hfg, LinearMap.comp_id]
  have hadjg : LinearMap.adjoint g = f := by
    rw [hg, LinearIsometryEquiv.adjoint_toLinearMap_eq_symm, LinearIsometryEquiv.symm_symm]
  have hadj : LinearMap.adjoint (LinearMap.id - g) = (-1 : ℝ) • (f - LinearMap.id) := by
    rw [map_sub, LinearMap.adjoint_id, hadjg, neg_one_smul, neg_sub]
  have h1 : LinearMap.det (f - LinearMap.id) = LinearMap.det (LinearMap.id - g) := by
    rw [← hcomp, LinearMap.det_comp, hA, one_mul]
  have h2 : LinearMap.det (LinearMap.id - g) = -LinearMap.det (f - LinearMap.id) := by
    rw [← det_adjoint_eq, hadj, LinearMap.det_smul, finrank_euclideanSpace_fin]
    norm_num
  have h0 : LinearMap.det (f - LinearMap.id) = 0 := by linarith
  obtain ⟨v, hvker, hv⟩ :=
    (LinearMap.ker (f - LinearMap.id)).ne_bot_iff.mp (LinearMap.det_eq_zero_iff_ker_ne_bot.mp h0)
  have hAv : A v = v := by
    have h := LinearMap.mem_ker.mp hvker
    simp only [LinearMap.sub_apply, LinearMap.id_apply, f] at h
    exact sub_eq_zero.mp h
  have hnorm : ‖(‖v‖⁻¹ : ℝ) • v‖ = 1 := norm_smul_inv_norm hv
  refine ⟨⟨(‖v‖⁻¹ : ℝ) • v, by simpa only [Metric.mem_sphere, dist_zero_right] using hnorm⟩, ?_⟩
  change A ((‖v‖⁻¹ : ℝ) • v) = (‖v‖⁻¹ : ℝ) • v
  rw [map_smul, hAv]

section Classification

variable (G : Subgroup CylinderIsometry)
  (hfree : ∀ γ ∈ G, γ ≠ 1 → ∀ p : S2 × ℝ, (γ.1 (p.1 : E3), γ.2 p.2) ≠ ((p.1 : E3), p.2))
  (horient : ∀ γ ∈ G, LinearMap.det (γ.1.toLinearEquiv : E3 →ₗ[ℝ] E3) = lineSign γ.2)

include hfree horient in
theorem eq_one_of_line_eq_one {γ : CylinderIsometry} (hγ : γ ∈ G) (hline : γ.2 = 1) :
    γ = 1 := by
  by_contra hne
  have hdet := horient γ hγ
  rw [hline, lineSign_one] at hdet
  obtain ⟨y, hy⟩ := exists_fixed_of_det_eq_one γ.1 hdet
  apply hfree γ hγ hne (y, 0)
  refine Prod.ext hy ?_
  change γ.2 0 = 0
  rw [hline, AffineIsometryEquiv.coe_one, id]

include hfree horient in
theorem eq_of_line_eq {γ δ : CylinderIsometry} (hγ : γ ∈ G) (hδ : δ ∈ G) (hline : γ.2 = δ.2) :
    γ = δ := by
  have h := eq_one_of_line_eq_one G hfree horient (G.mul_mem hγ (G.inv_mem hδ))
    (by rw [Prod.snd_mul, Prod.snd_inv, hline, mul_inv_cancel])
  exact mul_inv_eq_one.mp h

include hfree horient in
theorem sphere_eq_neg_of_lineSign_neg {γ : CylinderIsometry} (hγ : γ ∈ G)
    (hsign : lineSign γ.2 = -1) : γ.1 = LinearIsometryEquiv.neg ℝ := by
  have hsq : γ * γ = 1 := by
    apply eq_one_of_line_eq_one G hfree horient (G.mul_mem hγ hγ)
    apply AffineIsometryEquiv.ext
    intro s
    rw [Prod.snd_mul, AffineIsometryEquiv.coe_mul, Function.comp_apply,
      line_apply_of_lineSign_neg hsign, line_apply_of_lineSign_neg hsign s,
      AffineIsometryEquiv.coe_one, id]
    ring
  have hne : γ ≠ 1 := by
    intro h
    rw [h, Prod.snd_one, lineSign_one] at hsign
    norm_num at hsign
  apply cylinderDeck_involution_eq_neg_of_sphere_free γ.1
  · intro v
    have h := congrArg (fun δ : CylinderIsometry => δ.1 v) hsq
    simpa only [Prod.fst_mul, LinearIsometryEquiv.coe_mul, Function.comp_apply, Prod.fst_one,
      LinearIsometryEquiv.coe_one, id] using h
  · intro y hy
    apply hfree γ hγ hne (y, γ.2 0 / 2)
    refine Prod.ext hy ?_
    change γ.2 (γ.2 0 / 2) = γ.2 0 / 2
    rw [line_apply_of_lineSign_neg hsign]
    ring

def translationSubgroup : AddSubgroup ℝ where
  carrier := {c | ∃ γ ∈ G, ∀ s, γ.2 s = s + c}
  zero_mem' := ⟨1, G.one_mem, fun s => by simp⟩
  add_mem' := by
    rintro a b ⟨γ, hγ, ha⟩ ⟨δ, hδ, hb⟩
    refine ⟨γ * δ, G.mul_mem hγ hδ, fun s => ?_⟩
    rw [Prod.snd_mul, AffineIsometryEquiv.coe_mul, Function.comp_apply, hb, ha]
    ring
  neg_mem' := by
    rintro a ⟨γ, hγ, ha⟩
    refine ⟨γ⁻¹, G.inv_mem hγ, fun s => ?_⟩
    rw [Prod.snd_inv, AffineIsometryEquiv.coe_inv, AffineIsometryEquiv.symm_apply_eq, ha]
    ring

theorem mem_translationSubgroup_iff (c : ℝ) :
    c ∈ translationSubgroup G ↔ ∃ γ ∈ G, ∀ s, γ.2 s = s + c := Iff.rfl

theorem line_zpow_apply {b : LineIsometry} {c : ℝ} (hb : ∀ s, b s = s + c) (n : ℤ) (s : ℝ) :
    (b ^ n) s = s + n * c := by
  induction n using Int.induction_on generalizing s with
  | zero => simp
  | succ k ih =>
    rw [zpow_add_one, AffineIsometryEquiv.coe_mul, Function.comp_apply, ih, hb]
    push_cast
    ring
  | pred k ih =>
    rw [zpow_sub_one, AffineIsometryEquiv.coe_mul, Function.comp_apply, ih,
      AffineIsometryEquiv.coe_inv, (AffineIsometryEquiv.symm_apply_eq b).mpr
        (show s = b (s - c) by rw [hb]; ring)]
    push_cast
    ring

variable (hdiscrete : ∀ R : ℝ, {γ : CylinderIsometry | γ ∈ G ∧ |γ.2 0| ≤ R}.Finite)
  (hinfinite : (G : Set CylinderIsometry).Infinite)

include hdiscrete in
theorem translationSubgroup_bounded_finite (R : ℝ) :
    {c : ℝ | c ∈ translationSubgroup G ∧ |c| ≤ R}.Finite := by
  apply ((hdiscrete R).image fun γ : CylinderIsometry => γ.2 0).subset
  rintro c ⟨⟨γ, hγ, hc⟩, hR⟩
  have h0 : γ.2 0 = c := by rw [hc, zero_add]
  exact ⟨γ, ⟨hγ, h0 ▸ hR⟩, h0⟩

include hfree horient hinfinite in
theorem exists_ne_zero_mem_translationSubgroup :
    ∃ c ∈ translationSubgroup G, c ≠ 0 := by
  by_contra hcon
  push Not at hcon
  have hpos : ∀ γ ∈ G, lineSign γ.2 = 1 → γ = 1 := by
    intro γ hγ hsign
    apply eq_one_of_line_eq_one G hfree horient hγ
    have h0 := hcon (γ.2 0) ⟨γ, hγ, line_apply_of_lineSign_one hsign⟩
    apply AffineIsometryEquiv.ext
    intro s
    rw [line_apply_of_lineSign_one hsign, h0, add_zero, AffineIsometryEquiv.coe_one, id]
  have hsub : (G : Set CylinderIsometry) ⊆
      {1} ∪ {γ : CylinderIsometry | γ ∈ G ∧ lineSign γ.2 = -1} := by
    intro γ hγ
    rcases lineSign_eq_one_or_neg_one γ.2 with h | h
    · exact Or.inl (hpos γ hγ h)
    · exact Or.inr ⟨hγ, h⟩
  apply hinfinite
  refine (Set.finite_singleton 1).union (Set.Subsingleton.finite ?_) |>.subset hsub
  rintro γ ⟨hγ, hγs⟩ δ ⟨hδ, hδs⟩
  have h := hpos (γ⁻¹ * δ) (G.mul_mem (G.inv_mem hγ) hδ) (by
    rw [Prod.snd_mul, Prod.snd_inv, lineSign_mul, lineSign_inv, hγs, hδs]
    norm_num)
  exact (inv_mul_eq_one.mp h)

include hfree horient hdiscrete hinfinite in
theorem exists_least_translation :
    ∃ c₀ : ℝ, 0 < c₀ ∧ translationSubgroup G = AddSubgroup.closure {c₀} := by
  obtain ⟨c, hc, hne⟩ := exists_ne_zero_mem_translationSubgroup G hfree horient hinfinite
  have habs : |c| ∈ translationSubgroup G := by
    rcases abs_choice c with h | h <;> rw [h]
    · exact hc
    · exact (translationSubgroup G).neg_mem hc
  let S : Set ℝ := {g | g ∈ translationSubgroup G ∧ 0 < g ∧ g ≤ |c|}
  have hS : S.Finite := by
    apply (translationSubgroup_bounded_finite G hdiscrete |c|).subset
    rintro g ⟨hg, hg0, hgc⟩
    exact ⟨hg, by rw [abs_of_pos hg0]; exact hgc⟩
  obtain ⟨c₀, ⟨hc₀, hc₀pos, hc₀le⟩, hmin⟩ :=
    Set.exists_min_image S id hS ⟨|c|, habs, abs_pos.mpr hne, le_rfl⟩
  refine ⟨c₀, hc₀pos, AddSubgroup.cyclic_of_min ⟨⟨hc₀, hc₀pos⟩, ?_⟩⟩
  rintro g ⟨hg, hgpos⟩
  by_cases hgc : g ≤ |c|
  · exact hmin g ⟨hg, hgpos, hgc⟩
  · exact hc₀le.trans (le_of_not_ge hgc)

include hfree horient in
theorem eq_zpow_of_lineSign_one {c₀ : ℝ}
    (hT : translationSubgroup G = AddSubgroup.closure {c₀})
    {γ₀ : CylinderIsometry} (hγ₀ : γ₀ ∈ G) (hγ₀c : ∀ s, γ₀.2 s = s + c₀)
    {γ : CylinderIsometry} (hγ : γ ∈ G) (hsign : lineSign γ.2 = 1) :
    ∃ n : ℤ, γ = γ₀ ^ n := by
  have hmem : γ.2 0 ∈ translationSubgroup G := ⟨γ, hγ, line_apply_of_lineSign_one hsign⟩
  rw [hT, AddSubgroup.mem_closure_singleton] at hmem
  obtain ⟨n, hn⟩ := hmem
  refine ⟨n, eq_of_line_eq G hfree horient hγ (G.zpow_mem hγ₀ n) ?_⟩
  apply AffineIsometryEquiv.ext
  intro s
  rw [Prod.pow_snd, line_zpow_apply hγ₀c n s, line_apply_of_lineSign_one hsign, ← hn,
    zsmul_eq_mul]

include hfree horient hdiscrete hinfinite in
theorem cylinderCocompactGroup_classification :
    (∃ (A : E3 ≃ₗᵢ[ℝ] E3) (c : ℝ), LinearMap.det (A.toLinearEquiv : E3 →ₗ[ℝ] E3) = 1 ∧
        c ≠ 0 ∧ G = Subgroup.zpowers (A, AffineIsometryEquiv.vaddConst ℝ c)) ∨
      ∃ c₁ c₂ : ℝ, c₁ ≠ c₂ ∧ G = Subgroup.closure
        {(LinearIsometryEquiv.neg ℝ, AffineIsometryEquiv.pointReflection ℝ c₁),
          (LinearIsometryEquiv.neg ℝ, AffineIsometryEquiv.pointReflection ℝ c₂)} := by
  obtain ⟨c₀, hc₀pos, hT⟩ := exists_least_translation G hfree horient hdiscrete hinfinite
  have hc₀mem : c₀ ∈ translationSubgroup G := by
    rw [hT]
    exact AddSubgroup.subset_closure rfl
  obtain ⟨γ₀, hγ₀, hγ₀c⟩ := hc₀mem
  have hγ₀sign : lineSign γ₀.2 = 1 := by
    rw [lineSign_eq, hγ₀c, hγ₀c]
    ring
  have hzpow : ∀ {γ : CylinderIsometry}, γ ∈ G → lineSign γ.2 = 1 → ∃ n : ℤ, γ = γ₀ ^ n :=
    fun hγ hs => eq_zpow_of_lineSign_one G hfree horient hT hγ₀ hγ₀c hγ hs
  have hγ₀line : γ₀.2 = AffineIsometryEquiv.vaddConst ℝ c₀ := by
    apply AffineIsometryEquiv.ext
    intro s
    rw [hγ₀c]
    simp
  by_cases hrefl : ∃ r ∈ G, lineSign r.2 = -1
  · right
    obtain ⟨r, hr, hrsign⟩ := hrefl
    have hr1 := sphere_eq_neg_of_lineSign_neg G hfree horient hr hrsign
    have hrγ₀ : r * γ₀ ∈ G := G.mul_mem hr hγ₀
    have hrγ₀sign : lineSign (r * γ₀).2 = -1 := by
      rw [Prod.snd_mul, lineSign_mul, hrsign, hγ₀sign]
      norm_num
    have hrγ₀1 := sphere_eq_neg_of_lineSign_neg G hfree horient hrγ₀ hrγ₀sign
    have hγ₀one : γ₀.1 = 1 := by
      rw [Prod.fst_mul, hr1] at hrγ₀1
      exact mul_eq_left.mp hrγ₀1
    refine ⟨r.2 0 / 2, r.2 0 / 2 - c₀ / 2, by linarith, ?_⟩
    have hreq : r = (LinearIsometryEquiv.neg ℝ,
        AffineIsometryEquiv.pointReflection ℝ (r.2 0 / 2)) := by
      refine Prod.ext hr1 (AffineIsometryEquiv.ext fun s => ?_)
      rw [line_apply_of_lineSign_neg hrsign, AffineIsometryEquiv.pointReflection_apply]
      simp only [vsub_eq_sub, vadd_eq_add]
      ring
    have hrγ₀eq : r * γ₀ = (LinearIsometryEquiv.neg ℝ,
        AffineIsometryEquiv.pointReflection ℝ (r.2 0 / 2 - c₀ / 2)) := by
      refine Prod.ext hrγ₀1 (AffineIsometryEquiv.ext fun s => ?_)
      rw [Prod.snd_mul, AffineIsometryEquiv.coe_mul, Function.comp_apply, hγ₀c,
        line_apply_of_lineSign_neg hrsign, AffineIsometryEquiv.pointReflection_apply]
      simp only [vsub_eq_sub, vadd_eq_add]
      ring
    rw [← hreq, ← hrγ₀eq]
    apply le_antisymm
    · intro γ hγ
      have hγ₀cl : γ₀ ∈ Subgroup.closure {r, r * γ₀} := by
        have h := (Subgroup.closure {r, r * γ₀}).mul_mem
          ((Subgroup.closure {r, r * γ₀}).inv_mem (Subgroup.subset_closure (Or.inl rfl)))
          (Subgroup.subset_closure (Or.inr rfl))
        rwa [inv_mul_cancel_left] at h
      rcases lineSign_eq_one_or_neg_one γ.2 with hs | hs
      · obtain ⟨n, rfl⟩ := hzpow hγ hs
        exact (Subgroup.closure {r, r * γ₀}).zpow_mem hγ₀cl n
      · obtain ⟨n, hn⟩ := hzpow (G.mul_mem (G.inv_mem hr) hγ) (by
          rw [Prod.snd_mul, Prod.snd_inv, lineSign_mul, lineSign_inv, hrsign, hs]
          norm_num)
        have hγeq : γ = r * γ₀ ^ n := by rw [← hn, mul_inv_cancel_left]
        rw [hγeq]
        exact (Subgroup.closure {r, r * γ₀}).mul_mem (Subgroup.subset_closure (Or.inl rfl))
          ((Subgroup.closure {r, r * γ₀}).zpow_mem hγ₀cl n)
    · rw [Subgroup.closure_le]
      rintro γ (rfl | rfl)
      · exact hr
      · exact hrγ₀
  · left
    push Not at hrefl
    refine ⟨γ₀.1, c₀, ?_, hc₀pos.ne', ?_⟩
    · rw [horient γ₀ hγ₀, hγ₀sign]
    · have hγ₀eq : γ₀ = (γ₀.1, AffineIsometryEquiv.vaddConst ℝ c₀) := Prod.ext rfl hγ₀line
      rw [← hγ₀eq]
      apply le_antisymm
      · intro γ hγ
        have hs : lineSign γ.2 = 1 :=
          (lineSign_eq_one_or_neg_one γ.2).resolve_right (hrefl γ hγ)
        obtain ⟨n, rfl⟩ := hzpow hγ hs
        exact Subgroup.mem_zpowers_iff.mpr ⟨n, rfl⟩
      · exact Subgroup.zpowers_le.mpr hγ₀

end Classification

end GC.Geometry.SphericalProduct
