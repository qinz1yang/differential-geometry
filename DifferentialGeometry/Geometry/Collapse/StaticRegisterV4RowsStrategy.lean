/-! ### Infimum of two threshold records and the relation "below" -/

/-- The infimum of two threshold records of register V4: slotwise minimum of the upper slots,
maximum of the lower slots; `N_b, c_w, I₁`, LPA02's output and the test radius from `U₁`. -/
def ClosedThresholdsV4.inf {D : ClosedEarlyData} (U₁ U₂ : ClosedThresholdsV4 D) :
    ClosedThresholdsV4 D where
  Nb := U₁.Nb
  Nb_nonneg := U₁.Nb_nonneg
  cw := U₁.cw
  cw_nonneg := U₁.cw_nonneg
  lc18 := min U₁.lc18 U₂.lc18
  lc18_pos := lt_min U₁.lc18_pos U₂.lc18_pos
  circleUp := fun st β₃ θs θe θ₂ => min (U₁.circleUp st β₃ θs θe θ₂) (U₂.circleUp st β₃ θs θe θ₂)
  circleUp_pos := fun st β₃ θs θe θ₂ =>
    lt_min (U₁.circleUp_pos st β₃ θs θe θ₂) (U₂.circleUp_pos st β₃ θs θe θ₂)
  β₂Up := fun st ci β₃ => min (U₁.β₂Up st ci β₃) (U₂.β₂Up st ci β₃)
  β₂Up_pos := fun st ci β₃ => lt_min (U₁.β₂Up_pos st ci β₃) (U₂.β₂Up_pos st ci β₃)
  ΔLow := fun st ci β₃ β₂ => max (U₁.ΔLow st ci β₃ β₂) (U₂.ΔLow st ci β₃ β₂)
  errorsUp := fun st ci ex => min (U₁.errorsUp st ci ex) (U₂.errorsUp st ci ex)
  errorsUp_pos := fun st ci ex => lt_min (U₁.errorsUp_pos st ci ex) (U₂.errorsUp_pos st ci ex)
  sectionUp := fun st ci ex co => min (U₁.sectionUp st ci ex co) (U₂.sectionUp st ci ex co)
  sectionUp_pos := fun st ci ex co =>
    lt_min (U₁.sectionUp_pos st ci ex co) (U₂.sectionUp_pos st ci ex co)
  lfr29W := fun st ci ex co bd => min (U₁.lfr29W st ci ex co bd) (U₂.lfr29W st ci ex co bd)
  lfr29W_pos := fun st ci ex co bd =>
    lt_min (U₁.lfr29W_pos st ci ex co bd) (U₂.lfr29W_pos st ci ex co bd)
  endpointUp := fun st ci ex co bd wk =>
    min (U₁.endpointUp st ci ex co bd wk) (U₂.endpointUp st ci ex co bd wk)
  endpointUp_pos := fun st ci ex co bd wk =>
    lt_min (U₁.endpointUp_pos st ci ex co bd wk) (U₂.endpointUp_pos st ci ex co bd wk)
  σcolUp := fun st ci ex co bd wk s =>
    min (U₁.σcolUp st ci ex co bd wk s) (U₂.σcolUp st ci ex co bd wk s)
  σcolUp_pos := fun st ci ex co bd wk s =>
    lt_min (U₁.σcolUp_pos st ci ex co bd wk s) (U₂.σcolUp_pos st ci ex co bd wk s)
  I₁ := U₁.I₁
  I₁_pos := U₁.I₁_pos
  scaleUp := fun st ci ex er => min (U₁.scaleUp st ci ex er) (U₂.scaleUp st ci ex er)
  scaleUp_pos := fun st ci ex er => lt_min (U₁.scaleUp_pos st ci ex er) (U₂.scaleUp_pos st ci ex er)
  wUp := fun st ci ex er Λ => min (U₁.wUp st ci ex er Λ) (U₂.wUp st ci ex er Λ)
  wUp_pos := fun st ci ex er Λ => lt_min (U₁.wUp_pos st ci ex er Λ) (U₂.wUp_pos st ci ex er Λ)
  splitUp := fun st ci ex er sc => min (U₁.splitUp st ci ex er sc) (U₂.splitUp st ci ex er sc)
  splitUp_pos := fun st ci ex er sc =>
    lt_min (U₁.splitUp_pos st ci ex er sc) (U₂.splitUp_pos st ci ex er sc)
  β₁Up := fun st ci ex er sc b => min (U₁.β₁Up st ci ex er sc b) (U₂.β₁Up st ci ex er sc b)
  β₁Up_pos := fun st ci ex er sc b =>
    lt_min (U₁.β₁Up_pos st ci ex er sc b) (U₂.β₁Up_pos st ci ex er sc b)
  T₀Low := fun st ci ex er sc b β₁ =>
    max (U₁.T₀Low st ci ex er sc b β₁) (U₂.T₀Low st ci ex er sc b β₁)
  lpa02V := U₁.lpa02V
  T₀_le_lpa02V := U₁.T₀_le_lpa02V
  LmaxLow := fun st ci ex er sc sp =>
    max (U₁.LmaxLow st ci ex er sc sp) (U₂.LmaxLow st ci ex er sc sp)
  tailLow := fun st ci ex er sc sp Lmax =>
    max (U₁.tailLow st ci ex er sc sp Lmax) (U₂.tailLow st ci ex er sc sp Lmax)
  H := U₁.H
  H_tendsto := U₁.H_tendsto

/-- **`T` is below `U`**: every upper slot of `T` is at most `U`'s and every lower slot at least
`U`'s (so every register at `T` meets each request of `U`). -/
structure ClosedStrategyBelowV4 {D : ClosedEarlyData} (T U : ClosedThresholdsV4 D) : Prop where
  lc18_le : T.lc18 ≤ U.lc18
  circleUp_le : ∀ st β₃ θs θe θ₂, T.circleUp st β₃ θs θe θ₂ ≤ U.circleUp st β₃ θs θe θ₂
  β₂Up_le : ∀ st ci β₃, T.β₂Up st ci β₃ ≤ U.β₂Up st ci β₃
  ΔLow_ge : ∀ st ci β₃ β₂, U.ΔLow st ci β₃ β₂ ≤ T.ΔLow st ci β₃ β₂
  errorsUp_le : ∀ st ci ex, T.errorsUp st ci ex ≤ U.errorsUp st ci ex
  sectionUp_le : ∀ st ci ex co, T.sectionUp st ci ex co ≤ U.sectionUp st ci ex co
  lfr29W_le : ∀ st ci ex co bd, T.lfr29W st ci ex co bd ≤ U.lfr29W st ci ex co bd
  endpointUp_le : ∀ st ci ex co bd wk,
    T.endpointUp st ci ex co bd wk ≤ U.endpointUp st ci ex co bd wk
  σcolUp_le : ∀ st ci ex co bd wk s, T.σcolUp st ci ex co bd wk s ≤ U.σcolUp st ci ex co bd wk s
  scaleUp_le : ∀ st ci ex er, T.scaleUp st ci ex er ≤ U.scaleUp st ci ex er
  wUp_le : ∀ st ci ex er Λ, T.wUp st ci ex er Λ ≤ U.wUp st ci ex er Λ
  splitUp_le : ∀ st ci ex er sc, T.splitUp st ci ex er sc ≤ U.splitUp st ci ex er sc
  β₁Up_le : ∀ st ci ex er sc b, T.β₁Up st ci ex er sc b ≤ U.β₁Up st ci ex er sc b
  T₀Low_ge : ∀ st ci ex er sc b β₁, U.T₀Low st ci ex er sc b β₁ ≤ T.T₀Low st ci ex er sc b β₁
  LmaxLow_ge : ∀ st ci ex er sc sp, U.LmaxLow st ci ex er sc sp ≤ T.LmaxLow st ci ex er sc sp
  tailLow_ge : ∀ st ci ex er sc sp Lmax,
    U.tailLow st ci ex er sc sp Lmax ≤ T.tailLow st ci ex er sc sp Lmax

/-- A refining strategy is below. -/
theorem ClosedStrategyRefinesV4.below_VAL6 {D : ClosedEarlyData} {T U : ClosedThresholdsV4 D}
    (h : ClosedStrategyRefinesV4 T U) : ClosedStrategyBelowV4 T U where
  lc18_le := h.lc18_le
  circleUp_le := h.circleUp_le
  β₂Up_le := h.β₂Up_le
  ΔLow_ge := h.ΔLow_ge
  errorsUp_le := h.errorsUp_le
  sectionUp_le := h.sectionUp_le
  lfr29W_le := h.lfr29W_le
  endpointUp_le := fun _ _ _ _ _ _ => h.endpointUp_eq ▸ le_rfl
  σcolUp_le := h.σcolUp_le
  scaleUp_le := h.scaleUp_le
  wUp_le := h.wUp_le
  splitUp_le := h.splitUp_le
  β₁Up_le := h.β₁Up_le
  T₀Low_ge := h.T₀Low_ge
  LmaxLow_ge := fun _ _ _ _ _ _ => h.LmaxLow_eq ▸ le_rfl
  tailLow_ge := h.tailLow_ge

/-- "Below" is transitive. -/
theorem ClosedStrategyBelowV4.trans_VAL6 {D : ClosedEarlyData} {T U W : ClosedThresholdsV4 D}
    (h₁ : ClosedStrategyBelowV4 T U) (h₂ : ClosedStrategyBelowV4 U W) :
    ClosedStrategyBelowV4 T W where
  lc18_le := h₁.lc18_le.trans h₂.lc18_le
  circleUp_le := fun _ _ _ _ _ => (h₁.circleUp_le _ _ _ _ _).trans (h₂.circleUp_le _ _ _ _ _)
  β₂Up_le := fun _ _ _ => (h₁.β₂Up_le _ _ _).trans (h₂.β₂Up_le _ _ _)
  ΔLow_ge := fun _ _ _ _ => (h₂.ΔLow_ge _ _ _ _).trans (h₁.ΔLow_ge _ _ _ _)
  errorsUp_le := fun _ _ _ => (h₁.errorsUp_le _ _ _).trans (h₂.errorsUp_le _ _ _)
  sectionUp_le := fun _ _ _ _ => (h₁.sectionUp_le _ _ _ _).trans (h₂.sectionUp_le _ _ _ _)
  lfr29W_le := fun _ _ _ _ _ => (h₁.lfr29W_le _ _ _ _ _).trans (h₂.lfr29W_le _ _ _ _ _)
  endpointUp_le := fun _ _ _ _ _ _ =>
    (h₁.endpointUp_le _ _ _ _ _ _).trans (h₂.endpointUp_le _ _ _ _ _ _)
  σcolUp_le := fun _ _ _ _ _ _ _ =>
    (h₁.σcolUp_le _ _ _ _ _ _ _).trans (h₂.σcolUp_le _ _ _ _ _ _ _)
  scaleUp_le := fun _ _ _ _ => (h₁.scaleUp_le _ _ _ _).trans (h₂.scaleUp_le _ _ _ _)
  wUp_le := fun _ _ _ _ _ => (h₁.wUp_le _ _ _ _ _).trans (h₂.wUp_le _ _ _ _ _)
  splitUp_le := fun _ _ _ _ _ => (h₁.splitUp_le _ _ _ _ _).trans (h₂.splitUp_le _ _ _ _ _)
  β₁Up_le := fun _ _ _ _ _ _ => (h₁.β₁Up_le _ _ _ _ _ _).trans (h₂.β₁Up_le _ _ _ _ _ _)
  T₀Low_ge := fun _ _ _ _ _ _ _ => (h₂.T₀Low_ge _ _ _ _ _ _ _).trans (h₁.T₀Low_ge _ _ _ _ _ _ _)
  LmaxLow_ge := fun _ _ _ _ _ _ => (h₂.LmaxLow_ge _ _ _ _ _ _).trans (h₁.LmaxLow_ge _ _ _ _ _ _)
  tailLow_ge := fun _ _ _ _ _ _ _ =>
    (h₂.tailLow_ge _ _ _ _ _ _ _).trans (h₁.tailLow_ge _ _ _ _ _ _ _)

