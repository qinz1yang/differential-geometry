  (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂)


/-- The zero support of the zero ball at `k` meets SGP01's `D_i = B(i, .95Lρ(i))`. -/
def sgpZeroMeets_BAUGP (i k : X) (hk : k ∈ Z.centres) : Prop :=
  (tsupport (fun y => Calculus.annularCutoff Calculus.cutoffProfile ((Z.zero k hk).radial y)) ∩
    ball i (95 / 100 * (1000000 * Δ) * ρ i)).Nonempty



open Classical in
/-- The slim block of SGP04's model graph at the slim tag `j` (reference tag `i`): the own block
`(a, 1)`; for a listed `j ≠ i` the block `(λ f(λ/(s_jℓ)), s_j f(λ/(s_jℓ)))`, `λ = sgn_j a + c_j`;
zero for unlisted `j`. -/
def sgpSlimModelBlock_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c : X → ℝ)
    (j : L.slim.finite_centres.toFinset) (a : ℝ) : WithLp 2 (ℝ² × ℝ) :=
  if j = i then WithLp.toLp 2 (planeAxis a, 1)
  else if j.1 ∈ sgpSlimList_BAUGP L.slim i.1 then
    sgpBlockEmbed (sgpModelBlock (10 ^ 5 * Δ) (ρ j.1 / ρ i.1) (sgn j.1 * a + c j.1))
  else 0



open Classical in
/-- The zero block of SGP04's full model graph at the zero tag `k`: FC05's
`F_{s₀}(zsgn a + zc)`, `s₀ = R₀/ρ(i)`, when the zero support meets `D_i`; zero otherwise. -/
def sgpZeroModelBlock_BAUGP (i : L.slim.finite_centres.toFinset) (zsgn zc : X → ℝ)
    (k : Z.finite_centres.toFinset) (a : ℝ) : WithLp 2 (ℝ² × ℝ) :=
  if sgpZeroMeets_BAUGP Z (Δ := Δ) i.1 k.1 ((Set.Finite.mem_toFinset _).mp k.2) then
    sgpBlockEmbed (zeroModelBlock ((Z.zero k.1 ((Set.Finite.mem_toFinset _).mp k.2)).radius /
      ρ i.1) (zsgn k.1 * a + zc k.1))
  else 0



/-- The blocks of SGP04's (frozen) slim model graph: slim blocks, zero elsewhere. -/
def sgpModelTag_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c : X → ℝ) :
    CGPTag_BAUGP L Z → ℝ → WithLp 2 (ℝ² × ℝ)
  | .inr (.inl j) => sgpSlimModelBlock_BAUGP L i sgn c j
  | _ => fun _ => 0



/-- **SGP04's model slim graph** `Φ_i : ℝ → Q₃` (frozen form): own block `(a, 1)`, the listed
slim blocks, zero elsewhere. -/
def sgpModelGraph_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c : X → ℝ) :
    ℝ → BlockSpace (fun _ : CGPTag_BAUGP L Z => ℝ²) :=
  orthogonalBlocks (sgpModelTag_BAUGP L Z i sgn c)



/-- The blocks of SGP04's full model graph: the slim blocks and FC05's meeting zero block. -/
def sgpFullTag_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c zsgn zc : X → ℝ) :
    CGPTag_BAUGP L Z → ℝ → WithLp 2 (ℝ² × ℝ)
  | .inr (.inl j) => sgpSlimModelBlock_BAUGP L i sgn c j
  | .inr (.inr (.inr (.inl k))) => sgpZeroModelBlock_BAUGP L Z i zsgn zc k
  | _ => fun _ => 0



/-- **SGP04's full model graph** `Φ_i : ℝ → Q₃` (the model of (SG)): `sgpModelGraph_BAUGP` plus the
zero block of the zero support meeting `D_i`. -/
def sgpFullGraph_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c zsgn zc : X → ℝ) :
    ℝ → BlockSpace (fun _ : CGPTag_BAUGP L Z => ℝ²) :=
  orthogonalBlocks (sgpFullTag_BAUGP L Z i sgn c zsgn zc)



theorem sgpModelGraph_apply_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c : X → ℝ) (a : ℝ)
    (t : CGPTag_BAUGP L Z) : sgpModelGraph_BAUGP L Z i sgn c a t = sgpModelTag_BAUGP L Z i sgn c t a := rfl



theorem sgpFullGraph_apply_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c zsgn zc : X → ℝ)
    (a : ℝ) (t : CGPTag_BAUGP L Z) :
    sgpFullGraph_BAUGP L Z i sgn c zsgn zc a t = sgpFullTag_BAUGP L Z i sgn c zsgn zc t a := rfl



/-- The own block of `Φ_i` is `(a, 1)`. -/
theorem sgpModelGraph_own_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c : X → ℝ) (a : ℝ) :
    sgpModelGraph_BAUGP L Z i sgn c a (.inr (.inl i)) = WithLp.toLp 2 (planeAxis a, 1) := by
  rw [sgpModelGraph_apply_BAUGP]
  change sgpSlimModelBlock_BAUGP L i sgn c i a = _
  simp [sgpSlimModelBlock_BAUGP]



theorem sgpFullGraph_own_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c zsgn zc : X → ℝ)
    (a : ℝ) :
    sgpFullGraph_BAUGP L Z i sgn c zsgn zc a (.inr (.inl i)) = WithLp.toLp 2 (planeAxis a, 1) := by
  rw [sgpFullGraph_apply_BAUGP]
  change sgpSlimModelBlock_BAUGP L i sgn c i a = _
  simp [sgpSlimModelBlock_BAUGP]



theorem contDiff_sgpSlimModelBlock_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c : X → ℝ)
    (j : L.slim.finite_centres.toFinset) : ContDiff ℝ ∞ (sgpSlimModelBlock_BAUGP L i sgn c j) := by
  classical
  unfold sgpSlimModelBlock_BAUGP
  split_ifs
  · have h : ContDiff ℝ ∞ fun a : ℝ => ((a, (1 : ℝ)) : ℝ × ℝ) :=
      contDiff_id.prodMk contDiff_const
    have h2 : ContDiff ℝ ∞ fun a : ℝ => ((planeAxis a, (1 : ℝ)) : ℝ² × ℝ) :=
      (planeAxis.contDiff).prodMk contDiff_const
    exact ((WithLp.prodContinuousLinearEquiv 2 ℝ ℝ² ℝ).symm :
      (ℝ² × ℝ) →L[ℝ] WithLp 2 (ℝ² × ℝ)).contDiff.comp h2
  · exact sgpBlockEmbed.toContinuousLinearMap.contDiff.comp
      ((contDiff_sgpModelBlock _ _).comp ((contDiff_const.mul contDiff_id).add contDiff_const))
  · exact contDiff_const



theorem contDiff_sgpZeroModelBlock_BAUGP (i : L.slim.finite_centres.toFinset) (zsgn zc : X → ℝ)
    (k : Z.finite_centres.toFinset) : ContDiff ℝ ∞ (sgpZeroModelBlock_BAUGP L Z i zsgn zc k) := by
  classical
  unfold sgpZeroModelBlock_BAUGP
  split_ifs
  · exact sgpBlockEmbed.toContinuousLinearMap.contDiff.comp
      ((contDiff_zeroModelBlock _).comp ((contDiff_const.mul contDiff_id).add contDiff_const))
  · exact contDiff_const



theorem contDiff_sgpModelTag_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c : X → ℝ)
    (t : CGPTag_BAUGP L Z) : ContDiff ℝ ∞ (sgpModelTag_BAUGP L Z i sgn c t) := by
  rcases t with j | j | j | k | bb
  · exact contDiff_const
  · exact contDiff_sgpSlimModelBlock_BAUGP L i sgn c j
  · exact contDiff_const
  · exact contDiff_const
  · exact contDiff_const



theorem contDiff_sgpFullTag_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c zsgn zc : X → ℝ)
    (t : CGPTag_BAUGP L Z) : ContDiff ℝ ∞ (sgpFullTag_BAUGP L Z i sgn c zsgn zc t) := by
  rcases t with j | j | j | k | bb
  · exact contDiff_const
  · exact contDiff_sgpSlimModelBlock_BAUGP L i sgn c j
  · exact contDiff_const
  · exact contDiff_sgpZeroModelBlock_BAUGP L Z i zsgn zc k
  · exact contDiff_const



/-- `Φ_i` is smooth. -/
theorem contDiff_sgpModelGraph_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c : X → ℝ) :
    ContDiff ℝ ∞ (sgpModelGraph_BAUGP L Z i sgn c) :=
  contDiff_orthogonalBlocks (contDiff_sgpModelTag_BAUGP L Z i sgn c)



theorem contDiff_sgpFullGraph_BAUGP (i : L.slim.finite_centres.toFinset) (sgn c zsgn zc : X → ℝ) :
    ContDiff ℝ ∞ (sgpFullGraph_BAUGP L Z i sgn c zsgn zc) :=
  contDiff_orthogonalBlocks (contDiff_sgpFullTag_BAUGP L Z i sgn c zsgn zc)


