open Classical in
/-- **The blocks of EGP06's model graph** at the edge reference `i`, with signs `sgn` and
translations `c` per tag (`λ_t(a) = sgn_t a + c_t`): own edge tag `i` ↦ `(a, 1)`; listed edge
`j ≠ i` ↦ `graphPacketModelBlock Δ s_j (λ_t(a))`; listed slim `j` ↦ `sgpModelBlock (10⁵Δ) s_j
(λ_t(a))`; zero `k` meeting `D_i` ↦ `zeroModelBlock (R₀/ρ(i)) (λ_t(a))` (`s_j = ρ(j)/ρ(i)`, scalar
blocks on `planeAxis`); every other tag (circle, unlisted, scale, `E'`) ↦ `0`. -/
def egpModelComponent_BAUGP (L : LocalPacketsOnB X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc
    Lmax τ γ δ εr e T V vs U₁ U₂ Ue₁ Ue₂)
    (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂) (i : X)
    (sgn c : CGPTag_BAUGP L Z → ℝ) : (t : CGPTag_BAUGP L Z) → ℝ → WithLp 2 (ℝ² × ℝ)
  | .inl _ => 0
  | .inr (.inl j) =>
      if j.1 ∈ egpSlimList_BAUGP L i then
        fun a => blockLift_KC3 (sgpModelBlock (10 ^ 5 * Δ) (ρ j.1 / ρ i)
          (sgn (.inr (.inl j)) * a + c (.inr (.inl j))))
      else 0
  | .inr (.inr (.inl j)) =>
      if j.1 = i then fun a => blockLift_KC3 (WithLp.toLp 2 (a, 1))
      else if j.1 ∈ egpEdgeList_BAUGP L i then
        fun a => blockLift_KC3 (graphPacketModelBlock Δ (ρ j.1 / ρ i)
          (sgn (.inr (.inr (.inl j))) * a + c (.inr (.inr (.inl j)))))
      else 0
  | .inr (.inr (.inr (.inl k))) =>
      if k.1 ∈ zeroMeetingList_BPE Z i (20 * Δ) then
        fun a => blockLift_KC3 (zeroModelBlock
          ((Z.zero k.1 ((Set.Finite.mem_toFinset _).mp k.2)).radius / ρ i)
          (sgn (.inr (.inr (.inr (.inl k)))) * a + c (.inr (.inr (.inr (.inl k))))))
      else 0
  | .inr (.inr (.inr (.inr _))) => 0

/-- **EGP06's model graph** `Φ_i : ℝ → 𝓔⁰`'s block space (values in `Q₂`). -/
def egpModelGraph_BAUGP (L : LocalPacketsOnB X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc
    Lmax τ γ δ εr e T V vs U₁ U₂ Ue₁ Ue₂)
    (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂) (i : X)
    (sgn c : CGPTag_BAUGP L Z → ℝ) : ℝ → BlockSpace (fun _ : CGPTag_BAUGP L Z => ℝ²) :=
  blockGraph_KC3 (egpModelComponent_BAUGP L Z i sgn c)

/-- The listed tags of EGP06's model at `i` (where its block may be nonzero). -/
def egpModelListed_BAUGP (L : LocalPacketsOnB X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc
    Lmax τ γ δ εr e T V vs U₁ U₂ Ue₁ Ue₂)
    (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂) (i : X) : CGPTag_BAUGP L Z →
        Prop
  | .inl _ => False
  | .inr (.inl j) => j.1 ∈ egpSlimList_BAUGP L i
  | .inr (.inr (.inl j)) => j.1 = i ∨ j.1 ∈ egpEdgeList_BAUGP L i
  | .inr (.inr (.inr (.inl k))) => k.1 ∈ zeroMeetingList_BPE Z i (20 * Δ)
  | .inr (.inr (.inr (.inr _))) => False

open Classical in
/-- Every unlisted block of the model is the zero function. -/
theorem egpModelComponent_eq_zero_BAUGP
    (L : LocalPacketsOnB X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs
        U₁ U₂ Ue₁ Ue₂)
    (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂) (i : X)
    (sgn c : CGPTag_BAUGP L Z → ℝ) (t : CGPTag_BAUGP L Z) (ht : ¬ egpModelListed_BAUGP L Z i t) :
    egpModelComponent_BAUGP L Z i sgn c t = 0 := by
  rcases t with j | j | j | k | q
  · rfl
  · simp only [egpModelListed_BAUGP] at ht
    simp only [egpModelComponent_BAUGP, ht, ite_false]
  · simp only [egpModelListed_BAUGP, not_or] at ht
    simp only [egpModelComponent_BAUGP, ht.1, ht.2, ite_false]
  · simp only [egpModelListed_BAUGP] at ht
    simp only [egpModelComponent_BAUGP, ht, ite_false]
  · rfl

open Classical in
/-- Every block of the model is smooth. -/
theorem contDiff_egpModelComponent_BAUGP
    (L : LocalPacketsOnB X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs
        U₁ U₂ Ue₁ Ue₂)
    (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂) (i : X)
    (sgn c : CGPTag_BAUGP L Z → ℝ) (t : CGPTag_BAUGP L Z) :
    ContDiff ℝ ∞ (egpModelComponent_BAUGP L Z i sgn c t) := by
  have haff : ∀ (σ c' : ℝ), ContDiff ℝ ∞ (fun a : ℝ => σ * a + c') :=
    fun σ c' => (contDiff_const.mul contDiff_id).add contDiff_const
  rcases t with j | j | j | k | q
  · exact contDiff_const
  · simp only [egpModelComponent_BAUGP]
    split_ifs
    · exact blockLift_KC3.contDiff.comp ((contDiff_sgpModelBlock _ _).comp (haff _ _))
    · exact contDiff_const
  · simp only [egpModelComponent_BAUGP]
    split_ifs
    · exact blockLift_KC3.contDiff.comp own_block_bounds_KC3.1
    · exact blockLift_KC3.contDiff.comp ((contDiff_graphPacketModelBlock _ _).comp (haff _ _))
    · exact contDiff_const
  · simp only [egpModelComponent_BAUGP]
    split_ifs
    · exact blockLift_KC3.contDiff.comp ((contDiff_zeroModelBlock _).comp (haff _ _))
    · exact contDiff_const
  · exact contDiff_const

theorem contDiff_egpModelGraph_BAUGP
    (L : LocalPacketsOnB X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs
        U₁ U₂ Ue₁ Ue₂)
    (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂) (i : X)
    (sgn c : CGPTag_BAUGP L Z → ℝ) : ContDiff ℝ ∞ (egpModelGraph_BAUGP L Z i sgn c) :=
  contDiff_blockGraph_KC3 (contDiff_egpModelComponent_BAUGP L Z i sgn c)

/-- The own block of the model is `(a, 1)`. -/
theorem egpModelGraph_own_BAUGP
    (L : LocalPacketsOnB X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs
        U₁ U₂ Ue₁ Ue₂)
    (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂) (i : X)
    (sgn c : CGPTag_BAUGP L Z → ℝ) (j : L.edgeB.finite_centres.toFinset) (hj : j.1 = i) (a : ℝ) :
    egpModelGraph_BAUGP L Z i sgn c a (.inr (.inr (.inl j))) = WithLp.toLp 2 (planeAxis a, 1) := by
  change egpModelComponent_BAUGP L Z i sgn c (.inr (.inr (.inl j))) a = _
  simp only [egpModelComponent_BAUGP, hj, ite_true]
  rfl

open Classical in
/-- The model takes values in `Q₂` (no circle, scale or `E'` block). -/
theorem blockRestrict_egpModelGraph_BAUGP
    (L : LocalPacketsOnB X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs
        U₁ U₂ Ue₁ Ue₂)
    (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂) (i : X)
    (sgn c : CGPTag_BAUGP L Z → ℝ) (a : ℝ) :
    blockRestrict (cgpQ2Tags_BPE L Z) (egpModelGraph_BAUGP L Z i sgn c a) = egpModelGraph_BAUGP L Z
        i sgn c a := by
  refine PiLp.ext fun t => ?_
  rw [blockRestrict_apply]
  split_ifs with ht
  · rfl
  · have h0 : egpModelComponent_BAUGP L Z i sgn c t = 0 := by
      apply egpModelComponent_eq_zero_BAUGP
      rcases t with j | j | j | k | q
      · exact fun h => h
      · exact (ht (Finset.mem_filter.mpr ⟨Finset.mem_univ _, rfl⟩)).elim
      · exact (ht (Finset.mem_filter.mpr ⟨Finset.mem_univ _, rfl⟩)).elim
      · exact (ht (Finset.mem_filter.mpr ⟨Finset.mem_univ _, rfl⟩)).elim
      · exact fun h => h
    change 0 = egpModelComponent_BAUGP L Z i sgn c t a
    rw [h0]
    rfl

open Classical in
/-- **EGP06's model bounds (kernel form).** With `Δ ≥ 1`, signs `|sgn_t| ≤ 1`, ratios
`s_j ≥ 99/100` for the listed edge and slim charts, zero ratios `R₀/ρ(i) ≥ 1` for the zero
supports meeting `D_i`, and at most `N† + 2` listed tags, the model graph has first and second
derivatives at most `C† = 1000(N† + 2)(P† + 1)`. -/
theorem egp06_model_kernel_BAUGP
    (L : LocalPacketsOnB X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs
        U₁ U₂ Ue₁ Ue₂)
    (Z : ZeroModelFamilyOn 𝓘(ℝ, E3) X g ρ hρ β N C o δ εr e T V U₁ U₂) {i : X} (hi : i ∈
        L.edgeB.centres)
    (sgn c : CGPTag_BAUGP L Z → ℝ) (hΔ : 1 ≤ Δ) (hsgn : ∀ t, |sgn t| ≤ 1)
    (hS : ∀ j ∈ egpSlimList_BAUGP L i, 99 / 100 ≤ ρ j / ρ i)
    (hE : ∀ j ∈ egpEdgeList_BAUGP L i, 99 / 100 ≤ ρ j / ρ i)
    (hZ : ∀ k (hk : k ∈ Z.centres), k ∈ zeroMeetingList_BPE Z i (20 * Δ) →
      1 ≤ (Z.zero k hk).radius / ρ i)
    (hcount : ((Finset.univ.filter (egpModelListed_BAUGP L Z i)).card : ℝ) ≤ egp02ListBound + 2)
    (a : ℝ) :
    ‖fderiv ℝ (egpModelGraph_BAUGP L Z i sgn c) a‖ ≤ egpGraphConst ∧
      ‖fderiv ℝ (fderiv ℝ (egpModelGraph_BAUGP L Z i sgn c)) a‖ ≤ egpGraphConst := by
  have hP := one_le_egpProfileConst
  have hPe : edgeProfileDerivativeBound ≤ egpProfileConst := le_max_left _ _
  have hPs : sgpProfileBound ≤ egpProfileConst := (le_max_left _ _).trans (le_max_right _ _)
  have hPz : zeroProfileBound ≤ egpProfileConst := (le_max_right _ _).trans (le_max_right _ _)
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = 50 * (egpProfileConst + 1) := ⟨_, rfl⟩
  have hB : 0 ≤ B := by rw [hBdef]; linarith
  have hB1 : 1 ≤ B := by rw [hBdef]; linarith
  set S := Finset.univ.filter (egpModelListed_BAUGP L Z i) with hSdef
  have hblock : ∀ t, t ∈ S → ∀ a, ‖fderiv ℝ (egpModelComponent_BAUGP L Z i sgn c t) a‖ ≤ B ∧
      ‖fderiv ℝ (fderiv ℝ (egpModelComponent_BAUGP L Z i sgn c t)) a‖ ≤ B := by
    intro t ht a
    have hl := (Finset.mem_filter.mp ht).2
    rcases t with j | j | j | k | q
    · exact hl.elim
    · have hl' : j.1 ∈ egpSlimList_BAUGP L i := hl
      have hℓ : 1 ≤ 10 ^ 5 * Δ := by nlinarith
      have hW (y : ℝ) := sgpModelBlock_derivative_bounds hℓ (hS j.1 hl') y
      simp only [egpModelComponent_BAUGP, hl', ite_true]
      exact lifted_affine_bounds_KC3 ((contDiff_sgpModelBlock _ _).of_le (by simp)) (hsgn _) hB
        (fun y => (hW y).1.trans (by rw [hBdef]; linarith))
        (fun y => (hW y).2.trans (by rw [hBdef]; linarith)) a
    · by_cases hji : j.1 = i
      · simp only [egpModelComponent_BAUGP, hji, ite_true]
        have h := clm_comp_bounds_KC3 blockLift_KC3 norm_blockLift_le_KC3
          (own_block_bounds_KC3.1.of_le (by simp)) (fun y => (own_block_bounds_KC3.2 y).1)
          (fun y => (own_block_bounds_KC3.2 y).2) a
        exact ⟨h.1.trans hB1, h.2.trans hB1⟩
      · have hl' : j.1 ∈ egpEdgeList_BAUGP L i := hl.resolve_left hji
        have hW (y : ℝ) := graphPacketModelBlock_derivative_bounds hΔ (hE j.1 hl') y
        simp only [egpModelComponent_BAUGP, hji, hl', ite_true, ite_false]
        exact lifted_affine_bounds_KC3 ((contDiff_graphPacketModelBlock _ _).of_le (by simp))
          (hsgn _) hB (fun y => (hW y).1.trans (by rw [hBdef]; linarith))
          (fun y => (hW y).2.trans (by rw [hBdef]; linarith)) a
    · have hl' : k.1 ∈ zeroMeetingList_BPE Z i (20 * Δ) := hl
      have hW (y : ℝ) := zeroModelBlock_derivative_bounds
        (hZ k.1 ((Set.Finite.mem_toFinset _).mp k.2) hl') y
      simp only [egpModelComponent_BAUGP, hl', ite_true]
      exact lifted_affine_bounds_KC3 ((contDiff_zeroModelBlock _).of_le (by simp)) (hsgn _) hB
        (fun y => (hW y).1.trans (by rw [hBdef]; linarith))
        (fun y => (hW y).2.trans (by rw [hBdef]; linarith)) a
    · exact hl.elim
  have hz : ∀ t, t ∉ S → egpModelComponent_BAUGP L Z i sgn c t = 0 := fun t ht =>
    egpModelComponent_eq_zero_BAUGP L Z i sgn c t fun hl =>
      ht (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hl⟩)
  have hmain := blockGraph_bounds_KC3
    (fun t => (contDiff_egpModelComponent_BAUGP L Z i sgn c t).of_le (by simp)) S hB hz
    (fun t ht a => (hblock t ht a).1) (fun t ht a => (hblock t ht a).2) a
  -- the count
  have hown : (.inr (.inr (.inl ⟨i, (Set.Finite.mem_toFinset _).mpr hi⟩)) : CGPTag_BAUGP L Z) ∈ S :=
    Finset.mem_filter.mpr ⟨Finset.mem_univ _, Or.inl rfl⟩
  have hS1 : (1 : ℝ) ≤ S.card := by
    exact_mod_cast Finset.card_pos.mpr ⟨_, hown⟩
  have hsqrt : Real.sqrt (S.card : ℝ) ≤ S.card := by
    rw [Real.sqrt_le_left (by linarith)]
    nlinarith
  have hfin : Real.sqrt (S.card : ℝ) * B ≤ egpGraphConst := by
    have h1 : Real.sqrt (S.card : ℝ) * B ≤ (egp02ListBound + 2) * B :=
      mul_le_mul_of_nonneg_right (hsqrt.trans hcount) hB
    have h2 : (egp02ListBound + 2) * B ≤ egpGraphConst := by
      rw [hBdef, egpGraphConst]
      have hN : 0 ≤ egp02ListBound + 2 := by linarith
      nlinarith
    linarith
  exact ⟨hmain.1.trans hfin, hmain.2.trans hfin⟩

end Model

