    (hT : 1600 * (1000000 * Δ) ≤ T) (i : X) :
    ((Finset.univ.filter (egpModelListed_BAUGP P.toLocalPacketsOnB P.zero i)).card : ℝ) ≤
      egp02ListBound + 2 := by
  have hΔ0 : 0 < Δ := by linarith
  let L := P.toLocalPacketsOnB
  -- the three kinds of listed tags
  let SS := Finset.univ.filter fun j : L.slim.finite_centres.toFinset => j.1 ∈ egpSlimList_BAUGP L i
  let SE := Finset.univ.filter fun j : L.edgeB.finite_centres.toFinset =>
    j.1 = i ∨ j.1 ∈ egpEdgeList_BAUGP L i
  let SZ := Finset.univ.filter fun k : P.zero.finite_centres.toFinset =>
    k.1 ∈ zeroMeetingList_BPE P.zero i (20 * Δ)
  let eS : L.slim.finite_centres.toFinset ↪ CGPTag_BAUGP L P.zero :=
    ⟨fun j => .inr (.inl j), fun _ _ h => by simpa using h⟩
  let eE : L.edgeB.finite_centres.toFinset ↪ CGPTag_BAUGP L P.zero :=
    ⟨fun j => .inr (.inr (.inl j)), fun _ _ h => by simpa using h⟩
  let eZ : P.zero.finite_centres.toFinset ↪ CGPTag_BAUGP L P.zero :=
    ⟨fun k => .inr (.inr (.inr (.inl k))), fun _ _ h => by simpa using h⟩
  have hsub : Finset.univ.filter (egpModelListed_BAUGP L P.zero i) ⊆
      (SS.map eS ∪ SE.map eE) ∪ SZ.map eZ := by
    intro t ht
    have hl := (Finset.mem_filter.mp ht).2
    rcases t with j | j | j | k | q
    · exact hl.elim
    · exact Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_map_of_mem eS (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hl⟩)))
    · exact Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_map_of_mem eE (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hl⟩)))
    · exact Finset.mem_union_right _
        (Finset.mem_map_of_mem eZ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hl⟩))
    · exact hl.elim
  have hcard := (Finset.card_le_card hsub).trans ((Finset.card_union_le _ _).trans
    (Nat.add_le_add_right (Finset.card_union_le _ _) _))
  rw [Finset.card_map, Finset.card_map, Finset.card_map] at hcard
  -- slim
  have hSS : SS.card ≤ (egpSlimList_BAUGP L i).ncard := by
    have h : SS.card ≤ {y | y ∈ L.slim.centres ∧ y ∈ egpSlimList_BAUGP L i}.ncard := by
      rw [← Set.ncard_coe_finset, Finset.coe_filter]
      simp only [Finset.mem_univ, true_and]
      exact ncard_subtype_le_KA2 L.slim.finite_centres
        (p := fun y => y ∈ egpSlimList_BAUGP L i) (q := fun y => y ∈ egpSlimList_BAUGP L i) fun _ _
            hy => hy
    refine h.trans (Set.ncard_le_ncard (fun y hy => hy.2) ?_)
    exact L.slim.finite_centres.subset fun y hy => hy.1
  -- edge
  have hfinE : (egpEdgeList_BAUGP L i).Finite := L.edgeB.finite_centres.subset fun y hy => hy.1
  have hSE : SE.card ≤ (egpEdgeList_BAUGP L i).ncard + 1 := by
    have h : SE.card ≤ {y | y ∈ L.edgeB.centres ∧ (y = i ∨ y ∈ egpEdgeList_BAUGP L i)}.ncard := by
      rw [← Set.ncard_coe_finset, Finset.coe_filter]
      simp only [Finset.mem_univ, true_and]
      exact ncard_subtype_le_KA2 L.edgeB.finite_centres
        (p := fun y => y = i ∨ y ∈ egpEdgeList_BAUGP L i) (q := fun y => y = i ∨ y ∈
            egpEdgeList_BAUGP L i)
        fun _ _ hy => hy
    refine h.trans ((Set.ncard_le_ncard (t := insert i (egpEdgeList_BAUGP L i))
      (fun y hy => ?_) (hfinE.insert i)).trans (Set.ncard_insert_le _ _))
    rcases hy.2 with h1 | h1
    · exact Or.inl h1
    · exact Or.inr h1
