        Δ)}.ncard := by
      rw [← Set.ncard_coe_finset, Finset.coe_filter]
      simp only [Finset.mem_univ, true_and]
      exact ncard_subtype_le_KA2 P.zero.finite_centres
        (p := fun y => y ∈ zeroMeetingList_BPE P.zero i (20 * Δ))
        (q := fun y => y ∈ zeroMeetingList_BPE P.zero i (20 * Δ)) fun _ _ hy => hy
    refine h.trans (Set.ncard_le_ncard (fun y hy => hy.2) ?_)
    exact P.zero.finite_centres.subset fun y hy => hy.1
  have hlist := egp02_list_count_BAUGP L hΛ hΔ0 hLΛ i
  have hcardR : ((Finset.univ.filter (egpModelListed_BAUGP L P.zero i)).card : ℝ) ≤
      SS.card + SE.card + SZ.card := by exact_mod_cast hcard
  have hSSR : (SS.card : ℝ) ≤ (egpSlimList_BAUGP L i).ncard := by exact_mod_cast hSS
  have hSER : (SE.card : ℝ) ≤ (egpEdgeList_BAUGP L i).ncard + 1 := by exact_mod_cast hSE
  have hSZR : (SZ.card : ℝ) ≤ 1 := by exact_mod_cast hSZ.trans hZ1
