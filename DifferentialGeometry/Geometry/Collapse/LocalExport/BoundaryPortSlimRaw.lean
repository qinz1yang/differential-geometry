import DifferentialGeometry.Geometry.Collapse.LocalExport.BoundaryRegionalSlimValue
import DifferentialGeometry.Geometry.Collapse.LocalExport.BoundarySlimCutoffOn
import DifferentialGeometry.Geometry.Fibration.ActualSlimRawAlignment

/-!
# SGP02's raw slim coordinates on the boundary family (lane B-PORT-SLIM, G1a)

GENERATED by `build-logs/scratch/B-PORT-SLIM/gen_g1.py` (job `raw`) from
`Fibration/ActualSlimRawAlignment.lean` (section `Actual`) with the substitution table
`portlib.GLOBAL` (`[CompactSpace X]` → `[CompleteSpace X] [SigmaCompactSpace X]`,
`SlimCentre` → `SlimCentreOn`, `SlimFamily` → `SlimFamilyOn … U₁ U₂`, `cutoff` → `cutoff_BCNT`) and
the suffix `_BAUGP`. On a regional slim family (complete σ-compact carrier, centres in `U₁`):

* `sgpSplitMap_BAUGP`, `sgpRaw_BAUGP` (`u_j = (split_j ·).fst`, zero off the centres),
  `sgpSlimList_BAUGP` (`J_i`: centres whose closed cutoff support meets `B(i, .95Lρ(i))`);
* `sgpSplitMap_center_BAUGP`, `sgpRaw_of_mem_BAUGP`, `sgpRaw_center_BAUGP`, `sgp02_self_BAUGP`.
-/

set_option autoImplicit false

noncomputable section

open Set Function Metric Bundle Manifold Filter
open scoped ContDiff Manifold Topology
open DifferentialGeometry.Geometry.Riemannian GC.MetricGeometry
open DifferentialGeometry.Geometry.Riemannian.Exponential
open DifferentialGeometry.Analysis

namespace DifferentialGeometry.Geometry.Collapse

local notation "E3" => EuclideanSpace ℝ (Fin 3)
local notation "E1" => EuclideanSpace ℝ (Fin 1)

attribute [-instance] Tensor0SBundle.tangentSpaceNormedAddCommGroup
  Tensor0SBundle.tangentSpaceNormedSpace

attribute [local instance] nezero_finrank_euclideanThree_LC87

variable {X : Type} [mX : MetricSpace X] [ChartedSpace E3 X] [IsManifold 𝓘(ℝ, E3) ∞ X]
  [CompleteSpace X] [SigmaCompactSpace X] {g : SmoothRiemannianMetric 𝓘(ℝ, E3) X}
  {hmetric : ∀ a b : X, riemannianEDistOf g a b = ENNReal.ofReal (dist a b)}
  {ρ : X → ℝ} {hρ : ∀ p, 0 < ρ p} {β : ℕ → ℝ} {Δ σs : ℝ} {K : ℕ} {U₁ U₂ : Set X}

/-- The actual normalized splitting map `X → ℝ × Z_j` of a slim centre (the map of
`SlimCentreOn.split`, read without the rescaled source metric). -/
def sgpSplitMap_BAUGP {β₁ : ℝ} {j : X} (c : SlimCentreOn X g hmetric ρ hρ β₁ Δ σs K j) :
    X → WithLp 2 (ℝ × c.Z) :=
  letI := c.instZ
  @KleinerLottApprox.toFun X (WithLp 2 (ℝ × c.Z)) (mX.rescale (ρ j)⁻¹ (inv_pos.mpr (hρ j))) _ j
    (WithLp.toLp 2 ((0 : ℝ), c.z)) β₁ c.split

open Classical in
/-- The original real coordinate `u_j` of the actual normalized splitting at the slim centre `j`
(zero off the centres). -/
def sgpRaw_BAUGP (S : SlimFamilyOn X g hmetric ρ hρ β Δ σs K U₁ U₂) (j : X) (x : X) : ℝ :=
  if hj : j ∈ S.centres then (sgpSplitMap_BAUGP (S.centre j hj) x).fst else 0

/-- The list `J_i`: slim centres whose closed cutoff support meets `D_i = B(i, .95Lρ(i))`. -/
def sgpSlimList_BAUGP (S : SlimFamilyOn X g hmetric ρ hρ β Δ σs K U₁ U₂) (i : X) : Set X :=
  {j | j ∈ S.centres ∧ (tsupport (S.cutoff_BCNT j) ∩ ball i (95 / 100 * (1000000 * Δ) * ρ i)).Nonempty}

theorem sgpSplitMap_center_BAUGP {β₁ : ℝ} {j : X} (c : SlimCentreOn X g hmetric ρ hρ β₁ Δ σs K j) :
    sgpSplitMap_BAUGP c j = (letI := c.instZ; WithLp.toLp 2 ((0 : ℝ), c.z)) := by
  let _ := c.instZ
  exact @KleinerLottApprox.basepoint X (WithLp 2 (ℝ × c.Z))
    (mX.rescale (ρ j)⁻¹ (inv_pos.mpr (hρ j))) _ j _ β₁ c.split

theorem sgpRaw_of_mem_BAUGP (S : SlimFamilyOn X g hmetric ρ hρ β Δ σs K U₁ U₂) {j : X} (hj : j ∈ S.centres)
    (x : X) : sgpRaw_BAUGP S j x = (sgpSplitMap_BAUGP (S.centre j hj) x).fst := by
  unfold sgpRaw_BAUGP
  rw [dite_eq_left hj]

theorem sgpRaw_center_BAUGP (S : SlimFamilyOn X g hmetric ρ hρ β Δ σs K U₁ U₂) (j : X) : sgpRaw_BAUGP S j j = 0 := by
  by_cases hj : j ∈ S.centres
  · rw [sgpRaw_of_mem_BAUGP S hj, sgpSplitMap_center_BAUGP]
    rfl
  · unfold sgpRaw_BAUGP
    rw [dite_eq_right hj]

/-- SGP02: `a_i = 1`, `c_i = 0`. -/
theorem sgp02_self_BAUGP (S : SlimFamilyOn X g hmetric ρ hρ β Δ σs K U₁ U₂) (i x : X) :
    ρ i / ρ i * sgpRaw_BAUGP S i x - 1 * sgpRaw_BAUGP S i x - ρ i / ρ i * sgpRaw_BAUGP S i i = 0 := by
  rw [div_self (hρ i).ne', sgpRaw_center_BAUGP]
  ring

end DifferentialGeometry.Geometry.Collapse
