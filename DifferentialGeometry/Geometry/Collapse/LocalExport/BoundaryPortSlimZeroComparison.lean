/-- **SGP02 (R0) on the actual packets (supplier).** Fix `Δ ≥ 1`, the exclusion quality `β₂` and
`E > 0`. There are a curvature radius `Lc` (asked of LPA01's buffer) and a raw quality `η₀` such
that for EVERY actual family `P : LocalChartPacketsZ` with `β 2 = β₂`, `β 1 ≤ η₀`, `Lc ≤ Lmax`,
`10⁶ΔΛ < 10⁻⁵`, `e < 1/40` and `T ≥ 1600L`: at every slim centre `i` whose `D_i = B(i, .95Lρ(i))`
meets the support of the zero ball at `p₀ = k`, there is a sign `a₀` with
`|ρ(i)⁻¹ (d(p₀, x) − d(p₀, i)) − a₀ u_i(x)| < E` on `B(i, 30Lρ(i))` (`u_i = sgpRaw_BAUGP`). -/
theorem sgp02_zero_supplier_ZERO_BAUGP {Δ β₂ E : ℝ} (hΔ : 1 ≤ Δ) (hβ₂ : 0 < β₂) (hβ₂1 : β₂ < 1)
    (hE : 0 < E) :
    ∃ Lc η₀ : ℝ, 0 < Lc ∧ 0 < η₀ ∧
      ∀ (X : Type) [MetricSpace X] [ChartedSpace E3 X] [IsManifold 𝓘(ℝ, E3) ∞ X]
        [CompleteSpace X] [SigmaCompactSpace X] (g : SmoothRiemannianMetric 𝓘(ℝ, E3) X)
        (hmetric : ∀ a b : X, riemannianEDistOf g a b = ENNReal.ofReal (dist a b))
        (ρ : X → ℝ) (hρ : ∀ p, 0 < ρ p) (Λ : ℝ) (β : ℕ → ℝ) (σs : ℝ) (K : ℕ)
        (σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz : ℝ)
        (U₁ U₂ Ue₁ Ue₂ : Set X)
        (P : LocalPacketsOnBF X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz U₁ U₂ Ue₁ Ue₂),
        β 2 = β₂ → β 1 ≤ η₀ → Lc ≤ Lmax → 0 ≤ Λ → 1000000 * Δ * Λ < 1 / 100000 →
        e < 1 / 40 → 1600 * (1000000 * Δ) ≤ T →
        ∀ i ∈ P.slim.centres, ∀ k (hk : k ∈ P.zero.centres),
          (tsupport (fun y => Calculus.annularCutoff Calculus.cutoffProfile
            ((P.zero.zero k hk).radial y)) ∩ ball i (95 / 100 * (1000000 * Δ) * ρ i)).Nonempty →
          ∃ a₀ : ℝ, (a₀ = 1 ∨ a₀ = -1) ∧ ∀ x ∈ ball i (30 * (1000000 * Δ) * ρ i),
            |(ρ i)⁻¹ * (dist k x - dist k i) - a₀ * sgpRaw_BAUGP P.slim i x| < E := by
  set H : ℝ := 30 * (1000000 * Δ) with hH
  set τz : ℝ := min (E / 100) (1 / (2 * (H + 1))) with hτz
  obtain ⟨hτ0, hτ1, ha0, ha, ha2, hτE, hHτ⟩ :=
    zero_alignment_parameters_ZERO (by rw [hH]; nlinarith) hE hτz
  obtain ⟨σ, η, hσ, hσ1, hη, hsupp⟩ :=
    zero_raw_alignment_ZERO_BAUGP (k := 1) le_rfl (by norm_num) hτ0 hτ1 hβ₂ hβ₂1 ha0 ha ha2
  have hH1 : 0 < 1 / (2 * (H + 1)) := by positivity
  refine ⟨σ⁻¹, min η (min (σ / 3) (1 / (2 * (H + 1)))), inv_pos.mpr hσ,
    lt_min hη (lt_min (by positivity) hH1), ?_⟩
  intro X mX _ _ _ _ g hmetric ρ hρ Λ β σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz
    U₁ U₂ Ue₁ Ue₂ P hβ2 hβ1 hLc hΛ hLΛ he hT i hi k hk hmeet
  have hri := hρ i
  have hβη : β 1 ≤ η := hβ1.trans (min_le_left _ _)
  have hβσ : 3 * β 1 ≤ σ := by
    have := hβ1.trans ((min_le_right _ _).trans (min_le_left _ _))
    linarith
  have hβH : β 1 ≤ 1 / (2 * (H + 1)) :=
    hβ1.trans ((min_le_right _ _).trans (min_le_right _ _))
  -- SGP01's zero clause puts `i` in the closed shell of the zero ball at `k`
  have hii : i ∈ ball i (95 / 100 * (1000000 * Δ) * ρ i) :=
    mem_ball_self (by have := hρ i; positivity)
  obtain ⟨-, -, h1, h2, -⟩ :=
    ((sgp01_zero_clauses_BAUGP P hΛ hΔ hLΛ he hT i).2 k hk hmeet).2.1 i hii
  -- the exclusion of the slim stratum
  have hstrat := (P.slim.centres_subset hi).2.1
  have hrank := (scaledSplittingRank_eq_iff.mp hstrat).2.2 2 (by norm_num) (by norm_num)
  rw [hβ2] at hrank
  -- the reference splitting with target `ℝ¹ × Z_i`
  let Si := P.slim.centre i hi
  let _ := Si.instZ
  let ψ := @KleinerLottApprox.mapTargetIsometryAt X (WithLp 2 (ℝ × Si.Z)) (WithLp 2 (E1 × Si.Z))
    (mX.rescale (ρ i)⁻¹ (inv_pos.mpr hri)) _ _ i (WithLp.toLp 2 ((0 : ℝ), Si.z)) (β 1) Si.split
    (realProdIso_SGP Si.Z) (WithLp.toLp 2 ((0 : E1), Si.z)) (realProdIso_SGP_zero Si.z)
  obtain ⟨A₀, hA₀, hal⟩ := hsupp X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ
    εr e T V vs ζ Λz U₁ U₂ Ue₁ Ue₂ P hLc hβη i k (P.slim.centres_subset hi).1 hk h1 h2 hrank Si.Z Si.z hβσ ψ
  obtain ⟨a₀, ha₀, hlin⟩ := coisometry_fin_one_SGP A₀ hA₀
  refine ⟨a₀, ha₀, fun x hx => ?_⟩
  have hxR : (ρ i)⁻¹ * dist x i < H := by
    rw [inv_mul_lt_iff₀ hri]
    have : dist x i < 30 * (1000000 * Δ) * ρ i := hx
    rw [hH]
    linarith
  have hb0 : 0 < β 1 := @KleinerLottApprox.error_pos X (WithLp 2 (ℝ × Si.Z))
    (mX.rescale (ρ i)⁻¹ (inv_pos.mpr hri)) _ i _ (β 1) Si.split
  have hβinv : 2 * (H + 1) ≤ (β 1)⁻¹ := by
    rw [le_inv_comm₀ (by linarith) hb0]
    simpa only [one_div] using hβH
  -- `|u_i(x)| ≤ H + 1`
  have hui : |sgpRaw_BAUGP P.slim i x| ≤ H + 1 := by
    rw [sgpRaw_of_mem_BAUGP P.slim hi]
    have hdist := @KleinerLottApprox.distortion X (WithLp 2 (ℝ × Si.Z))
      (mX.rescale (ρ i)⁻¹ (inv_pos.mpr hri)) _ i _ (β 1) Si.split x
      (show (ρ i)⁻¹ * dist x i < (β 1)⁻¹ by linarith) i
      (show (ρ i)⁻¹ * dist i i < (β 1)⁻¹ by rw [dist_self, mul_zero]; positivity)
    change |dist (sgpSplitMap_BAUGP Si x) (sgpSplitMap_BAUGP Si i) - (ρ i)⁻¹ * dist x i| ≤ β 1 at hdist
    rw [sgpSplitMap_center_BAUGP] at hdist
    have hfst := WithLp.dist_fst_le (sgpSplitMap_BAUGP Si x) (WithLp.toLp 2 ((0 : ℝ), Si.z))
    rw [Real.dist_eq] at hfst
    change |(sgpSplitMap_BAUGP Si x).fst - 0| ≤ _ at hfst
    rw [sub_zero] at hfst
    have hb1 : β 1 ≤ 1 := by
      have : 1 / (2 * (H + 1)) ≤ 1 := by
        rw [div_le_one (by linarith)]
        linarith
      linarith
    linarith [(abs_le.mp hdist).2]
  have hψx : (@KleinerLottApprox.toFun X _ (mX.rescale (ρ i)⁻¹ (inv_pos.mpr hri)) _ i _ (β 1)
      ψ x).fst = realFinOneIso_SGP (sgpRaw_BAUGP P.slim i x) := by
    rw [sgpRaw_of_mem_BAUGP P.slim hi]
    rfl
  have hnorm : ‖(@KleinerLottApprox.toFun X _ (mX.rescale (ρ i)⁻¹ (inv_pos.mpr hri)) _ i _ (β 1)
      ψ x).fst‖ ≤ H + 1 := by
    rw [hψx, LinearIsometryEquiv.norm_map, Real.norm_eq_abs]
    exact hui
  have hmain := hal x (hxR.trans hHτ) hnorm
  rw [hψx, hlin, toLp_const_eq_realFinOneIso_ZERO, ← map_sub, LinearIsometryEquiv.norm_map,
    Real.norm_eq_abs] at hmain
  exact hmain.trans_lt hτE

/-- **LC73 applies at every point of a met reference ball with the ratio `λ = r/ρ(x)`**: the
hypotheses of the field `zero_adapted` at `q = x`, `λ = r/ρ(x)` (closed shell, `0 < λ`,
`Λz ≤ λ`) hold when `20Λz ≤ T`. -/
theorem zero_adapted_ratio_ZERO_BAUGP
    (P : LocalPacketsOnBF X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz U₁ U₂ Ue₁ Ue₂)
    (hΛ : 0 ≤ Λ) (he : e < 1 / 40) (hT : 0 < T) (hΛz : 20 * Λz ≤ T) (p : X) {ℓ : ℝ}
    (hℓ : 0 < ℓ) (hsmall : 2 * (ℓ / T) + 2 * (ℓ * Λ) ≤ 1 / 40) {k : X} (hk : k ∈ P.zero.centres)
    (hmeet : (tsupport (fun y => Calculus.annularCutoff Calculus.cutoffProfile
      ((P.zero.zero k hk).radial y)) ∩ ball p (ℓ * ρ p)).Nonempty) :
    ∀ x ∈ ball p (ℓ * ρ p), (P.zero.zero k hk).radius / 10 ≤ dist k x ∧
      dist k x ≤ 10 * (P.zero.zero k hk).radius ∧ 0 < (P.zero.zero k hk).radius / ρ x ∧
      Λz ≤ (P.zero.zero k hk).radius / ρ x := by
  intro x hx
  obtain ⟨h1, h2, h3⟩ :=
    zero_lc73_inputs_ZERO_BAUGP P hΛ he hT p hℓ hsmall hΛz hk hmeet x hx
  exact ⟨h1, h2, div_pos (P.zero.zero k hk).radius_pos (hρ x), h3⟩

/-- **LC73's twice rescaled geodesics are those of `R⁻²g`.** If `v` reaches `y` along the
intrinsic geodesics of the normalization `(R⁻¹d, R⁻²g)` (velocity `c v`, time `t`, `c t = 1`), it
does so along those of LC73's tensor `λ²(R⁻²g)` with LC73's instances (`(R⁻¹d)` rescaled by `λ`). -/
theorem intrinsicGeodesic_zero_chain_SGP3_BAUGP (g : SmoothRiemannianMetric 𝓘(ℝ, E3) X)
    (hmetric : ∀ a b : X, riemannianEDistOf g a b = ENNReal.ofReal (dist a b)) {R : ℝ}
    (hR : 0 < R) {lam : ℝ} (hlam : 0 < lam) {x y : X} {v : TangentSpace 𝓘(ℝ, E3) x}
    (hv : let hMc : CompleteSpace X := ‹CompleteSpace X›
      letI := mX.rescale R⁻¹ (inv_pos.mpr hR)
      letI := radialScaledBundle g R⁻¹ (inv_pos.mpr hR)
      letI : IsContinuousRiemannianBundle E3 (fun x : X => TangentSpace 𝓘(ℝ, E3) x) :=
        radialScaledContinuous g R⁻¹ (inv_pos.mpr hR)
      letI : IsRiemannianManifold 𝓘(ℝ, E3) X :=
        radialScaledManifold (m := mX) g hmetric R⁻¹ (inv_pos.mpr hR)
      letI : CompleteSpace X := (mX.rescale_completeSpace_iff R⁻¹ (inv_pos.mpr hR)).mpr hMc
      let gR : SmoothRiemannianMetric 𝓘(ℝ, E3) X :=
        scaleMetric (R⁻¹ ^ 2) (pow_pos (inv_pos.mpr hR) 2) g
      have hnR : IsMetricNorm (I := 𝓘(ℝ, E3)) (M := X) gR := isMetricNorm_of_riemannianBundle gR
      ∀ c t : ℝ, c * t = 1 → intrinsicGeodesic gR hnR x (c • v) t = y) :
    let mr := mX.rescale R⁻¹ (inv_pos.mpr hR)
    let gr := scaleMetric (R⁻¹ ^ 2) (pow_pos (inv_pos.mpr hR) 2) g
    let hmr := riemannianEDistOf_scaleMetric_inv_sq_eq_rescale (m := mX) g hmetric hR
    let := mr.rescale lam hlam
    letI := (mr.rescale_completeSpace_iff lam hlam).mpr
      ((mX.rescale_completeSpace_iff R⁻¹ (inv_pos.mpr hR)).mpr
        ((‹_› : @CompleteSpace X mX.toUniformSpace)))
    letI := radialScaledBundle gr lam hlam
    letI := radialScaledContinuous gr lam hlam
    letI := radialScaledManifold (m := mr) gr hmr lam hlam
    let h := scaleMetric (lam ^ 2) (pow_pos hlam 2) gr
    ∀ (hEnorm : IsMetricNorm (I := 𝓘(ℝ, E3)) (M := X) h) (c t : ℝ), c * t = 1 →
      intrinsicGeodesic h hEnorm x (c • v) t = y := by
  obtain ⟨μ, hμ, rfl⟩ : ∃ μ : ℝ, 0 < μ ∧ lam = μ⁻¹ := ⟨lam⁻¹, inv_pos.mpr hlam, (inv_inv lam).symm⟩
  intro mr gr hmr _ h hEnorm c t hct
  have hMc : @CompleteSpace X mX.toUniformSpace := (‹_› : @CompleteSpace X mX.toUniformSpace)
  let _ := mX.rescale R⁻¹ (inv_pos.mpr hR)
  let _ := radialScaledBundle g R⁻¹ (inv_pos.mpr hR)
  let _ : IsContinuousRiemannianBundle E3 (fun x : X => TangentSpace 𝓘(ℝ, E3) x) :=
    radialScaledContinuous g R⁻¹ (inv_pos.mpr hR)
  let _ : IsRiemannianManifold 𝓘(ℝ, E3) X :=
    radialScaledManifold (m := mX) g hmetric R⁻¹ (inv_pos.mpr hR)
  let _ : CompleteSpace X := (mX.rescale_completeSpace_iff R⁻¹ (inv_pos.mpr hR)).mpr hMc
  let _ : SigmaCompactSpace X := ‹SigmaCompactSpace X›
  have hnR : IsMetricNorm (I := 𝓘(ℝ, E3)) (M := X) gr := isMetricNorm_of_riemannianBundle gr
  have key := intrinsicGeodesic_radialScaled_eq (m := mr) gr hnR hμ x (c • v)
  exact (congrFun key t).trans (hv c t hct)

/-- **LC73's adapted coordinate at `x`, in physical form.** At a point `x` of the closed shell of
the zero ball at `k` with `Λz ≤ R₀/ρ(x)`, the field `zero_adapted` with the ratio `λ = R₀/ρ(x)`
gives: the original radial function `η₀` is `(1 + ζ)R₀⁻¹`-Lipschitz on `B(x, ρ(x))`, and for every
`y` with `ρ(x) < d = d(x, y) < ρ(x)/ζ` and every minimizing initial velocity `v` (`g(v, v) = d²`, as
produced by `exists_rescaled_minimizing_SGP2_BAUGP`): `|R₀ d⁻¹ dη₀(v) − (d(k, y) − d(k, x))/d| < ζ`. -/
theorem LocalPacketsOnBF.zero_adapted_phys_SGP3_BAUGP
    (P : LocalPacketsOnBF X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz U₁ U₂ Ue₁ Ue₂)
    {k : X} (hk : k ∈ P.zero.centres) {x : X} (h1 : (P.zero.zero k hk).radius / 10 ≤ dist k x)
    (h2 : dist k x ≤ 10 * (P.zero.zero k hk).radius)
    (hΛz : Λz ≤ (P.zero.zero k hk).radius / ρ x)
    (hdiff : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (P.zero.zero k hk).radial x) :
    (∀ a ∈ ball x (ρ x), ∀ b ∈ ball x (ρ x),
      |(P.zero.zero k hk).radial a - (P.zero.zero k hk).radial b| ≤
        (1 + ζ) * (P.zero.zero k hk).radius⁻¹ * dist a b) ∧
    ∀ y : X, ρ x < dist x y → dist x y < ζ⁻¹ * ρ x → ∀ v : TangentSpace 𝓘(ℝ, E3) x,
      g.inner x v v = dist x y ^ 2 →
      (∀ (R : ℝ) (hR : 0 < R),
        let hMc : CompleteSpace X := ‹CompleteSpace X›
        letI := mX.rescale R⁻¹ (inv_pos.mpr hR)
        letI := radialScaledBundle g R⁻¹ (inv_pos.mpr hR)
        letI : IsContinuousRiemannianBundle E3 (fun x : X => TangentSpace 𝓘(ℝ, E3) x) :=
          radialScaledContinuous g R⁻¹ (inv_pos.mpr hR)
        letI : IsRiemannianManifold 𝓘(ℝ, E3) X :=
          radialScaledManifold (m := mX) g hmetric R⁻¹ (inv_pos.mpr hR)
        letI : CompleteSpace X := (mX.rescale_completeSpace_iff R⁻¹ (inv_pos.mpr hR)).mpr hMc
        let gR : SmoothRiemannianMetric 𝓘(ℝ, E3) X :=
          scaleMetric (R⁻¹ ^ 2) (pow_pos (inv_pos.mpr hR) 2) g
        have hnR : IsMetricNorm (I := 𝓘(ℝ, E3)) (M := X) gR :=
          isMetricNorm_of_riemannianBundle gR
        ∀ c t : ℝ, c * t = 1 → intrinsicGeodesic gR hnR x (c • v) t = y) →
      |(P.zero.zero k hk).radius / dist x y *
          mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x v -
        (dist k y - dist k x) / dist x y| < ζ := by
  have hR : 0 < (P.zero.zero k hk).radius := (P.zero.zero k hk).radius_pos
  have hrx := hρ x
  have hlam0 : 0 < (P.zero.zero k hk).radius / ρ x := div_pos hR hrx
  obtain ⟨hEnorm, Zf, mZ, z, κ, hκ, -, -, hlip, -, -, htest⟩ :=
    P.zero_adapted k hk x h1 h2 _ hlam0 hΛz
  refine ⟨fun a ha b hb => ?_, fun y hy1 hy2 v hvv hgeo => ?_⟩
  · have ha' : (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist a x) < 1 := by
      have : dist a x < ρ x := ha
      have he : (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist a x) =
          dist a x / ρ x := by field_simp
      rw [he, div_lt_one hrx]
      exact this
    have hb' : (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist b x) < 1 := by
      have : dist b x < ρ x := hb
      have he : (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist b x) =
          dist b x / ρ x := by field_simp
      rw [he, div_lt_one hrx]
      exact this
    have hl : |(P.zero.zero k hk).radius / ρ x *
        ((P.zero.zero k hk).radial a - (P.zero.zero k hk).radial x) -
        (P.zero.zero k hk).radius / ρ x *
        ((P.zero.zero k hk).radial b - (P.zero.zero k hk).radial x)| ≤
        (1 + ζ) * ((P.zero.zero k hk).radius / ρ x *
          ((P.zero.zero k hk).radius⁻¹ * dist a b)) := hlip a ha' b hb'
    obtain ⟨R, hRe⟩ : ∃ R, (P.zero.zero k hk).radius = R := ⟨_, rfl⟩
    obtain ⟨η, hηe⟩ : ∃ η, (P.zero.zero k hk).radial = η := ⟨_, rfl⟩
    rw [hRe, hηe] at hl ⊢
    rw [hRe] at hR
    have he : R / ρ x * (η a - η x) - R / ρ x * (η b - η x) = R / ρ x * (η a - η b) := by ring
    rw [he, abs_mul, abs_of_pos (div_pos hR hrx)] at hl
    have he2 : (1 + ζ) * (R / ρ x * (R⁻¹ * dist a b)) = R / ρ x * ((1 + ζ) * R⁻¹ * dist a b) := by
      ring
    rw [he2] at hl
    exact le_of_mul_le_mul_left hl (div_pos hR hrx)
  · have hd : 0 < dist x y := hrx.trans hy1
    have hlamd : 0 < (P.zero.zero k hk).radius / ρ x *
        ((P.zero.zero k hk).radius⁻¹ * dist x y) := by positivity
    have hct : ((P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y))⁻¹ *
        ((P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y)) = 1 :=
      inv_mul_cancel₀ hlamd.ne'
    have hg2 := intrinsicGeodesic_zero_chain_SGP3_BAUGP g hmetric hR hlam0 (hgeo _ hR) hEnorm _ _ hct
    have hu : ((P.zero.zero k hk).radius / ρ x) ^ 2 *
        ((P.zero.zero k hk).radius⁻¹ ^ 2 * g.inner x
          (((P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y))⁻¹ • v)
          (((P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y))⁻¹ • v)) =
        1 := by
      rw [gInner_smul_self, hvv]
      field_simp
    have hyb : (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist y x) <
        ζ⁻¹ := by
      have he : (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist y x) =
          dist x y / ρ x := by rw [dist_comm]; field_simp
      rw [he, div_lt_iff₀ hrx]
      exact hy2
    have hxy : 1 < (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y) := by
      have he : (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y) =
          dist x y / ρ x := by field_simp
      rw [he, one_lt_div hrx]
      exact hy1
    have hxx : (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x x) < 1 := by
      rw [dist_self, mul_zero, mul_zero]
      exact one_pos
    have ht := htest x hxx y hyb hxy _ hu hg2
    rw [hκ y, hκ x] at ht
    have hφ : HasDerivAt (fun t => (P.zero.zero k hk).radius / ρ x *
        (t - (P.zero.zero k hk).radial x)) ((P.zero.zero k hk).radius / ρ x)
        ((P.zero.zero k hk).radial x) := by
      simpa using ((hasDerivAt_id ((P.zero.zero k hk).radial x)).sub_const
        ((P.zero.zero k hk).radial x)).const_mul ((P.zero.zero k hk).radius / ρ x)
    have hψd : mvfderiv 𝓘(ℝ, E3) (fun a => (P.zero.zero k hk).radius / ρ x *
        ((P.zero.zero k hk).radial a - (P.zero.zero k hk).radial x)) x
        (((P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y))⁻¹ • v) =
        (P.zero.zero k hk).radius / ρ x * mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x
        (((P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y))⁻¹ • v) :=
      mvfderiv_comp_hasDerivAt hdiff hφ _
    have ht' : |(P.zero.zero k hk).radius / ρ x * mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x
        (((P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y))⁻¹ • v) -
        ((P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist k y -
          (P.zero.zero k hk).radius⁻¹ * dist k x) -
          (P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist k x -
          (P.zero.zero k hk).radius⁻¹ * dist k x)) /
        ((P.zero.zero k hk).radius / ρ x * ((P.zero.zero k hk).radius⁻¹ * dist x y))| < ζ := by
      rw [← hψd]
      exact ht
    obtain ⟨R, hRe⟩ : ∃ R, (P.zero.zero k hk).radius = R := ⟨_, rfl⟩
    obtain ⟨η, hηe⟩ : ∃ η, (P.zero.zero k hk).radial = η := ⟨_, rfl⟩
    rw [hRe, hηe] at ht' ⊢
    rw [hRe] at hR
    have hsm : mvfderiv 𝓘(ℝ, E3) η x ((R / ρ x * (R⁻¹ * dist x y))⁻¹ • v) =
        (R / ρ x * (R⁻¹ * dist x y))⁻¹ * mvfderiv 𝓘(ℝ, E3) η x v := by
      rw [map_smul, smul_eq_mul]
    rw [hsm] at ht'
    have he : R / ρ x * ((R / ρ x * (R⁻¹ * dist x y))⁻¹ * mvfderiv 𝓘(ℝ, E3) η x v) -
        (R / ρ x * (R⁻¹ * dist k y - R⁻¹ * dist k x) -
          R / ρ x * (R⁻¹ * dist k x - R⁻¹ * dist k x)) / (R / ρ x * (R⁻¹ * dist x y)) =
        R / dist x y * mvfderiv 𝓘(ℝ, E3) η x v - (dist k y - dist k x) / dist x y := by
      field_simp
      ring
    rw [he] at ht'
    exact ht'

/-- **SGP03, zero coordinate, derivatives, at one point.** Under (SB), SGP02's (R0) sign `a₀` at the
zero ball `k` meeting `D_i`, and LC73's inputs at `x ∈ D_i` (closed shell, `Λz ≤ R₀/ρ(x)`,
`.99ρ(i) < ρ(x) < 1.01ρ(i)`): `|s₀ dη₀(w) − a₀ dη_i(w)| ≤ θ√(ρ(i)⁻² g(w, w))`, `s₀ = R₀/ρ(i)`
(the reference lift with sign `a₀`, ONE minimizing segment, LC73's all-direction test at `x`, the
original slim test at `i`, and the saturation step). -/
theorem sgp03_zero_derivative_SGP3_BAUGP
    (P : LocalPacketsOnBF X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz U₁ U₂ Ue₁ Ue₂)
    {θ E δr : ℝ} (hΔ : 1 ≤ Δ) (hθ : 0 < θ) (hθ1 : θ < 1) (hE : 0 ≤ E)
    (hEθ : E < θ ^ 2 / 10 ^ 6) (hδ : 0 < δr) (hδθ : δr < θ ^ 2 / 10 ^ 6) (hσs : 0 < σs)
    (hσθ : σs < θ ^ 2 / 10 ^ 6) (hζ : 0 < ζ) (hζθ : ζ < θ ^ 2 / 10 ^ 6)
    (hζL : ζ < 1 / (100 * (1000000 * Δ)))
    (hβ : β 1 ≤ min (1 / (1000 * (1000000 * Δ))) (δr / 100)) {i : X} (hi : i ∈ P.slim.centres)
    {k : X} (hk : k ∈ P.zero.centres) {a₀ : ℝ} (ha₀ : a₀ = 1 ∨ a₀ = -1)
    (hal : ∀ x ∈ ball i (30 * (1000000 * Δ) * ρ i),
      |(ρ i)⁻¹ * (dist k x - dist k i) - a₀ * sgpRaw_BAUGP P.slim i x| < E)
    {x : X} (hxi : x ∈ ball i (95 / 100 * (1000000 * Δ) * ρ i))
    (h1 : (P.zero.zero k hk).radius / 10 ≤ dist k x)
    (h2 : dist k x ≤ 10 * (P.zero.zero k hk).radius)
    (hΛz : Λz ≤ (P.zero.zero k hk).radius / ρ x)
    (hdiff : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (P.zero.zero k hk).radial x)
    (hρx1 : 99 / 100 * ρ i < ρ x) (hρx2 : ρ x < 101 / 100 * ρ i) (w : TangentSpace 𝓘(ℝ, E3) x) :
    |(P.zero.zero k hk).radius / ρ i * mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x w -
        a₀ * mvfderiv 𝓘(ℝ, E3) (P.slim.centre i hi).coord_BCG2 x w| ≤
      θ * Real.sqrt ((ρ i)⁻¹ ^ 2 * g.inner x w w) := by
  have hri := hρ i
  have hrx := hρ x
  have hΔ0 : 0 < Δ := by linarith
  have hθ2 : θ ^ 2 < 1 := by nlinarith
  have hδ1 : δr < 1 := by nlinarith
  have h106 : (10 : ℝ) ^ 6 * Δ = 1000000 * Δ := by norm_num
  have hLpos : 0 < 1000000 * Δ := by positivity
  have hL6 : (1000000 : ℝ) ≤ 1000000 * Δ := by linarith
  obtain ⟨hZlip, hZtest⟩ := P.zero_adapted_phys_SGP3_BAUGP hk h1 h2 hΛz hdiff
  obtain ⟨y, hy21, hdxy, hay⟩ := sgp03_reference_lift_SGP2_BAUGP P.slim hΔ hδ1 hβ hi hxi ha₀
  obtain ⟨v, hvv, hgeo⟩ := exists_rescaled_minimizing_SGP2_BAUGP g hmetric x y
  obtain ⟨d, hd⟩ : ∃ d, d = dist x y := ⟨_, rfl⟩
  obtain ⟨r, hr⟩ : ∃ r, r = (ρ i)⁻¹ * d := ⟨_, rfl⟩
  have hr1 : 10 * (1000000 * Δ) - 2 * δr < r := by
    rw [hr, hd]; linarith [(abs_lt.mp hdxy).1]
  have hr2 : r < 10 * (1000000 * Δ) - 2 * δr + 4 * δr := by
    rw [hr, hd]; linarith [(abs_lt.mp hdxy).2]
  have hD : 0 < 10 * (1000000 * Δ) - 2 * δr := by nlinarith
  have hrpos : 0 < r := hD.trans hr1
  have hdeq : d = ρ i * r := by rw [hr]; field_simp
  -- the original slim test at `i` along the minimizing segment
  have hxLi : x ∈ ball i (10 ^ 6 * Δ * ρ i) := by
    rw [h106]
    refine ball_subset_ball ?_ hxi
    have := mul_mul_le_mul_mul_SGP2 (k := 95 / 100) (k' := 1) (by norm_num) hLpos.le hri.le
    linarith
  have hσ24 : σs * 24 ≤ 1 := by nlinarith
  have hyLi : y ∈ ball i (10 ^ 6 * Δ / σs * ρ i) := by
    rw [h106]
    refine ball_subset_ball ?_ hy21
    exact mul_le_mul_of_nonneg_right
      (sgp03_num_outer_SGP2 hLpos.le hσs (by linarith)) hri.le
  have hxyi : 10 ^ 6 * Δ * ρ i < dist x y := by
    rw [h106, ← hd, hdeq]
    exact sgp03_num_far_SGP2 hL6 hδ1 hri (by linarith) hr1
  have Ti := (P.slim.centre i hi).test_phys_SGP2_BAUGP hxLi hyLi hxyi hvv (hgeo (ρ i) hri)
  rw [← hd, ← hr] at Ti
  -- LC73's test at `x` along the SAME segment
  obtain ⟨hy1, hy2⟩ := sgp03_zero_range_SGP3 hL6 hδ1 hζ hζL hri hρx1 hρx2 hr1 hr2 hdeq
  rw [hd] at hy1 hy2
  have Tz := hZtest y hy1 hy2 v hvv hgeo
  rw [← hd] at Tz
  clear hZtest hgeo
  -- (R0) at `x` and `y`
  have hRx := hal x (ball_subset_ball
    (mul_mul_le_mul_mul_SGP2 (by norm_num) hLpos.le hri.le) hxi)
  have hRy := hal y (ball_subset_ball
    (mul_mul_le_mul_mul_SGP2 (by norm_num) hLpos.le hri.le) hy21)
  simp only [sgpRaw_of_mem_BAUGP P.slim hi] at hRx hRy hay
  obtain ⟨uix, huix⟩ : ∃ u, u = (sgpSplitMap_BAUGP (P.slim.centre i hi) x).fst := ⟨_, rfl⟩
  obtain ⟨uiy, huiy⟩ : ∃ u, u = (sgpSplitMap_BAUGP (P.slim.centre i hi) y).fst := ⟨_, rfl⟩
  rw [← huix] at hRx Ti
  rw [← huiy] at hRy Ti
  rw [← huix, ← huiy] at hay
  have hinc : |(ρ i)⁻¹ * (dist k y - dist k x) - a₀ * (uiy - uix)| < 2 * E := by
    have he : (ρ i)⁻¹ * (dist k y - dist k x) - a₀ * (uiy - uix) =
        ((ρ i)⁻¹ * (dist k y - dist k i) - a₀ * uiy) -
          ((ρ i)⁻¹ * (dist k x - dist k i) - a₀ * uix) := by ring
    rw [he]
    calc _ ≤ |(ρ i)⁻¹ * (dist k y - dist k i) - a₀ * uiy| +
          |(ρ i)⁻¹ * (dist k x - dist k i) - a₀ * uix| := abs_sub _ _
      _ < E + E := add_lt_add hRy hRx
      _ = 2 * E := by ring
  -- the saturation step in the normalized form `ρ(i)⁻² g` at `x`
  obtain ⟨ε, hεdef, hε0, hσε, hε1, hεθ⟩ : ∃ ε : ℝ,
      ε = max σs ζ + (3 * δr + 2 * E) / (10 * (1000000 * Δ) - 2 * δr) ∧ 0 ≤ ε ∧
        max σs ζ ≤ ε ∧ ε ≤ 1 / 2 ∧ 2 * ε + 12 * Real.sqrt ε ≤ θ :=
    ⟨_, rfl, sgp03_budget_SGP2 hθ hθ1 (le_max_of_le_left hσs.le) (max_lt hσθ hζθ) hδ.le hδθ hE
      hEθ hL6⟩
  have hσε' : σs ≤ ε := (le_max_left _ _).trans hσε
  have hζε : ζ ≤ ε := (le_max_right _ _).trans hσε
  let B : E3 →L[ℝ] E3 →L[ℝ] ℝ := ((ρ i)⁻¹ ^ 2) • (g.inner x : E3 →L[ℝ] E3 →L[ℝ] ℝ)
  have hB : ∀ z z' : E3, B z z' = (ρ i)⁻¹ ^ 2 * g.inner x z z' := fun _ _ => rfl
  have hsqrt : ∀ z : E3, Real.sqrt (B z z) = (ρ i)⁻¹ * Real.sqrt (g.inner x z z) := by
    intro z
    rw [hB, Real.sqrt_mul (by positivity), Real.sqrt_sq (by positivity)]
  have hsymm : ∀ z z' : E3, B z z' = B z' z := by
    intro z z'
    rw [hB, hB, g.symm x z z']
  have hpos : ∀ z : E3, 0 ≤ B z z := fun z => by
    rw [hB]
    exact mul_nonneg (by positivity) (gInner_self_nonneg g x z)
  have hR0 : 0 < (P.zero.zero k hk).radius := (P.zero.zero k hk).radius_pos
  let f : E3 →L[ℝ] ℝ := ((P.zero.zero k hk).radius / ρ i) •
    (mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x : E3 →L[ℝ] ℝ)
  let h : E3 →L[ℝ] ℝ := a₀ • (mvfderiv 𝓘(ℝ, E3) (P.slim.centre i hi).coord_BCG2 x : E3 →L[ℝ] ℝ)
  have hfapp : ∀ z : E3, f z = (P.zero.zero k hk).radius / ρ i *
      mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x z := fun _ => rfl
  have happ : ∀ z : E3, h z = a₀ * mvfderiv 𝓘(ℝ, E3) (P.slim.centre i hi).coord_BCG2 x z :=
    fun _ => rfl
  have haabs : |a₀| = 1 := by rcases ha₀ with rfl | rfl <;> norm_num
  have hs0 : 0 < (P.zero.zero k hk).radius / ρ i := div_pos hR0 hri
  have hf : ∀ z, |f z| ≤ (1 + ε) * Real.sqrt (B z z) := by
    intro z
    have hlip' : ∀ a ∈ ball x (ρ x), ∀ b ∈ ball x (ρ x),
        |(P.zero.zero k hk).radial a - (P.zero.zero k hk).radial b| ≤
          (1 + ζ) * (P.zero.zero k hk).radius⁻¹ * dist a b := hZlip
    have hb := abs_mvfderiv_le_of_lipschitzOn_riem g hmetric isOpen_ball (mem_ball_self hrx)
      hdiff hlip' z
    have hg0 := Real.sqrt_nonneg (g.inner x z z)
    rw [hfapp, abs_mul, abs_of_pos hs0, hsqrt]
    have hk' : (P.zero.zero k hk).radius / ρ i *
        ((1 + ζ) * (P.zero.zero k hk).radius⁻¹ * Real.sqrt (g.inner x z z)) =
        (1 + ζ) * ((ρ i)⁻¹ * Real.sqrt (g.inner x z z)) := by field_simp
    calc (P.zero.zero k hk).radius / ρ i *
          |mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x z|
        ≤ (P.zero.zero k hk).radius / ρ i *
          ((1 + ζ) * (P.zero.zero k hk).radius⁻¹ * Real.sqrt (g.inner x z z)) :=
          mul_le_mul_of_nonneg_left hb hs0.le
      _ = (1 + ζ) * ((ρ i)⁻¹ * Real.sqrt (g.inner x z z)) := hk'
      _ ≤ (1 + ε) * ((ρ i)⁻¹ * Real.sqrt (g.inner x z z)) := by gcongr
  have hh : ∀ z, |h z| ≤ (1 + ε) * Real.sqrt (B z z) := by
    intro z
    have hb := (P.slim.centre i hi).abs_mvfderiv_le_SGP2_BAUGP hσs.le hxLi z
    rw [happ, abs_mul, haabs, one_mul, hsqrt]
    calc |mvfderiv 𝓘(ℝ, E3) (P.slim.centre i hi).coord_BCG2 x z|
        ≤ (1 + σs) * (ρ i)⁻¹ * Real.sqrt (g.inner x z z) := hb
      _ = (1 + σs) * ((ρ i)⁻¹ * Real.sqrt (g.inner x z z)) := by ring
      _ ≤ (1 + ε) * ((ρ i)⁻¹ * Real.sqrt (g.inner x z z)) := by gcongr
  have hcr : ρ i / d = r⁻¹ := by rw [hr]; field_simp
  have hw : B ((ρ i / d) • v) ((ρ i / d) • v) = 1 := by
    change (ρ i)⁻¹ ^ 2 * g.inner x ((ρ i / d) • v) ((ρ i / d) • v) = 1
    rw [gInner_smul_self, hvv, ← hd, hdeq]
    field_simp
  have hV : 10 * (1000000 * Δ) - 2 * δr + δr < a₀ * (uiy - uix) := by linarith
  have hfw : 1 - ε ≤ f ((ρ i / d) • v) := by
    change 1 - ε ≤ (P.zero.zero k hk).radius / ρ i *
      mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x ((ρ i / d) • v)
    rw [map_smul, smul_eq_mul]
    have hd0 : 0 < d := by rw [hdeq]; positivity
    have he : (P.zero.zero k hk).radius / ρ i *
        (ρ i / d * mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x v) =
        (P.zero.zero k hk).radius / d * mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x v := by
      field_simp
    rw [he]
    have hl := sgp03_lower_zero_SGP3 hri hD hr1 hr2 hdeq Tz hinc hV
    have hq0 : 0 ≤ (3 * δr + 2 * E) / (10 * (1000000 * Δ) - 2 * δr) :=
      div_nonneg (by linarith) hD.le
    rw [hεdef]
    have := le_max_right σs ζ
    linarith
  have hhw : 1 - ε ≤ h ((ρ i / d) • v) := by
    change 1 - ε ≤ a₀ * mvfderiv 𝓘(ℝ, E3) (P.slim.centre i hi).coord_BCG2 x ((ρ i / d) • v)
    rw [map_smul, smul_eq_mul, hcr]
    have hl := sgp03_lower_i_SGP2 ha₀ hD hr1 hr2 hE Ti hV
    rw [hεdef]
    have := le_max_left σs ζ
    linarith
  have key := abs_sub_le_of_form_saturation_SGP2 B hsymm hpos f h hε0 hε1 hf hh _ hw hfw hhw w
  have key' : |(P.zero.zero k hk).radius / ρ i *
      mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x w -
      a₀ * mvfderiv 𝓘(ℝ, E3) (P.slim.centre i hi).coord_BCG2 x w| ≤
      (2 * ε + 12 * Real.sqrt ε) * Real.sqrt ((ρ i)⁻¹ ^ 2 * g.inner x w w) := key
  exact key'.trans (mul_le_mul_of_nonneg_right hεθ (Real.sqrt_nonneg _))

/-- **SGP03, zero coordinate, values, at one point** (LC67's GLOBAL difference-Lipschitz bound of
the radial function, SGP02's (R0) and LFR19's slim value tolerance): at `x ∈ B(i, 10⁶Δρ(i))`,
`|U₀(x) − λ₀(η_i(x))| < εr ρ(i)⁻¹ d(i, x) + E + vs` (`U₀ = s₀η₀`, `λ₀(a) = a₀a + U₀(p_i)`; the error
is NOT the uncentred radial value error times `s₀`). -/
theorem sgp03_zero_value_SGP3_BAUGP
    (P : LocalPacketsOnBF X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz U₁ U₂ Ue₁ Ue₂)
    {i : X} (hi : i ∈ P.slim.centres) {k : X} (hk : k ∈ P.zero.centres) {a₀ E vs : ℝ}
    (ha₀ : a₀ = 1 ∨ a₀ = -1)
    (hal : ∀ x ∈ ball i (30 * (1000000 * Δ) * ρ i),
      |(ρ i)⁻¹ * (dist k x - dist k i) - a₀ * sgpRaw_BAUGP P.slim i x| < E)
    (hval : ∀ x ∈ ball i (10 ^ 6 * Δ * ρ i),
      |(P.slim.centre i hi).coord_BCG2 x - sgpRaw_BAUGP P.slim i x| < vs)
    (hΔ : 0 ≤ Δ) {x : X} (hx : x ∈ ball i (10 ^ 6 * Δ * ρ i)) :
    |(P.zero.zero k hk).radius / ρ i * (P.zero.zero k hk).radial x -
        (a₀ * (P.slim.centre i hi).coord_BCG2 x +
          (P.zero.zero k hk).radius / ρ i * (P.zero.zero k hk).radial i)| <
      εr * ((ρ i)⁻¹ * dist x i) + E + vs := by
  have hri := hρ i
  have hR := (P.zero.zero k hk).radius_pos
  obtain ⟨-, -, -, -, hdl, -⟩ := (P.zero.zero k hk).radial_spec
  have hd1 := hdl x i
  rw [@Metric.infDist_singleton X (mX.rescale (P.zero.zero k hk).radius⁻¹
      (inv_pos.mpr (P.zero.zero k hk).radius_pos)).toPseudoMetricSpace x,
    @Metric.infDist_singleton X (mX.rescale (P.zero.zero k hk).radius⁻¹
      (inv_pos.mpr (P.zero.zero k hk).radius_pos)).toPseudoMetricSpace i] at hd1
  have hd2 : |((P.zero.zero k hk).radial x -
      (P.zero.zero k hk).radius⁻¹ * dist x (P.zero.zero k hk).center) -
      ((P.zero.zero k hk).radial i -
      (P.zero.zero k hk).radius⁻¹ * dist i (P.zero.zero k hk).center)| ≤
      εr * ((P.zero.zero k hk).radius⁻¹ * dist x i) := hd1
  rw [P.zero.zero_center k hk, dist_comm x k, dist_comm i k] at hd2
  have hx30 : x ∈ ball i (30 * (1000000 * Δ) * ρ i) := by
    refine ball_subset_ball ?_ hx
    have h := mul_mul_le_mul_mul_SGP2 (k := 1) (k' := 30) (L := 1000000 * Δ) (by norm_num)
      (by positivity) hri.le
    norm_num at h ⊢
    linarith
  have h2 := hal x hx30
  have h3 := hval x hx
  have haabs : |a₀| = 1 := by rcases ha₀ with rfl | rfl <;> norm_num
  obtain ⟨R, hRe⟩ : ∃ R, (P.zero.zero k hk).radius = R := ⟨_, rfl⟩
  obtain ⟨η, hηe⟩ : ∃ η, (P.zero.zero k hk).radial = η := ⟨_, rfl⟩
  rw [hRe, hηe] at hd2 ⊢
  rw [hRe] at hR
  -- the first error: `s₀` times the radial difference-Lipschitz bound
  have hA : |R / ρ i * (η x - η i) - (ρ i)⁻¹ * (dist k x - dist k i)| ≤
      εr * ((ρ i)⁻¹ * dist x i) := by
    have he : R / ρ i * (η x - η i) - (ρ i)⁻¹ * (dist k x - dist k i) =
        R / ρ i * ((η x - R⁻¹ * dist k x) - (η i - R⁻¹ * dist k i)) := by
      field_simp
      ring
    have he2 : εr * ((ρ i)⁻¹ * dist x i) = R / ρ i * (εr * (R⁻¹ * dist x i)) := by field_simp
    rw [he, he2, abs_mul, abs_of_pos (div_pos hR hri)]
    exact mul_le_mul_of_nonneg_left hd2 (div_pos hR hri).le
  have hC : |a₀ * sgpRaw_BAUGP P.slim i x - a₀ * (P.slim.centre i hi).coord_BCG2 x| < vs := by
    rw [← mul_sub, abs_mul, haabs, one_mul, abs_sub_comm]
    exact h3
  have he : R / ρ i * η x - (a₀ * (P.slim.centre i hi).coord_BCG2 x + R / ρ i * η i) =
      (R / ρ i * (η x - η i) - (ρ i)⁻¹ * (dist k x - dist k i)) +
        ((ρ i)⁻¹ * (dist k x - dist k i) - a₀ * sgpRaw_BAUGP P.slim i x) +
        (a₀ * sgpRaw_BAUGP P.slim i x - a₀ * (P.slim.centre i hi).coord_BCG2 x) := by ring
  rw [he]
  calc _ ≤ |R / ρ i * (η x - η i) - (ρ i)⁻¹ * (dist k x - dist k i)| +
        |(ρ i)⁻¹ * (dist k x - dist k i) - a₀ * sgpRaw_BAUGP P.slim i x| +
        |a₀ * sgpRaw_BAUGP P.slim i x - a₀ * (P.slim.centre i hi).coord_BCG2 x| := abs_add_three _ _ _
    _ < εr * ((ρ i)⁻¹ * dist x i) + E + vs := by
        have := add_lt_add_of_le_of_lt hA h2
        linarith

/-- **SGP03, the zero coordinate, on the actual merged family.** For `Δ ≥ 1`, the exclusion
quality `β₂`, `0 < θ < 1` and `0 < E < θ²/10⁶` there are a curvature radius `Lc` and a raw quality
`η₀` such that for EVERY actual `P : LocalChartPacketsRVZ … vs ζ Λz` with `β 2 = β₂`, `β 1 ≤ η₀`,
`Lc ≤ Lmax`, `10⁶ΔΛ < 10⁻⁵`, `e < 1/40`, `T ≥ 1600L`, `20Λz ≤ T` and the (SB) budgets
`0 < σs, ζ < θ²/10⁶`, `ζ < 1/(100L)`, `vs < θ/100`, `εr < θ/(100L)`: at every slim centre `i` whose
`D_i` meets the support of the zero ball at `p₀ = k`, ONE sign `a₀ = ±1` has SGP02's (R0) on
`B(i, 30Lρ(i))` and, on ALL of `D_i`, the derivative bound `|s₀ dη₀(w) − a₀ dη_i(w)| ≤
θ√(ρ(i)⁻² g(w, w))` and the value bound `|U₀ − λ₀(η_i)| < θ` (`s₀ = R₀/ρ(i)`, `U₀ = s₀η₀`,
`λ₀(a) = a₀a + U₀(p_i)`). -/
theorem sgp03_zero_row_BAUGP {Δ β₂ θ E : ℝ} (hΔ : 1 ≤ Δ) (hβ₂ : 0 < β₂) (hβ₂1 : β₂ < 1) (hθ : 0 < θ)
    (hθ1 : θ < 1) (hE : 0 < E) (hEθ : E < θ ^ 2 / 10 ^ 6) :
    ∃ Lc η₀ : ℝ, 0 < Lc ∧ 0 < η₀ ∧
      ∀ (X : Type) [MetricSpace X] [ChartedSpace E3 X] [IsManifold 𝓘(ℝ, E3) ∞ X]
        [CompleteSpace X] [SigmaCompactSpace X] (g : SmoothRiemannianMetric 𝓘(ℝ, E3) X)
        (hmetric : ∀ a b : X, riemannianEDistOf g a b = ENNReal.ofReal (dist a b))
        (ρ : X → ℝ) (hρ : ∀ p, 0 < ρ p) (Λ : ℝ) (β : ℕ → ℝ) (σs : ℝ) (K : ℕ)
        (σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz : ℝ)
        (U₁ U₂ Ue₁ Ue₂ : Set X)
        (P : LocalPacketsOnBF X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz U₁ U₂ Ue₁ Ue₂),
        β 2 = β₂ → β 1 ≤ η₀ → Lc ≤ Lmax → 0 ≤ Λ → 1000000 * Δ * Λ < 1 / 100000 →
        e < 1 / 40 → 1600 * (1000000 * Δ) ≤ T → 20 * Λz ≤ T →
        0 < σs → σs < θ ^ 2 / 10 ^ 6 → vs < θ / 100 →
        0 < ζ → ζ < θ ^ 2 / 10 ^ 6 → ζ < 1 / (100 * (1000000 * Δ)) →
        εr < θ / (100 * (1000000 * Δ)) →
        ∀ i (hi : i ∈ P.slim.centres), ∀ k (hk : k ∈ P.zero.centres),
          (tsupport (fun y => Calculus.annularCutoff Calculus.cutoffProfile
            ((P.zero.zero k hk).radial y)) ∩ ball i (95 / 100 * (1000000 * Δ) * ρ i)).Nonempty →
          ∃ a₀ : ℝ, (a₀ = 1 ∨ a₀ = -1) ∧
            (∀ x ∈ ball i (30 * (1000000 * Δ) * ρ i),
              |(ρ i)⁻¹ * (dist k x - dist k i) - a₀ * sgpRaw_BAUGP P.slim i x| < E) ∧
            (∀ x ∈ ball i (95 / 100 * (1000000 * Δ) * ρ i), ∀ w : TangentSpace 𝓘(ℝ, E3) x,
              |(P.zero.zero k hk).radius / ρ i *
                  mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial x w -
                a₀ * mvfderiv 𝓘(ℝ, E3) (P.slim.centre i hi).coord_BCG2 x w| ≤
                θ * Real.sqrt ((ρ i)⁻¹ ^ 2 * g.inner x w w)) ∧
            ∀ x ∈ ball i (95 / 100 * (1000000 * Δ) * ρ i),
              |(P.zero.zero k hk).radius / ρ i * (P.zero.zero k hk).radial x -
                (a₀ * (P.slim.centre i hi).coord_BCG2 x +
                  (P.zero.zero k hk).radius / ρ i * (P.zero.zero k hk).radial i)| < θ := by
  obtain ⟨Lc, η₀, hLc, hη₀, hR0⟩ := sgp02_zero_supplier_ZERO_BAUGP hΔ hβ₂ hβ₂1 hE
  have hθ2 : θ ^ 2 < 1 := by nlinarith
  have hΔ0 : 0 < Δ := by linarith
  have hδr0 : (0 : ℝ) < θ ^ 2 / (2 * 10 ^ 6) := by positivity
  have hδrθ : θ ^ 2 / (2 * 10 ^ 6) < θ ^ 2 / 10 ^ 6 := by
    apply div_lt_div_of_pos_left (by positivity) (by positivity) (by norm_num)
  have hEθ' : E < θ / 100 := by nlinarith
  refine ⟨Lc, min η₀ (min (1 / (1000 * (1000000 * Δ))) (θ ^ 2 / (2 * 10 ^ 6) / 100)), hLc,
    lt_min hη₀ (lt_min (by positivity) (by positivity)), ?_⟩
  intro X _ _ _ _ _ g hmetric ρ hρ Λ β σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz U₁ U₂
    Ue₁ Ue₂ P hβ2 hβ1 hLmax hΛ hLΛ he hT hΛzT hσs hσθ hvθ hζ hζθ hζL hεr i hi k hk hmeet
  have hβη : β 1 ≤ η₀ := hβ1.trans (min_le_left _ _)
  have hβref : β 1 ≤ min (1 / (1000 * (1000000 * Δ))) (θ ^ 2 / (2 * 10 ^ 6) / 100) :=
    hβ1.trans (min_le_right _ _)
  obtain ⟨a₀, ha₀, hal⟩ := hR0 X g hmetric ρ hρ Λ β σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T
    V vs ζ Λz U₁ U₂ Ue₁ Ue₂ P hβ2 hβη hLmax hΛ hLΛ he hT i hi k hk hmeet
  obtain ⟨hT0, hℓ, hsmall⟩ := sgp01_zero_smallness_ZERO hΔ hLΛ hT
  obtain ⟨-, O, hOo, hOsub, hOc⟩ :=
    (zero_meeting_clauses_ZERO_BAUGP P hΛ he hT0 i hℓ hsmall).2 k hk hmeet
  have hri := hρ i
  refine ⟨a₀, ha₀, hal, fun x hx w => ?_, fun x hx => ?_⟩
  · obtain ⟨h1, h2, -, h4⟩ :=
      zero_adapted_ratio_ZERO_BAUGP P hΛ he hT0 hΛzT i hℓ hsmall hk hmeet x hx
    have hdiff : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (P.zero.zero k hk).radial x :=
      (hOc.contMDiffAt (hOo.mem_nhds (hOsub hx))).mdifferentiableAt (by simp)
    have hlipρ : |ρ x - ρ i| ≤ Λ * dist x i := by
      have h := P.lipschitz_scale.dist_le_mul x i
      rwa [Real.coe_toNNReal _ hΛ, Real.dist_eq] at h
    obtain ⟨hρ1, hρ2⟩ := sgp03_rho_ratio_SGP3 hri hΛ hlipρ hx hLΛ
    exact sgp03_zero_derivative_SGP3_BAUGP P hΔ hθ hθ1 hE.le hEθ hδr0 hδrθ hσs
      hσθ hζ hζθ hζL hβref hi hk ha₀ hal hx h1 h2 h4 hdiff hρ1 hρ2 w
  · have hxL : x ∈ ball i (10 ^ 6 * Δ * ρ i) := by
      refine ball_subset_ball ?_ hx
      have := mul_mul_le_mul_mul_SGP2 (k := 95 / 100) (k' := 1) (L := 1000000 * Δ) (by norm_num)
        (by positivity) hri.le
      norm_num at this ⊢
      linarith
    have hv := sgp03_zero_value_SGP3_BAUGP P hi hk ha₀ hal
      (fun x hx => P.slim_value_sgpRaw_BAUGP hi hx) hΔ0.le hxL
    have ht : (ρ i)⁻¹ * dist x i < 95 / 100 * (1000000 * Δ) :=
      inv_mul_dist_lt_of_mem_ball_LC87 hri hx
    have hb := sgp03_zero_budget_SGP3 (L := 1000000 * Δ) hθ (by positivity)
      (by positivity) (ht.trans_le (by nlinarith)) hεr hEθ' hvθ
    exact hv.trans hb

