    have hjl' : j.1 ∈ egpEdgeList_BAUGP P.toLocalPacketsOnB i := hl.resolve_left hji
    obtain ⟨ha, hEC⟩ := hEe j.1 hjl'
    have hsg : sgn (.inr (.inr (.inl j))) = aE j.1 := by
      rw [hsgn]; exact signClamp_of_sign_KC4 ha
    have hσ : |sgn (.inr (.inr (.inl j)))| ≤ 1 := by
      rw [hsgn]; exact abs_egpTagSign_le_KC4_BAUGP _ P.zero aS aE aZ _
    have hval := (egp06_edge_tag_KC4_BAUGP P.toLocalPacketsOnB P.zero hΔ hmargin sgn c j hji hjl'
      hs1.le hθ1 hσ hxj ht 0
      (by rw [hsg, hcdef]; exact (hEC x hxD).1)
      (by rw [map_zero, map_zero, mul_zero, mul_zero, sub_zero, abs_zero]; exact hθ0)
      (by rw [map_zero, abs_zero]; norm_num)).1
    refine ⟨hval, fun w hw => ?_⟩
    exact (egp06_edge_tag_KC4_BAUGP P.toLocalPacketsOnB P.zero hΔ hmargin sgn c j hji hjl' hs1.le
        hθ1
      hσ hxj ht w
      (by rw [hsg, hcdef]; exact (hEC x hxD).1) (by rw [hsg]; exact (hEC x hxD).2 w hw)
      (hda w hw)).2
  · -- zero tag
    have hkc : k.1 ∈ P.zero.centres := (Set.Finite.mem_toFinset _).mp k.2
    refine ⟨fun hl => ?_, fun hl => Or.inl fun hxs => hl ⟨hkc, x, hxs, hxD⟩⟩
    have hkl : k.1 ∈ zeroMeetingList_BPE P.zero i (20 * Δ) := hl
    obtain ⟨hk', hmeet⟩ := hkl
    obtain ⟨hshell, O, hO, hDO, hsm⟩ := hcl k.1 hk' hmeet
    have hrad : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (P.zero.zero k.1 hkc).radial x :=
      (hsm.contMDiffAt (hO.mem_nhds (hDO hxD))).mdifferentiableAt (by simp)
    have hs : 1 ≤ (P.zero.zero k.1 hkc).radius / ρ i :=
      hT20.trans ((hshell i (mem_ball_self (by positivity))).2.2.2.2)
    obtain ⟨ha, hEC⟩ := hEz k.1 hkc hmeet
    have hsg : sgn (.inr (.inr (.inr (.inl k)))) = aZ k.1 := by
      rw [hsgn]; exact signClamp_of_sign_KC4 ha
    have hσ : |sgn (.inr (.inr (.inr (.inl k))))| ≤ 1 :=
      by
      rw [hsgn]; exact abs_egpTagSign_le_KC4_BAUGP _ P.zero aS aE aZ _
    have hval := (egp06_zero_tag_KC4_BAUGP P.toLocalPacketsOnB P.zero sgn c k hl hs hθ1 hσ hrad 0
      (by rw [hsg, hcdef]; exact (hEC x hxD).1)
      (by rw [map_zero, map_zero, mul_zero, mul_zero, sub_zero, abs_zero]; exact hθ0)
      (by rw [map_zero, abs_zero]; norm_num)).1
    refine ⟨hval, fun w hw => ?_⟩
    exact (egp06_zero_tag_KC4_BAUGP P.toLocalPacketsOnB P.zero sgn c k hl hs hθ1 hσ hrad w
      (by rw [hsg, hcdef]; exact (hEC x hxD).1) (by rw [hsg]; exact (hEC x hxD).2 w hw)
      (hda w hw)).2
  · exact ⟨fun hl => hl.elim, fun _ => Or.inr fun h =>
      Bool.false_ne_true (Finset.mem_filter.mp h).2⟩

open Classical in
/-- **EGP06 (EG) at one point, kernel form.** Under EGP04's (EC) on `D_i` (hypotheses `hEe, hEs,
hEz` with signs `aS, aE, aZ`), at every core point `x` of the edge reference `i`
(`x ∈ B(i, 100Δρ_i)`, `|η_i(x)| ≤ 8Δ`, `t(x) ≤ 8Δ`): with the model
`Φ_i = egpModelGraph_BAUGP L Z i sgn c` (`sgn = egpTagSign_KC4_BAUGP`, `c = egpTagShift_KC4_BAUGP`),
`‖R_i⁻¹π₂𝓔⁰(x) − Φ_i(η_i(x))‖ ≤ (N† + 2)·4Bθ` and, on every `ρ_i⁻²g`-unit vector `w`,
`‖R_i⁻¹d(π₂𝓔⁰)_x(w) − DΦ_i(η_i(x))(dη_i(w))‖ ≤ (N† + 2)·4Bθ`, `B = 50(P† + 1)`. -/
theorem egp06_point_KC4_BAUGP
    (P : LocalPacketsOnBF X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs
        ζ Λz U₁ U₂ Ue₁ Ue₂)
    (hΛ : 0 ≤ Λ) (hΔ : 1 ≤ Δ) (hLΛ : 1000000 * Δ * Λ < 1 / 100000) (hμ : μ ≤ 1 / 100)
    (hτ : τ ≤ 1 / 100) (he : e < 1 / 40) (hT : 1600 * (1000000 * Δ) ≤ T) (hσc : σc ≤ 1)
    {θ : ℝ} (hθ0 : 0 < θ) (hθ1 : θ ≤ 1) {i : X} (hi : i ∈ P.edgeB.centres)
    (aS aE aZ : X → ℝ)
    (hEe : ∀ j ∈ egpEdgeList_BAUGP P.toLocalPacketsOnB i, (aE j = 1 ∨ aE j = -1) ∧
      ∀ y ∈ ball i (20 * Δ * ρ i),
        |ρ j / ρ i * P.edgeB.coord_BAUGA j y - (aE j * P.edgeB.coord_BAUGA i y + ρ j / ρ i *
            egpRaw_BAUGP P.edgeB j i)| <
            θ ∧
          ∀ w : TangentSpace 𝓘(ℝ, E3) y, (ρ i)⁻¹ ^ 2 * g.inner y w w = 1 →
            |ρ j / ρ i * mvfderiv 𝓘(ℝ, E3) (P.edgeB.coord_BAUGA j) y w -
              aE j * mvfderiv 𝓘(ℝ, E3) (P.edgeB.coord_BAUGA i) y w| < θ)
    (hEs : ∀ j (hj : j ∈ P.slim.centres),
      (tsupport (P.slim.cutoff_BCNT j) ∩ ball i (20 * Δ * ρ i)).Nonempty →
      (aS j = 1 ∨ aS j = -1) ∧ ∀ y ∈ ball i (20 * Δ * ρ i),
        |ρ j / ρ i * (P.slim.centre j hj).coord_BCG2 y -
            (aS j * P.edgeB.coord_BAUGA i y + ρ j / ρ i * sgpRaw_BAUGP P.slim j i)| < θ ∧
          ∀ w : TangentSpace 𝓘(ℝ, E3) y, (ρ i)⁻¹ ^ 2 * g.inner y w w = 1 →
            |ρ j / ρ i * mvfderiv 𝓘(ℝ, E3) (P.slim.centre j hj).coord_BCG2 y w -
              aS j * mvfderiv 𝓘(ℝ, E3) (P.edgeB.coord_BAUGA i) y w| < θ)
    (hEz : ∀ k (hk : k ∈ P.zero.centres),
      (tsupport (fun y => annularCutoff cutoffProfile ((P.zero.zero k hk).radial y)) ∩
        ball i (20 * Δ * ρ i)).Nonempty →
      (aZ k = 1 ∨ aZ k = -1) ∧ ∀ y ∈ ball i (20 * Δ * ρ i),
        |(P.zero.zero k hk).radius / ρ i * (P.zero.zero k hk).radial y -
            (aZ k * P.edgeB.coord_BAUGA i y +
              (P.zero.zero k hk).radius / ρ i * (P.zero.zero k hk).radial i)| < θ ∧
          ∀ w : TangentSpace 𝓘(ℝ, E3) y, (ρ i)⁻¹ ^ 2 * g.inner y w w = 1 →
            |(P.zero.zero k hk).radius / ρ i * mvfderiv 𝓘(ℝ, E3) (P.zero.zero k hk).radial y w -
              aZ k * mvfderiv 𝓘(ℝ, E3) (P.edgeB.coord_BAUGA i) y w| < θ)
    {x : X} (hx : x ∈ ball i (100 * Δ * ρ i)) (hη : |P.edgeB.coord_BAUGA i x| ≤ 8 * Δ)
    (ht : cgpHeight_BAUGP P.toLocalPacketsOnB x ≤ 8 * Δ) :
    ‖(ρ i)⁻¹ • cgpProjMap_BPS P.toLocalPacketsOnB P.zero (cgpQ2Tags_BPE P.toLocalPacketsOnB P.zero)
        x -
        egpModelGraph_BAUGP P.toLocalPacketsOnB P.zero i
          (egpTagSign_KC4_BAUGP P.toLocalPacketsOnB P.zero aS aE aZ)
          (egpTagShift_KC4_BAUGP P.toLocalPacketsOnB P.zero i) (P.edgeB.coord_BAUGA i x)‖ ≤
        (egp02ListBound + 2) * (4 * (50 * (egpProfileConst + 1)) * θ) ∧
      ∀ w : TangentSpace 𝓘(ℝ, E3) x, (ρ i)⁻¹ ^ 2 * g.inner x w w = 1 →
        ‖(ρ i)⁻¹ • mvfderiv 𝓘(ℝ, E3)
            (cgpProjMap_BPS P.toLocalPacketsOnB P.zero (cgpQ2Tags_BPE P.toLocalPacketsOnB P.zero))
                x w -
          fderiv ℝ (egpModelGraph_BAUGP P.toLocalPacketsOnB P.zero i
            (egpTagSign_KC4_BAUGP P.toLocalPacketsOnB P.zero aS aE aZ)
            (egpTagShift_KC4_BAUGP P.toLocalPacketsOnB P.zero i)) (P.edgeB.coord_BAUGA i x)
            (mvfderiv 𝓘(ℝ, E3) (P.edgeB.coord_BAUGA i) x w)‖ ≤
          (egp02ListBound + 2) * (4 * (50 * (egpProfileConst + 1)) * θ) := by
  have hΔ0 : 0 < Δ := by linarith
  have hΔΛ0 : 0 ≤ Δ * Λ := mul_nonneg hΔ0.le hΛ
  have hΔΛ : 100 * Δ * Λ ≤ 1 / 100 := by nlinarith
  have hF : MDifferentiableAt 𝓘(ℝ, E3)
      𝓘(ℝ, BlockSpace (fun _ : CGPTag_BAUGP P.toLocalPacketsOnB P.zero => ℝ²))
      (cgpGlobalMap_BAUGP P.toLocalPacketsOnB P.zero) x :=
    (contMDiff_cgpGlobalMap_BAUGP P.toLocalPacketsOnB P.zero hΔ0 (by linarith)
      (fun j hj => (LocalPacketsOnB.tsupport_edgeB_cutoff_subset_BAUGA P.toLocalPacketsOnB hΛ hΔ0
          hμ hτ hΔΛ hj).2.2) x).mdifferentiableAt (by simp)
  have htag := fun t => egp06_tags_KC4_BAUGP P hΛ hΔ hLΛ hμ hτ he hT hσc hθ0 hθ1 hi aS aE aZ hEe hEs
    hEz hx hη ht t
  obtain ⟨sgn, hsgn⟩ : ∃ f : CGPTag_BAUGP P.toLocalPacketsOnB P.zero → ℝ,
      f = egpTagSign_KC4_BAUGP P.toLocalPacketsOnB P.zero aS aE aZ := ⟨_, rfl⟩
  obtain ⟨c, hcdef⟩ : ∃ f : CGPTag_BAUGP P.toLocalPacketsOnB P.zero → ℝ,
      f = egpTagShift_KC4_BAUGP P.toLocalPacketsOnB P.zero i := ⟨_, rfl⟩
  rw [← hsgn, ← hcdef] at htag ⊢
  obtain ⟨hB0, -, -, -⟩ := egp06_block_bounds_KC4
  have hδ : 0 ≤ 4 * (50 * (egpProfileConst + 1)) * θ := by positivity
  have hcard := egpModelListed_card_le_BAUGP P hΛ hΔ hLΛ he hT i
  have hcomp0 := egpModelComponent_eq_zero_BAUGP P.toLocalPacketsOnB P.zero i sgn c
  have hdiff : ∀ t, Differentiable ℝ (egpModelComponent_BAUGP P.toLocalPacketsOnB P.zero i sgn c
      t) :=
    fun t => (contDiff_egpModelComponent_BAUGP P.toLocalPacketsOnB P.zero i sgn c t).differentiable
      (by simp)
  have hQ : ∀ t, egpModelListed_BAUGP P.toLocalPacketsOnB P.zero i t →
      t ∈ cgpQ2Tags_BPE P.toLocalPacketsOnB P.zero := by
    intro t hl
    refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
    rcases t with j | j | j | k | q
    · exact hl.elim
    · rfl
    · rfl
    · rfl
    · exact hl.elim
  have hfin : ((Finset.univ.filter (egpModelListed_BAUGP P.toLocalPacketsOnB P.zero i)).card : ℝ) *
      (4 * (50 * (egpProfileConst + 1)) * θ) ≤
      (egp02ListBound + 2) * (4 * (50 * (egpProfileConst + 1)) * θ) :=
    mul_le_mul_of_nonneg_right hcard hδ
  constructor
  · refine (norm_le_card_mul_of_blocks_KC4 _
      (Finset.univ.filter (egpModelListed_BAUGP P.toLocalPacketsOnB P.zero i)) hδ ?_ ?_).trans hfin
    · intro t htS
      have hl := (Finset.mem_filter.mp htS).2
      rw [PiLp.sub_apply, PiLp.smul_apply]
      change ‖(ρ i)⁻¹ • blockRestrict (cgpQ2Tags_BPE P.toLocalPacketsOnB P.zero)
          (cgpGlobalMap_BAUGP P.toLocalPacketsOnB P.zero x) t -
        egpModelComponent_BAUGP P.toLocalPacketsOnB P.zero i sgn c t (P.edgeB.coord_BAUGA i x)‖ ≤ _
      rw [blockRestrict_apply]
      simp only [hQ t hl, ↓reduceIte]
      exact ((htag t).1 hl).1
    · intro t htS
      have hl : ¬ egpModelListed_BAUGP P.toLocalPacketsOnB P.zero i t := fun h =>
        htS (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩)
      rw [PiLp.sub_apply, PiLp.smul_apply]
      change (ρ i)⁻¹ • blockRestrict (cgpQ2Tags_BPE P.toLocalPacketsOnB P.zero)
          (cgpGlobalMap_BAUGP P.toLocalPacketsOnB P.zero x) t -
        egpModelComponent_BAUGP P.toLocalPacketsOnB P.zero i sgn c t (P.edgeB.coord_BAUGA i x) = 0
      rw [blockRestrict_apply]
      by_cases hQt : t ∈ cgpQ2Tags_BPE P.toLocalPacketsOnB P.zero
      · simp only [hQt, ↓reduceIte]
        rcases (htag t).2 hl with hxs | hQ'
        · exact (egp06_unlisted_tag_KC4_BAUGP P.toLocalPacketsOnB P.zero i sgn c t hl hxs 0).1
        · exact absurd hQt hQ'
      · simp only [hQt, ↓reduceIte, smul_zero, hcomp0 t hl]
        simp
  · intro w hw
    have hfun : cgpProjMap_BPS P.toLocalPacketsOnB P.zero (cgpQ2Tags_BPE P.toLocalPacketsOnB
        P.zero) =
        fun y => blockRestrict (cgpQ2Tags_BPE P.toLocalPacketsOnB P.zero)
          (cgpGlobalMap_BAUGP P.toLocalPacketsOnB P.zero y) := rfl
    have hD := mvfderiv_clm_comp_apply_KC4 (I := 𝓘(ℝ, E3))
      (blockRestrict (cgpQ2Tags_BPE P.toLocalPacketsOnB P.zero))
      (f := cgpGlobalMap_BAUGP P.toLocalPacketsOnB P.zero) hF w
    rw [hfun]
    have hcompD : ∀ t, mvfderiv 𝓘(ℝ, E3) (cgpGlobalMap_BAUGP P.toLocalPacketsOnB P.zero) x w t =
        mvfderiv 𝓘(ℝ, E3) (fun y => cgpGlobalMap_BAUGP P.toLocalPacketsOnB P.zero y t) x w :=
      fun t => mvfderiv_blockMap_apply_apply (R := cgpRadius_BAUGP P.toLocalPacketsOnB P.zero)
        (ζ := cgpCutoff_BAUGP P.toLocalPacketsOnB P.zero) (η := cgpCoord_BAUGP P.toLocalPacketsOnB
            P.zero)
        hF w t
    have hΦD : ∀ t, fderiv ℝ (egpModelGraph_BAUGP P.toLocalPacketsOnB P.zero i sgn c)
        (P.edgeB.coord_BAUGA i x) (mvfderiv 𝓘(ℝ, E3) (P.edgeB.coord_BAUGA i) x w) t =
        fderiv ℝ (egpModelComponent_BAUGP P.toLocalPacketsOnB P.zero i sgn c t)
            (P.edgeB.coord_BAUGA i x)
          (mvfderiv 𝓘(ℝ, E3) (P.edgeB.coord_BAUGA i) x w) :=
      fun t => fderiv_blockGraph_apply_KC3 hdiff _ _ t
    rw [hD]
    refine (norm_le_card_mul_of_blocks_KC4 _
      (Finset.univ.filter (egpModelListed_BAUGP P.toLocalPacketsOnB P.zero i)) hδ ?_ ?_).trans hfin
    · intro t htS
      have hl := (Finset.mem_filter.mp htS).2
      rw [PiLp.sub_apply, PiLp.smul_apply, blockRestrict_apply, hΦD t]
      simp only [hQ t hl, ↓reduceIte]
      rw [hcompD t]
      exact ((htag t).1 hl).2 w hw
    · intro t htS
      have hl : ¬ egpModelListed_BAUGP P.toLocalPacketsOnB P.zero i t := fun h =>
        htS (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩)
      rw [PiLp.sub_apply, PiLp.smul_apply, blockRestrict_apply, hΦD t]
      by_cases hQt : t ∈ cgpQ2Tags_BPE P.toLocalPacketsOnB P.zero
      · simp only [hQt, ↓reduceIte]
        rw [hcompD t]
        rcases (htag t).2 hl with hxs | hQ'
        · exact (egp06_unlisted_tag_KC4_BAUGP P.toLocalPacketsOnB P.zero i sgn c t hl hxs w).2
        · exact absurd hQt hQ'
      · simp only [hQt, ↓reduceIte, smul_zero, hcomp0 t hl, fderiv_zero]
        simp

