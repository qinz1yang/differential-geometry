/-! ### The circle rows strategy -/

/-- **The circle rows strategy on register V4** (TCP03–TCP06 at `ν = β₃/3`): the circle slot reads
`β₃` (TCP03/TCP04 at `θ₂`, TCP05 at `e₀`, TCP06 at `(Γ₀, Σ₀, e₀)`); every other request reads only
values chosen before its slot; the slots these rows do not read are `1` (upper), `0` (lower) or
trivial. -/
def circleRowsStrategyV4 (D : ClosedEarlyData) : ClosedThresholdsV4 D where
  Nb := fun _ => 0
  Nb_nonneg := fun _ => le_rfl
  cw := fun _ => 0
  cw_nonneg := fun _ => le_rfl
  lc18 := 1 / 2
  lc18_pos := by norm_num
  circleUp := fun st β₃ _ _ θ₂ => min (posOr_VAL3 (tcp03γ₀_VAL6 θ₂ (β₃ / 3)))
    (min (posOr_VAL3 (tcp04γ₀_VAL6 θ₂ (β₃ / 3)))
    (min (posOr_VAL3 (tcp04ηc_VAL6 θ₂ (β₃ / 3)))
    (min (posOr_VAL3 (tcp05γ₀_VAL6 (st.e 0) (β₃ / 3)))
    (min (posOr_VAL3 (tcp05ηc_VAL6 (st.e 0) (β₃ / 3)))
    (min (posOr_VAL3 (tcp06γ₀_VAL6 (st.Γ 0) (st.Sig 0) (st.e 0) (β₃ / 3)))
      (posOr_VAL3 (tcp06ηc_VAL6 (st.Γ 0) (st.Sig 0) (st.e 0) (β₃ / 3))))))))
  circleUp_pos := fun _ _ _ _ _ => by simp only [lt_min_iff, posOr_pos_VAL3, and_self]
  β₂Up := fun st ci β₃ => min (posOr_VAL3 (tcp03σ_VAL6 ci.θ₂ (β₃ / 3)) / 3)
    (min (posOr_VAL3 (tcp03η₂_VAL6 ci.θ₂ (β₃ / 3)))
    (min (posOr_VAL3 (tcp04σ_VAL6 ci.θ₂ (β₃ / 3)) / 3)
    (min (posOr_VAL3 (tcp04η₂_VAL6 ci.θ₂ (β₃ / 3)))
    (min (posOr_VAL3 (tcp05σ_VAL6 (st.e 0) (β₃ / 3)) / 3)
    (min (posOr_VAL3 (tcp05η₂_VAL6 (st.e 0) (β₃ / 3)))
    (min (posOr_VAL3 (tcp06σ_VAL6 (st.Γ 0) (st.Sig 0) (st.e 0) (β₃ / 3)) / 3)
      (posOr_VAL3 (tcp06η₂_VAL6 (st.Γ 0) (st.Sig 0) (st.e 0) (β₃ / 3)))))))))
  β₂Up_pos := fun _ _ _ => by
    simp only [lt_min_iff, posOr_pos_VAL3, and_self, div_pos (posOr_pos_VAL3 _) three_pos]
  ΔLow := fun _ _ _ _ => 0
  errorsUp := fun st ci ex => min (posOr_VAL3 (ci.θ₂ ^ 2 / 1000))
    (min (posOr_VAL3 (ci.θ₂ / 100))
    (min (posOr_VAL3 (tcp05θ_VAL6 (st.e 0) (ex.β₃ / 3) ^ 2 / 1000))
    (min (posOr_VAL3 (tcp05θ_VAL6 (st.e 0) (ex.β₃ / 3) / 100))
    (min (posOr_VAL3 (tcp06θ_VAL6 (st.Γ 0) (st.Sig 0) (st.e 0) (ex.β₃ / 3) ^ 2 / 1000))
    (min (posOr_VAL3 (tcp06θ_VAL6 (st.Γ 0) (st.Sig 0) (st.e 0) (ex.β₃ / 3) / 100)) 1)))))
  errorsUp_pos := fun _ _ _ => by simp only [lt_min_iff, posOr_pos_VAL3, and_self, zero_lt_one]
  sectionUp := fun st _ ex _ => min (posOr_VAL3 (tcp05θ_VAL6 (st.e 0) (ex.β₃ / 3) / 100 / ex.Δ))
    (posOr_VAL3 (tcp06θ_VAL6 (st.Γ 0) (st.Sig 0) (st.e 0) (ex.β₃ / 3) / 100 / ex.Δ))
  sectionUp_pos := fun _ _ _ _ => by simp only [lt_min_iff, posOr_pos_VAL3, and_self]
  lfr29W := fun _ _ _ _ _ => 1
  lfr29W_pos := fun _ _ _ _ _ => one_pos
  endpointUp := fun _ _ _ _ _ _ => 1
  endpointUp_pos := fun _ _ _ _ _ _ => one_pos
  σcolUp := fun _ _ _ _ _ _ _ => 1
  σcolUp_pos := fun _ _ _ _ _ _ _ => one_pos
  I₁ := 1
  I₁_pos := one_pos
  scaleUp := fun _ _ _ _ => 1
  scaleUp_pos := fun _ _ _ _ => one_pos
  wUp := fun _ _ _ _ _ => 1
  wUp_pos := fun _ _ _ _ _ => one_pos
  splitUp := fun st _ ex _ _ => min (posOr_VAL3 (tcp05η₁_VAL6 (st.e 0) (ex.β₃ / 3) ex.Δ))
    (posOr_VAL3 (tcp06η₁_VAL6 (st.Γ 0) (st.Sig 0) (st.e 0) (ex.β₃ / 3) ex.Δ))
  splitUp_pos := fun _ _ _ _ _ => by simp only [lt_min_iff, posOr_pos_VAL3, and_self]
  β₁Up := fun st ci ex _ _ _ => min (posOr_VAL3 (tcp03η₁_VAL6 ci.θ₂ (ex.β₃ / 3)))
