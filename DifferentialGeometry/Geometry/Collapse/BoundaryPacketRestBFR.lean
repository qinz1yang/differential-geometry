variable {W : CompactCarrier.{0}} [ConnectedSpace W.Carrier]
  {g : SmoothRiemannianMetric W.model W.Carrier} {K : ℕ} {A : ℝ → ℝ} {δn idx Λ w : ℝ}
  {β : ℕ → ℝ} {Δ σs σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λ' βd εN : ℝ}
  {P : BoundaryExportPacket W g K A δn (cuspTolerance_BCUSP1 (β 1) βd εN)}

/-- **Consumer**: the member's ratio is below T3B's cusp tolerance `βd²/1000`. -/
theorem ratio_le_BQ2 (h : BoundaryPacketRestBFR_BQ2 W g K A δn idx Λ w β Δ σs σc μ b s b' s' ε γc
    βc Lmax τ γ δ εr e T V vs ζ Λ' βd εN P) : δn ≤ βd ^ 2 / 1000 :=
  h.1

/-- **Consumer (product-or-separation for THE packet)**: T3's labelled whole-product branch (two
distinct labels of `P.cusp` at the two ends of `Torus × [0, 1]`) or the separation of the
enlarged collars, of the level sets `{level ≤ 90}`, and their distance `≥ 1`. -/
theorem alternative_BQ2 (h : BoundaryPacketRestBFR_BQ2 W g K A δn idx Λ w β Δ σs σc μ b s b' s' ε
    γc βc Lmax τ γ δ εr e T V vs ζ Λ' βd εN P) :
    (∃ (i j : Fin P.cusp.count), i ≠ j ∧
      ∃ D : Diffeomorph (torusModel.prod (𝓡∂ 1)) W.model (Torus × Icc (0 : ℝ) 1) W.Carrier ∞,
        (∀ p, D p ∈ P.cusp.component i ↔ p.2.1 = 0) ∧
          ∀ p, D p ∈ P.cusp.component j ↔ p.2.1 = 1) ∨
    (∀ i j : Fin P.cusp.count, i ≠ j →
      Disjoint ((P.cusp.collar i).toFun '' {q : CuspHalfSpace | q.2.val 0 < 92})
        ((P.cusp.collar j).toFun '' {q : CuspHalfSpace | q.2.val 0 < 92}) ∧
      Disjoint {x | P.level i x ≤ 90} {y | P.level j y ≤ 90} ∧
      ∀ x y, P.level i x ≤ 90 → P.level j y ≤ 90 →
        ENNReal.ofReal 1 ≤ riemannianEDistOf g x y) := by
  obtain ⟨-, _, _, -, -, -, -, -, -, -, -, -, -, h⟩ := h
  dsimp only at h
  obtain ⟨_, _, _, -, -, -, -, _, _, -, -, -, -, -, -, h⟩ := h
  rcases h with h | ⟨h, -, -⟩
  exacts [Or.inl h, Or.inr h]

end BoundaryPacketRestBFR_BQ2

