/-- **PR10's `N_b, c_w` slots carry the stage-cloud conclusions** (CFS11–CFS12 on the actual first
stage cloud, `nb_cw_stage_selection_GAFS3` at `bb = b_st = Ξ_0(Γ_0)⁻¹`, verbatim): on every final
family in FC07's range, for every selection over the enlarged stage-0 cloud, every `Σ` with
`128 b_st Σ ≤ 1/5`, every quality `Γ` with CFS12's interior condition at `b_st` and every plane
field of the stage dimension with the (CS) tests: for every finite disjoint selection, the
multiplicity is at most `N_b(S)` with (LM), and under the tube inclusion the weight derivatives are
at most `c_w(S)/r_x`. -/
theorem nb_cw_slots_VAL6 {D : ClosedEarlyData} (S : ClosedStage D) :
    ∀ (X : Type) [MetricSpace X] [ChartedSpace E3 X] [IsManifold 𝓘(ℝ, E3) ∞ X]
      [CompactSpace X] (g : SmoothRiemannianMetric 𝓘(ℝ, E3) X)
      (hmetric : ∀ a b : X, riemannianEDistOf g a b = ENNReal.ofReal (dist a b))
      (ρ : X → ℝ) (hρ : ∀ p, 0 < ρ p) (Λ : ℝ) (β : ℕ → ℝ) (Δ σs : ℝ) (K : ℕ)
      (σc μ b s b' s' ε γc βc Lmax τ γ δ εr e T V vs ζ Λz : ℝ)
      (P : LocalChartPacketsC14 X g hmetric ρ hρ Λ β Δ σs K σc μ b s b' s' ε γc βc Lmax τ γ δ
        εr e T V vs ζ Λz),
      0 ≤ Λ → 1 ≤ Δ → μ ≤ 1 / 100 → τ ≤ 1 / 100 → e ≤ 1 / 8 →
      1000000 * Δ * Λ < 1 / 100000 →
      ∀ sel : BlockSpace (fun _ : CGPTag P.toLocalChartFamily P.zero => ℝ²) → X,
      (∀ x ∈ gafCloudEnlarged P.toLocalChartFamily P.zero 0,
        cgpProjMap P.toLocalChartFamily P.zero (gafStageTags P.toLocalChartFamily P.zero 0)
          (sel x) = x) →
      ∀ sg : ℝ, 0 < sg → 128 * stageBuffer_VAL6 S * sg ≤ 1 / 5 →
      ∀ Γ : ℝ, 0 < Γ → Γ * ((80 * (5 / 3) + 31) * stageBuffer_VAL6 S + 2) < 1 →
      ∀ plane : BlockSpace (fun _ : CGPTag P.toLocalChartFamily P.zero => ℝ²) →
        Submodule ℝ (BlockSpace (fun _ : CGPTag P.toLocalChartFamily P.zero => ℝ²)),
      (∀ x ∈ gafCloud P.toLocalChartFamily P.zero 0,
        Module.finrank ℝ (plane x) = gafStageDim 0) →
      (∀ x ∈ gafCloud P.toLocalChartFamily P.zero 0,
        hausdorffEDist (gafCloudEnlarged P.toLocalChartFamily P.zero 0 ∩
            ball x (sg * ρ (sel x) / Γ))
          ((AffineSubspace.mk' x (plane x) :
              Set (BlockSpace (fun _ : CGPTag P.toLocalChartFamily P.zero => ℝ²))) ∩
            ball x (sg * ρ (sel x) / Γ)) ≤ ENNReal.ofReal (Γ * (sg * ρ (sel x)))) →
      ∀ (I : Set (BlockSpace (fun _ : CGPTag P.toLocalChartFamily P.zero => ℝ²)))
        (hI : I.Finite), I ⊆ gafCloud P.toLocalChartFamily P.zero 0 →
        I.PairwiseDisjoint (fun i => ball i (sg * ρ (sel i))) →
        (∀ x ∈ gafCloud P.toLocalChartFamily P.zero 0,
          ((I ∩ {i | (closedBall i (80 * stageBuffer_VAL6 S * (sg * ρ (sel i))) ∩
              ball x (30 * stageBuffer_VAL6 S * (sg * ρ (sel x)))).Nonempty}).ncard : ℝ) ≤
            sharedNb_VAL6 S ∧
          ∀ i ∈ I, (closedBall i (80 * stageBuffer_VAL6 S * (sg * ρ (sel i))) ∩
              ball x (30 * stageBuffer_VAL6 S * (sg * ρ (sel x)))).Nonempty →
            sg * ρ (sel x) / (5 / 3) ≤ sg * ρ (sel i) ∧
            sg * ρ (sel i) ≤ (5 / 3) * (sg * ρ (sel x)) ∧
            dist i x < 165 * stageBuffer_VAL6 S * (sg * ρ (sel x))) ∧
        ((⋃ x ∈ gafCloud P.toLocalChartFamily P.zero 0,
            ball x (8 * stageBuffer_VAL6 S * (sg * ρ (sel x)))) ⊆
          ⋃ i ∈ I, ball i (20 * stageBuffer_VAL6 S * (sg * ρ (sel i))) →
          ∀ x ∈ gafCloud P.toLocalChartFamily P.zero 0,
          ∀ y ∈ ball x (8 * stageBuffer_VAL6 S * (sg * ρ (sel x))),
            (∑ i ∈ hI.toFinset, ‖fderiv ℝ (fun y' => ballCutoff i (40 * stageBuffer_VAL6 S * (sg *
                ρ (sel i)))
                (2 * (40 * stageBuffer_VAL6 S * (sg * ρ (sel i)))) y' / (∑ a ∈ hI.toFinset,
                  ballCutoff a (40 * stageBuffer_VAL6 S * (sg * ρ (sel a))) (2 * (40 *
                      stageBuffer_VAL6 S * (sg * ρ (sel a))))
                    y')) y‖) ≤ sharedCw_VAL6 S / (sg * ρ (sel x))) :=
  (Classical.choose_spec nb_cw_stage_selection_GAFS3 0 (stageBuffer_VAL6 S)
    S.one_le_stageBuffer_VAL6).2

